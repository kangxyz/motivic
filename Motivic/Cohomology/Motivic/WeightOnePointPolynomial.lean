module

public import Motivic.Cohomology.Motivic.WeightOneInterpolationCycle
public import Mathlib.FieldTheory.Minpoly.Field
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Polynomial presentations of actual torus point generators

The global algebra of an actual finite integral support in the multiplicative
line is generated by its literal Laurent coordinate. Its minimal polynomial
therefore presents the entire original support, with the original scalar map
and closed immersion into the point-torus product.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite Polynomial
open AlgebraicGeometry.Scheme.PolynomialLaurent

universe u

namespace Motivic.WeightOnePointPolynomial

open WeightOnePointNorm WeightOneInterpolationCycle

variable {k : Type u} [Field k] (Z : Generator k)

/-- The literal morphism from the original support to the Laurent torus. -/
def torusProjection : Z.scheme ⟶ (SmoothSite.torus (.of k)).left :=
  Z.targetProjection ≫ (SmoothSite.torusCoordinate (.of k) 1 0).left

instance torusProjection_closed : IsClosedImmersion (torusProjection Z) := by
  have : IsIso (pullback.snd (SmoothSite.base (Spec (.of k))).hom
      (SmoothSite.torusPower (.of k) 1).hom) := by
    change IsIso (pullback.snd (𝟙 (Spec (.of k))) _)
    infer_instance
  have : IsIso (SmoothSite.torusCoordinate (.of k) 1 0).left := by
    change IsIso (SmoothSite.torusPowerOneIso (.of k)).hom.left
    infer_instance
  change IsClosedImmersion ((Z.inclusion ≫ pullback.snd _ _) ≫
    (SmoothSite.torusCoordinate (.of k) 1 0).left)
  infer_instance

/-- The coordinate projection retains the given source scalar map. -/
theorem torusProjection_structure :
    torusProjection Z ≫ (SmoothSite.torus (.of k)).hom = Z.projection := by
  rw [torusProjection, Category.assoc,
    MorphismProperty.Over.w (SmoothSite.torusCoordinate (.of k) 1 0)]
  have h := Z.projection_base.symm
  change _ = Z.projection ≫ 𝟙 _ at h
  simpa only [Category.comp_id] using h

/-- The actual pullback of Laurent polynomials is evaluation in the original coordinate. -/
theorem coordinatePullback_eq_eval :
    affinePullback (torusProjection Z) =
      LaurentPolynomial.eval₂ (scalarMap Z) (coordinateUnit Z) := by
  apply laurentRingHom_ext
  · have hs := congrArg affinePullback (torusProjection_structure Z)
    change affinePullback (torusProjection Z ≫
      Spec.map (CommRingCat.ofHom LaurentPolynomial.C)) = scalarMap Z at hs
    rw [affinePullback_comp] at hs
    apply RingHom.ext
    intro r
    exact (RingHom.congr_fun hs r).trans (LaurentPolynomial.eval₂_C _ _ r).symm
  · simp only [LaurentPolynomial.eval₂_T, zpow_one]
    rfl

/-- Closedness in the actual Laurent torus gives surjectivity of evaluation. -/
theorem coordinate_eval_surjective :
    Function.Surjective (LaurentPolynomial.eval₂ (scalarMap Z) (coordinateUnit Z)) := by
  let : IsAffine (SmoothSite.torus (.of k)).left :=
    inferInstanceAs (IsAffine (Spec (.of (LaurentPolynomial k))))
  rw [← coordinatePullback_eq_eval Z]
  exact (IsClosedImmersion.isAffine_surjective_of_isAffine (torusProjection Z)).2.comp
    (Scheme.ΓSpecIso (.of (LaurentPolynomial k))).symm.commRingCatIsoToRingEquiv.surjective

/-- The coordinate is integral for the original, finite scalar action. -/
theorem coordinate_integral : IsIntegral k (coordinateUnit Z : coordinateRing Z) :=
  Algebra.IsIntegral.isIntegral _

/-- In fact ordinary polynomials already generate the entire actual support algebra. -/
theorem coordinate_adjoin_eq_top :
    Algebra.adjoin k ({(coordinateUnit Z : coordinateRing Z)} : Set (coordinateRing Z)) = ⊤ := by
  let := (coordinateRing_isField Z).toField
  apply top_unique
  intro x hx
  clear hx
  obtain ⟨f, rfl⟩ := coordinate_eval_surjective Z x
  induction f using LaurentPolynomial.induction_on' with
  | add f g hf hg => simpa only [map_add] using Subalgebra.add_mem _ hf hg
  | C_mul_T n a =>
    rw [LaurentPolynomial.eval₂_C_mul_T]
    apply Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a)
    have hx : (coordinateUnit Z : coordinateRing Z) ∈
        Algebra.adjoin k ({(coordinateUnit Z : coordinateRing Z)} : Set (coordinateRing Z)) :=
      Algebra.subset_adjoin rfl
    cases n with
    | ofNat n => simpa using Subalgebra.pow_mem _ hx n
    | negSucc n =>
      have hi := (coordinate_integral Z).inv_mem_adjoin
      simpa [zpow_negSucc] using Subalgebra.pow_mem _ hi (n + 1)

/-- The monic minimal polynomial of the literal invertible coordinate. -/
def coordinatePolynomial : k[X] := minpoly k (coordinateUnit Z : coordinateRing Z)

/-- This is the actual monic minimal polynomial, with no normalization change. -/
theorem coordinatePolynomial_monic : (coordinatePolynomial Z).Monic :=
  minpoly.monic (coordinate_integral Z)

/-- A support over a field is nonempty, so its coordinate polynomial has positive degree. -/
theorem coordinatePolynomial_natDegree_pos : 1 ≤ (coordinatePolynomial Z).natDegree := by
  let := (coordinateRing_isField Z).toField
  exact minpoly.natDegree_pos (coordinate_integral Z)

/-- Invertibility of the original Laurent coordinate forces a nonzero constant term. -/
theorem coordinatePolynomial_coeff_zero_ne_zero : (coordinatePolynomial Z).coeff 0 ≠ 0 := by
  let := (coordinateRing_isField Z).toField
  exact minpoly.coeff_zero_ne_zero (coordinate_integral Z) (Units.ne_zero _)

/-- Evaluation at the literal coordinate on the original support. -/
def coordinateRootHom : AdjoinRoot (coordinatePolynomial Z) →ₐ[k] coordinateRing Z :=
  AdjoinRoot.liftAlgHom (coordinatePolynomial Z) (Algebra.ofId k (coordinateRing Z))
    (coordinateUnit Z : coordinateRing Z) (minpoly.aeval k _)

@[simp] theorem coordinateRootHom_root :
    coordinateRootHom Z (AdjoinRoot.root (coordinatePolynomial Z)) =
      (coordinateUnit Z : coordinateRing Z) :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

/-- Ordinary polynomial evaluation onto the support is surjective. -/
theorem coordinate_aeval_surjective :
    Function.Surjective (aeval (R := k) (coordinateUnit Z : coordinateRing Z)) := by
  apply (AlgHom.range_eq_top _).mp
  rw [← Algebra.adjoin_singleton_eq_range_aeval, coordinate_adjoin_eq_top]

/-- The quotient by the minimal polynomial is the entire original support algebra. -/
def coordinateRootEquiv : AdjoinRoot (coordinatePolynomial Z) ≃ₐ[k] coordinateRing Z := by
  letI := (coordinateRing_isField Z).toField
  letI : Fact (Irreducible (coordinatePolynomial Z)) := ⟨minpoly.irreducible
    (coordinate_integral Z)⟩
  apply AlgEquiv.ofBijective (coordinateRootHom Z)
  refine ⟨(coordinateRootHom Z).injective, ?_⟩
  intro x
  obtain ⟨f, rfl⟩ := coordinate_aeval_surjective Z x
  exact ⟨AdjoinRoot.mk _ f, rfl⟩

@[simp] theorem coordinateRootEquiv_root :
    coordinateRootEquiv Z (AdjoinRoot.root (coordinatePolynomial Z)) =
      (coordinateUnit Z : coordinateRing Z) := coordinateRootHom_root Z

/-- The inverse algebra equivalence sends the original unit to the actual quotient root. -/
@[simp] theorem coordinateRootEquiv_symm_coordinate :
    (coordinateRootEquiv Z).symm (coordinateUnit Z : coordinateRing Z) =
      AdjoinRoot.root (coordinatePolynomial Z) := by
  apply (coordinateRootEquiv Z).injective
  rw [AlgEquiv.apply_symm_apply, coordinateRootEquiv_root]

/-- The literal support is identified with the entire minimal-polynomial quotient scheme. -/
def polynomialSupportIso : Spec (.of (AdjoinRoot (coordinatePolynomial Z))) ≅ Z.scheme :=
  Scheme.Spec.mapIso (coordinateRootEquiv Z).symm.toRingEquiv.toCommRingCatIso.op ≪≫
    (supportIsoSpec Z).symm

/-- A map from an affine support is the spectrum of its actual global pullback. -/
theorem supportIsoSpec_inv_map {R : Type u} [CommRing R]
    (f : Z.scheme ⟶ Spec (.of R)) :
    (supportIsoSpec Z).inv ≫ f =
      Spec.map (CommRingCat.ofHom (affinePullback f)) := by
  rw [supportIsoSpec, ← Scheme.isoSpec_inv_naturality, Scheme.isoSpec_Spec_inv,
    ← Spec.map_comp]
  rfl

/-- The scheme identification is over precisely the original base-field action. -/
@[reassoc] theorem polynomialSupportIso_projection :
    (polynomialSupportIso Z).hom ≫ Z.projection =
      Spec.map (CommRingCat.ofHom (AdjoinRoot.of (coordinatePolynomial Z))) := by
  change Spec.map (CommRingCat.ofHom (coordinateRootEquiv Z).symm.toRingHom) ≫
    (supportIsoSpec Z).inv ≫ Z.projection = _
  rw [supportIsoSpec_inv_map, ← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  exact (coordinateRootEquiv Z).symm.commutes r

/-- The whole support identification preserves the original Laurent coordinate. -/
@[reassoc] theorem polynomialSupportIso_torusProjection :
    (polynomialSupportIso Z).hom ≫ torusProjection Z =
      polynomialTorusMap (coordinatePolynomial Z) (coordinatePolynomial_coeff_zero_ne_zero Z) := by
  change Spec.map (CommRingCat.ofHom (coordinateRootEquiv Z).symm.toRingHom) ≫
    (supportIsoSpec Z).inv ≫ torusProjection Z = _
  rw [supportIsoSpec_inv_map, coordinatePullback_eq_eval, ← Spec.map_comp]
  unfold polynomialTorusMap
  congr 1
  apply CommRingCat.hom_ext
  apply laurentRingHom_ext
  · apply RingHom.ext
    intro r
    change (coordinateRootEquiv Z).symm
      (LaurentPolynomial.eval₂ (scalarMap Z) (coordinateUnit Z) (LaurentPolynomial.C r)) = _
    rw [LaurentPolynomial.eval₂_C]
    exact ((coordinateRootEquiv Z).symm.commutes r).trans
      (LaurentPolynomial.eval₂_C _ _ r).symm
  · change (coordinateRootEquiv Z).symm
      (LaurentPolynomial.eval₂ (scalarMap Z) (coordinateUnit Z) (LaurentPolynomial.T 1)) =
        LaurentPolynomial.eval₂ (AdjoinRoot.of (coordinatePolynomial Z))
          (polynomialUnit _ (coordinatePolynomial_coeff_zero_ne_zero Z)) (LaurentPolynomial.T 1)
    simp only [LaurentPolynomial.eval₂_T, zpow_one, coordinateRootEquiv_symm_coordinate,
      polynomialUnit_val]

/-- The polynomial chart gives exactly the original closed immersion in the actual product. -/
@[reassoc] theorem polynomialSupportIso_inclusion :
    (polynomialSupportIso Z).hom ≫ Z.inclusion =
      polynomialInclusion (coordinatePolynomial Z) (coordinatePolynomial_coeff_zero_ne_zero Z) := by
  apply pullback.hom_ext
  · change (polynomialSupportIso Z).hom ≫ Z.inclusion ≫ pullback.fst _ _ = _
    rw [polynomialInclusion_fst]
    exact polynomialSupportIso_projection Z
  · have : IsIso (SmoothSite.torusCoordinate (.of k) 1 0).left := by
      change IsIso (SmoothSite.torusPowerOneIso (.of k)).hom.left
      infer_instance
    apply (cancel_mono (SmoothSite.torusCoordinate (.of k) 1 0).left).mp
    rw [Category.assoc, polynomialInclusion_snd, polynomialTargetMap_coordinate]
    exact polynomialSupportIso_torusProjection Z

/-- Every actual point generator is the full cycle of its minimal-polynomial quotient. -/
theorem generator_cycle_eq_polynomialCycle :
    Z.cycle = polynomialCycle (coordinatePolynomial Z) (coordinatePolynomial_monic Z)
      (coordinatePolynomial_coeff_zero_ne_zero Z) := by
  have : IsNoetherian ((𝟭 Scheme).obj (SmoothSite.base (Spec (.of k))).left) :=
    inferInstanceAs (IsNoetherian (Spec (.of k)))
  have : IsNoetherian Z.scheme := isNoetherian_of_finiteType Z.projection
  have : IsNoetherian (WeightOneFundamentalNorm.ambient k) :=
    isNoetherian_of_finiteType (pullback.fst (SmoothSite.base (Spec (.of k))).hom
      (SmoothSite.torusPower (.of k) 1).hom)
  apply FiniteCorrespondence.toIntegralCycle_injective
  rw [toIntegralCycle_polynomialCycle]
  simp only [← polynomialSupportIso_inclusion Z,
    IntegralCycle.finitePushforward_comp, AddMonoidHom.comp_apply,
    finitePushforward_fundamentalCycle, FiniteCorrespondenceGenerator.cycle,
    FiniteCorrespondence.toIntegralCycle_single]
  exact (closedFundamentalCycle_of_isIntegral Z.val).symm

/-- Polynomial presentation of the actual generator, with all admissibility facts proved. -/
theorem exists_polynomialCycle :
    ∃ (p : k[X]) (hp : p.Monic) (h0 : p.coeff 0 ≠ 0),
      1 ≤ p.natDegree ∧ Z.cycle = polynomialCycle p hp h0 :=
  ⟨coordinatePolynomial Z, coordinatePolynomial_monic Z,
    coordinatePolynomial_coeff_zero_ne_zero Z, coordinatePolynomial_natDegree_pos Z,
    generator_cycle_eq_polynomialCycle Z⟩

end Motivic.WeightOnePointPolynomial
