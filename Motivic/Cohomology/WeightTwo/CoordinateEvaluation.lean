module

public import Motivic.Cohomology.WeightTwo.PointPresentation
public import Aglib.KTheory.MilnorK.K3.PolynomialNormProjection
public import Mathlib.RingTheory.Norm.Transitivity
public import Aglib.RingTheory.PolynomialFiberNorm

/-!
# First-coordinate Milnor evaluation of finite field points

The first coordinate specifies its own minimal-polynomial quotient and the
unique embedding of that quotient into the entire point field. The second
coordinate is first sent through the ordinary determinant norm to this
specified quotient. Only then is the constructed polynomial Milnor norm used.
No arbitrary primitive presentation, Milnor norm independence, or Milnor norm
tower law enters this definition or the retained-degree field law.

This is a point and cycle evaluator, not a map on motivic homology: annihilation
of arbitrary singular endpoint boundaries remains a separate obligation.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Polynomial

universe u

namespace Motivic.WeightTwoCoordinateEvaluation

open MilnorK.K2 MilnorK.K3.PolynomialResidue
open MilnorK.K3.PolynomialNorm

variable {k E : Type u} [Field k] [Field E] [Algebra k E]

/-- Evaluate using the specified root embedding, taking the ordinary norm from
its whole target field before applying the actual polynomial Milnor norm. -/
def valueVia (p : MonicIrreducible k) (hp0 : p.val.coeff 0 ≠ 0)
    (i : AdjoinRoot p.val →ₐ[k] E) (v : Eˣ) : MilnorK.K2.Group k :=
  letI : Algebra (AdjoinRoot p.val) E := i.toRingHom.toAlgebra
  polynomialNorm p (symbol (rootUnit p hp0) (Units.map (Algebra.norm (AdjoinRoot p.val)) v))

variable [Module.Finite k E]

/-- The literal minimal polynomial of the first coordinate. -/
def firstPolynomial (u : Eˣ) : MonicIrreducible k :=
  ⟨minpoly k (u : E), minpoly.monic (IsIntegral.of_finite k _),
    minpoly.irreducible (IsIntegral.of_finite k _)⟩

/-- The first-coordinate polynomial has nonzero constant coefficient. -/
theorem firstPolynomial_coeff_zero (u : Eˣ) :
    (firstPolynomial (k := k) u).val.coeff 0 ≠ 0 :=
  minpoly.coeff_zero_ne_zero (IsIntegral.of_finite k _) u.ne_zero

/-- The unique original-scalar embedding sending the quotient root to the
specified first coordinate; its image is exactly the field generated by it. -/
def firstMap (u : Eˣ) : AdjoinRoot (firstPolynomial (k := k) u).val →ₐ[k] E :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId k E) (u : E) (minpoly.aeval k (u : E))

/-- The quotient embedding keeps the original first coordinate literally. -/
@[simp] theorem firstMap_root (u : Eˣ) :
    firstMap (k := k) u (AdjoinRoot.root (firstPolynomial (k := k) u).val) = (u : E) :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

/-- The independent first-coordinate value of a finite field point. The full
field `E`, which need not be generated by either coordinate, supplies the norm. -/
def value (u v : Eˣ) : MilnorK.K2.Group k :=
  valueVia (firstPolynomial (k := k) u) (firstPolynomial_coeff_zero u) (firstMap u) v

/-- A specified root embedding identifies the same minimal polynomial, with
no change of primitive element or of polynomial Milnor norm. -/
theorem firstPolynomial_eq (p : MonicIrreducible k)
    (i : AdjoinRoot p.val →ₐ[k] E) (u : Eˣ)
    (hu : i (AdjoinRoot.root p.val) = (u : E)) : firstPolynomial (k := k) u = p := by
  apply Subtype.ext
  change minpoly k (u : E) = p.val
  rw [← hu, minpoly.algHom_eq i i.injective, AdjoinRoot.minpoly_root p.property.1.ne_zero,
    p.property.1.leadingCoeff, inv_one, C_1, mul_one]

/-- Any embedding of the very same first-coordinate polynomial gives this
literal value. This is uniqueness of a root embedding, not norm independence. -/
theorem value_eq_valueVia (p : MonicIrreducible k) (hp0 : p.val.coeff 0 ≠ 0)
    (i : AdjoinRoot p.val →ₐ[k] E) (u v : Eˣ)
    (hu : i (AdjoinRoot.root p.val) = (u : E)) :
    value (k := k) u v = valueVia p hp0 i v := by
  have hp := firstPolynomial_eq p i u hu
  subst p
  have hi : firstMap (k := k) u = i := by
    apply AdjoinRoot.algHom_ext
    exact (firstMap_root u).trans hu.symm
  unfold value
  rw [hi]

variable {D : Type u} [Field D] [Algebra k D] [Algebra E D]
  [IsScalarTower k E D] [Module.Finite E D]

/-- Ordinary norm transitivity retains the full degree above the given point
field. Both evaluations use exactly the same polynomial and root embedding. -/
theorem valueVia_map_degree (p : MonicIrreducible k) (hp0 : p.val.coeff 0 ≠ 0)
    (i : AdjoinRoot p.val →ₐ[k] E) (v : Eˣ) :
    valueVia p hp0 ((IsScalarTower.toAlgHom k E D).comp i)
      (Units.map (algebraMap E D).toMonoidHom v) =
      Module.finrank E D • valueVia p hp0 i v := by
  let : Algebra (AdjoinRoot p.val) E := i.toRingHom.toAlgebra
  let : Algebra (AdjoinRoot p.val) D :=
    ((IsScalarTower.toAlgHom k E D).comp i).toRingHom.toAlgebra
  let : IsScalarTower (AdjoinRoot p.val) E D := IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower k (AdjoinRoot p.val) E :=
    IsScalarTower.of_algebraMap_eq' (by ext x; exact (i.commutes x).symm)
  let : Module.Finite (AdjoinRoot p.val) E := Module.Finite.of_restrictScalars_finite k _ _
  have hn : Units.map (Algebra.norm (AdjoinRoot p.val))
      (Units.map (algebraMap E D).toMonoidHom v) =
      (Units.map (Algebra.norm (AdjoinRoot p.val)) v) ^ Module.finrank E D := by
    apply Units.ext
    change Algebra.norm (AdjoinRoot p.val) (algebraMap E D (v : E)) =
      Algebra.norm (AdjoinRoot p.val) (v : E) ^ Module.finrank E D
    rw [← Algebra.norm_norm (S := E), Algebra.norm_algebraMap, map_pow]
  change polynomialNorm p (symbol (rootUnit p hp0) _) =
    Module.finrank E D • polynomialNorm p (symbol (rootUnit p hp0) _)
  rw [hn, symbol_pow_right, map_nsmul]

variable [Module.Finite k D]

/-- The actual finite-field degree law: enlargement of a point field keeps
both pulled-back coordinates and contributes its full residue degree. -/
theorem value_map_degree (u v : Eˣ) :
    value (k := k) (Units.map (algebraMap E D).toMonoidHom u)
      (Units.map (algebraMap E D).toMonoidHom v) =
      Module.finrank E D • value (k := k) u v := by
  let p := firstPolynomial (k := k) u
  let i := firstMap (k := k) u
  rw [value_eq_valueVia p (firstPolynomial_coeff_zero u)
    ((IsScalarTower.toAlgHom k E D).comp i) _ _ (by
      change algebraMap E D (i (AdjoinRoot.root p.val)) = algebraMap E D (u : E)
      rw [firstMap_root])]
  exact valueVia_map_degree p (firstPolynomial_coeff_zero u) i v


section Normalization

/-- An identity second coordinate has zero value in the original Milnor group. -/
@[simp] theorem value_one_right (u : Eˣ) : value (k := k) u 1 = 0 := by
  simp only [value, valueVia, map_one, symbol_one_right, map_zero]

/-- An identity first coordinate also has zero value, independently of the size of
its full point field. -/
@[simp] theorem value_one_left (v : Eˣ) : value (k := k) (1 : Eˣ) v = 0 := by
  have hr : rootUnit (firstPolynomial (k := k) (1 : Eˣ))
      (firstPolynomial_coeff_zero (1 : Eˣ)) = 1 := by
    apply Units.ext
    apply (firstMap (k := k) (1 : Eˣ)).injective
    change firstMap (k := k) (1 : Eˣ)
      (AdjoinRoot.root (firstPolynomial (k := k) (1 : Eˣ)).val) =
      firstMap (k := k) (1 : Eˣ) 1
    rw [firstMap_root, map_one]
    rfl
  simp only [value, valueVia, hr, symbol_one_left, map_zero]

/-- A base-field first coordinate reduces the independent point evaluator to
the ordinary norm of the full second-coordinate field. -/
theorem value_base_first [CharZero k] (a : kˣ) (v : Eˣ) :
    value (k := k) (Units.map (algebraMap k E).toMonoidHom a) v =
      symbol a (Units.map (Algebra.norm k) v) := by
  let u := Units.map (algebraMap k E).toMonoidHom a
  let p := firstPolynomial (k := k) u
  let i := firstMap (k := k) u
  let : Algebra (AdjoinRoot p.val) E := i.toRingHom.toAlgebra
  let : IsScalarTower k (AdjoinRoot p.val) E :=
    IsScalarTower.of_algebraMap_eq' (by ext x; exact (i.commutes x).symm)
  let : Module.Finite k (AdjoinRoot p.val) := p.property.1.finite_adjoinRoot
  let : Module.Finite (AdjoinRoot p.val) E := Module.Finite.of_restrictScalars_finite k _ _
  have hr : rootUnit p (firstPolynomial_coeff_zero u) =
      Units.map (algebraMap k (AdjoinRoot p.val)).toMonoidHom a := by
    apply Units.ext
    apply i.injective
    change i (AdjoinRoot.root p.val) = i (algebraMap k (AdjoinRoot p.val) (a : k))
    rw [i.commutes]
    exact firstMap_root u
  change polynomialNorm p (symbol (rootUnit p (firstPolynomial_coeff_zero u)) _) = _
  rw [hr, polynomialNorm_constant_symbol]
  congr 1
  apply Units.ext
  exact Algebra.norm_norm (R := k) (S := AdjoinRoot p.val)

/-- Rational-point normalization is an equality in the original Milnor group;
no motivic injectivity or prospective inverse is used. -/
@[simp] theorem value_rational [CharZero k] (a b : kˣ) :
    value (k := k) a b = symbol a b := by
  simpa using value_base_first (E := k) a b

end Normalization

/-- Value of an actual closed support, using its original global-section
field, original scalar map, and both original Laurent coordinates. -/
def generatorValue (Z : WeightTwoPointPresentation.Generator k) : MilnorK.K2.Group k :=
  value (k := k) (WeightTwoPointPresentation.coordinateUnit Z 0)
    (WeightTwoPointPresentation.coordinateUnit Z 1)

/-- Additive evaluation of the original signed point cycles. This has not yet
been asserted to annihilate singular boundaries or to descend to homology. -/
def cycleValue (k : Type u) [Field k] :
    (WeightOnePointNorm.point k ⟶ WeightTwoSymbols.target k) →+ MilnorK.K2.Group k :=
  Finsupp.liftAddHom fun Z => zmultiplesHom _ (generatorValue Z)

/-- Every original signed multiplicity is retained by the cycle evaluator. -/
@[simp] theorem cycleValue_single (Z : WeightTwoPointPresentation.Generator k) (n : ℤ) :
    cycleValue k (Finsupp.single Z n) = n • generatorValue Z :=
  Finsupp.liftAddHom_apply_single _ _ _

/-- The actual fundamental generator evaluates in its whole original point field. -/
@[simp] theorem cycleValue_cycle (Z : WeightTwoPointPresentation.Generator k) :
    cycleValue k Z.cycle = generatorValue Z := by
  change cycleValue k (Finsupp.single Z 1) = _
  rw [cycleValue_single, one_zsmul]

section WholeFibers

variable (p : MonicIrreducible k) (hp0 : p.val.coeff 0 ≠ 0)

/-- The fixed-root polynomial norm is additive in the second unit. -/
def rootSymbolHom : Additive (AdjoinRoot p.val)ˣ →+ MilnorK.K2.Group k :=
  (polynomialNorm p).toAddMonoidHom.comp
    ((symbolBilinear (AdjoinRoot p.val)) (Additive.ofMul (rootUnit p hp0))).toAddMonoidHom

@[simp] theorem rootSymbolHom_apply (v : (AdjoinRoot p.val)ˣ) :
    rootSymbolHom p hp0 (Additive.ofMul v) = polynomialNorm p (symbol (rootUnit p hp0) v) := rfl

variable (B : Type u) [CommRing B] [Algebra (AdjoinRoot p.val) B]
  [Module.Finite (AdjoinRoot p.val) B]

/-- The actual value of a maximal quotient of a finite algebra, with first
coordinate the specified constant root and second coordinate its given unit.
The base scalar map is the original composite through that root field. -/
def residueValue (v : Bˣ) (x : MaximalSpectrum B) : MilnorK.K2.Group k :=
  letI : Field (B ⧸ x.asIdeal) := Ideal.Quotient.field x.asIdeal
  letI : Algebra k (B ⧸ x.asIdeal) :=
    ((algebraMap (AdjoinRoot p.val) (B ⧸ x.asIdeal)).comp
      (algebraMap k (AdjoinRoot p.val))).toAlgebra
  letI : IsScalarTower k (AdjoinRoot p.val) (B ⧸ x.asIdeal) :=
    IsScalarTower.of_algebraMap_eq' rfl
  letI : Module.Finite k (AdjoinRoot p.val) := p.property.1.finite_adjoinRoot
  letI : Module.Finite k (B ⧸ x.asIdeal) := Module.Finite.trans (AdjoinRoot p.val) _
  value (k := k)
    (Units.map (algebraMap (AdjoinRoot p.val) (B ⧸ x.asIdeal)).toMonoidHom (rootUnit p hp0))
    (Units.map (Ideal.Quotient.mk x.asIdeal).toMonoidHom v)

/-- The canonical first-coordinate evaluator on each actual maximal quotient
uses precisely the original root polynomial and ordinary quotient-field norm. -/
theorem residueValue_eq (v : Bˣ) (x : MaximalSpectrum B) :
    residueValue p hp0 B v x = polynomialNorm p (symbol (rootUnit p hp0)
      (Units.map (Algebra.norm (AdjoinRoot p.val))
        (Units.map (Ideal.Quotient.mk x.asIdeal).toMonoidHom v))) := by
  let : Field (B ⧸ x.asIdeal) := Ideal.Quotient.field x.asIdeal
  let : Algebra k (B ⧸ x.asIdeal) :=
    ((algebraMap (AdjoinRoot p.val) (B ⧸ x.asIdeal)).comp
      (algebraMap k (AdjoinRoot p.val))).toAlgebra
  let : IsScalarTower k (AdjoinRoot p.val) (B ⧸ x.asIdeal) :=
    IsScalarTower.of_algebraMap_eq' rfl
  let : Module.Finite k (AdjoinRoot p.val) := p.property.1.finite_adjoinRoot
  let : Module.Finite k (B ⧸ x.asIdeal) := Module.Finite.trans (AdjoinRoot p.val) _
  change value (k := k) _ _ = _
  rw [value_eq_valueVia p hp0 (IsScalarTower.toAlgHom k (AdjoinRoot p.val) (B ⧸ x.asIdeal))
    _ _ rfl]
  unfold valueVia
  rw [show (IsScalarTower.toAlgHom k (AdjoinRoot p.val) (B ⧸ x.asIdeal)).toRingHom.toAlgebra =
      (inferInstance : Algebra (AdjoinRoot p.val) (B ⧸ x.asIdeal)) from toAlgebra_algebraMap]

/-- The whole length-weighted sum of actual point values is the fixed-root
symbol of the full finite algebra norm. Nilpotents and every maximal quotient
are retained, including the empty spectrum of the zero algebra. -/
theorem sum_residueValue [Fintype (MaximalSpectrum B)] (v : Bˣ) :
    (∑ x : MaximalSpectrum B,
      (Module.length (Localization.AtPrime x.asIdeal)
        (Localization.AtPrime x.asIdeal)).toNat • residueValue p hp0 B v x) =
      polynomialNorm p
        (symbol (rootUnit p hp0) (Units.map (Algebra.norm (AdjoinRoot p.val)) v)) := by
  classical
  have hn : Units.map (Algebra.norm (AdjoinRoot p.val)) v =
      ∏ x : MaximalSpectrum B,
        (Units.map (Algebra.norm (AdjoinRoot p.val))
          (Units.map (Ideal.Quotient.mk x.asIdeal).toMonoidHom v)) ^
          (Module.length (Localization.AtPrime x.asIdeal)
            (Localization.AtPrime x.asIdeal)).toNat := by
    apply Units.ext
    simpa using
      Algebra.norm_eq_prod_quotient_norm_pow_local_length (k := AdjoinRoot p.val) (v : B)
  rw [← rootSymbolHom_apply, hn, ofMul_prod, map_sum]
  apply Finset.sum_congr rfl
  intro x _
  rw [ofMul_pow, map_nsmul, rootSymbolHom_apply, residueValue_eq]

end WholeFibers

section PolynomialFibers

open Algebra.PolynomialFiber

variable (p : MonicIrreducible k) (hp0 : p.val.coeff 0 ≠ 0)
  (B : Type u) [CommRing B] [Algebra (AdjoinRoot p.val)[X] B]
  [Module.Finite (AdjoinRoot p.val)[X] B]

/-- The entire specialized point-value sum, over every actual maximal
quotient and weighted by its local length. Its finite index is derived. -/
def fiberValue (v : Bˣ) (a : AdjoinRoot p.val) : MilnorK.K2.Group k :=
  letI : Finite (MaximalSpectrum (Fiber B a)) :=
    Module.finiteAlgebra_maximalSpectrum_finite (AdjoinRoot p.val) (Fiber B a)
  letI : Fintype (MaximalSpectrum (Fiber B a)) := Fintype.ofFinite _
  ∑ x : MaximalSpectrum (Fiber B a),
    (Module.length (Localization.AtPrime x.asIdeal)
      (Localization.AtPrime x.asIdeal)).toNat •
        residueValue p hp0 (Fiber B a) (Units.map (specialize B a).toMonoidHom v) x

/-- The literal whole-fiber sum equals the fixed-root symbol of its ordinary
fiber norm. Nonreduced fibers keep their actual local lengths. -/
theorem fiberValue_eq (v : Bˣ) (a : AdjoinRoot p.val) :
    fiberValue p hp0 B v a = polynomialNorm p (symbol (rootUnit p hp0)
      (Units.map (Algebra.norm (AdjoinRoot p.val))
        (Units.map (specialize B a).toMonoidHom v))) := by
  let : Finite (MaximalSpectrum (Fiber B a)) :=
    Module.finiteAlgebra_maximalSpectrum_finite (AdjoinRoot p.val) (Fiber B a)
  let : Fintype (MaximalSpectrum (Fiber B a)) := Fintype.ofFinite _
  exact sum_residueValue p hp0 (Fiber B a) (Units.map (specialize B a).toMonoidHom v)

/-- Constant-first-coordinate endpoint conservation in the original Milnor
K₂ group, for every finite free polynomial algebra. Both sides are the entire
actual fiber, including nilpotents, nonmonogenic fibers, and all branches.
This restricted family law does not assert general singular-boundary descent. -/
theorem fiberValue_endpoints [Module.Free (AdjoinRoot p.val)[X] B]
    (v : Bˣ) (a b : AdjoinRoot p.val) :
    fiberValue p hp0 B v a = fiberValue p hp0 B v b := by
  rw [fiberValue_eq, fiberValue_eq, normUnits_specialize_eq v a b]

/-- Finite torsion-free polynomial algebras satisfy the same whole-fiber law. -/
theorem fiberValue_endpoints_of_torsionFree
    [Module.IsTorsionFree (AdjoinRoot p.val)[X] B]
    (v : Bˣ) (a b : AdjoinRoot p.val) :
    fiberValue p hp0 B v a = fiberValue p hp0 B v b := by
  let : Module.Free (AdjoinRoot p.val)[X] B := Module.free_of_finite_type_torsion_free'
  exact fiberValue_endpoints p hp0 B v a b

end PolynomialFibers

end Motivic.WeightTwoCoordinateEvaluation
