module

public import Motivic.Aglib.Algebra.Homology.Koszul.Pair.Ideal
public import Motivic.Aglib.Algebra.Homology.Koszul.Pair.Tensor
public import Mathlib.CategoryTheory.Monoidal.Tor

/-!
# Actual Tor computed by a regular two-element Koszul resolution

For a pair regular on the ring `R`, the categorical Tor groups
`Tor_n^R(M, R/(a,b))` are identified with the homology of the explicit Koszul
complex on `M`. This uses the proved projective resolution, mathlib's comparison
with its chosen projective resolution, and the explicit tensor-complex
isomorphism. Regularity is required on `R`, not on `M`.

The result gives the actual zeroth, first and second Tor modules and vanishing
above degree two. It does not assert that arbitrary local intersection ideals
are generated by such a pair, or construct global correspondence composition.
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory

namespace Module.KoszulPair

variable {R : Type u} [CommRing R]
variable (M : Type u) [AddCommGroup M] [Module R M] (a b : R)
variable (ha : IsSMulRegular R a) (hb : IsSMulRegular (PrincipalQuotient R a) b)

/-- Genuine categorical Tor computed by the proved Koszul projective resolution. -/
noncomputable def torIsoHomology (n : ℕ) :
    ((Tor (ModuleCat R) n).obj (ModuleCat.of R M)).obj (ModuleCat.of R (H₀ R a b)) ≅
      (chainComplex M a b).homology n :=
  (projectiveResolution R a b ha hb).isoLeftDerivedObj
    ((tensoringLeft (ModuleCat R)).obj (ModuleCat.of R M)) n ≪≫
      (HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.down ℕ) n).mapIso
        (tensorIso M a b)

/-- The same actual Tor computation with the genuine ideal quotient as its target. -/
noncomputable def torIdealIsoHomology (n : ℕ) :
    ((Tor (ModuleCat R) n).obj (ModuleCat.of R M)).obj
      (ModuleCat.of R (R ⧸ Ideal.span ({a, b} : Set R))) ≅
        (chainComplex M a b).homology n :=
  (idealProjectiveResolution a b ha hb).isoLeftDerivedObj
    ((tensoringLeft (ModuleCat R)).obj (ModuleCat.of R M)) n ≪≫
      (HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.down ℕ) n).mapIso
        (tensorIso M a b)

/-- Zeroth Tor is the actual two-equation quotient on `M`. -/
noncomputable def torZeroIso :
    ((Tor (ModuleCat R) 0).obj (ModuleCat.of R M)).obj (ModuleCat.of R (H₀ R a b)) ≅
      ModuleCat.of R (H₀ M a b) :=
  torIsoHomology M a b ha hb 0 ≪≫ homologyZeroIso M a b

/-- First Tor is the actual cycles modulo the signed Koszul boundaries. -/
noncomputable def torOneIso :
    ((Tor (ModuleCat R) 1).obj (ModuleCat.of R M)).obj (ModuleCat.of R (H₀ R a b)) ≅
      ModuleCat.of R (H₁ M a b) :=
  torIsoHomology M a b ha hb 1 ≪≫ homologyOneIso M a b

/-- Second Tor is the actual kernel of `z ↦ (-b • z, a • z)`. -/
noncomputable def torTwoIso :
    ((Tor (ModuleCat R) 2).obj (ModuleCat.of R M)).obj (ModuleCat.of R (H₀ R a b)) ≅
      ModuleCat.of R (H₂ M a b) :=
  torIsoHomology M a b ha hb 2 ≪≫ homologyTwoIso M a b

include ha hb

/-- Tor above degree two vanishes for a quotient by a regular pair on the ring. -/
theorem isZero_tor_add_three (n : ℕ) :
    IsZero (((Tor (ModuleCat R) (n + 3)).obj (ModuleCat.of R M)).obj
      (ModuleCat.of R (H₀ R a b))) :=
  ((HomologicalComplex.exactAt_iff_isZero_homology _ _).mp
    (exactAt_add_three M a b n)).of_iso (torIsoHomology M a b ha hb (n + 3))

/-- If the pair is also regular on `M`, all positive Tor modules vanish. -/
theorem isZero_tor_succ_of_regular (haM : IsSMulRegular M a)
    (hbM : IsSMulRegular (PrincipalQuotient M a) b) (n : ℕ) :
    IsZero (((Tor (ModuleCat R) (n + 1)).obj (ModuleCat.of R M)).obj
      (ModuleCat.of R (H₀ R a b))) :=
  ((HomologicalComplex.exactAt_iff_isZero_homology _ _).mp
    (exactAt_succ_of_regular M a b haM hbM n)).of_iso
      (torIsoHomology M a b ha hb (n + 1))

end Module.KoszulPair
