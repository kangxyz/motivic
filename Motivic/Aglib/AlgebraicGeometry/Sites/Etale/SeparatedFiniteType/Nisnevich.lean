module

public import Motivic.Aglib.AlgebraicGeometry.Sites.Smooth.Nisnevich.Topology
public import Mathlib.CategoryTheory.Limits.MorphismProperty
public import Mathlib.CategoryTheory.MorphismProperty.OverAdjunction
public import Mathlib.CategoryTheory.Sites.Pullback

/-! # The finite-type small Nisnevich site

Objects are actual separated finite-type étale schemes over the base. This is
not the big smooth slice: closed inverse images must be constructed from the
base-change functor and its sheaf adjunction, not by precomposition with a
closed immersion.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v

namespace AlgebraicGeometry.Scheme

/-- Separated finite-type étale structure morphisms. -/
abbrev etaleSeparatedFiniteType : MorphismProperty Scheme.{u} :=
  (@Etale ⊓ @IsSeparated) ⊓ @QuasiCompact

instance etaleSeparatedFiniteType_isStableUnderBaseChange :
    etaleSeparatedFiniteType.{u}.IsStableUnderBaseChange where
  of_isPullback sq hg :=
    ⟨⟨MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @Etale) sq hg.1.1,
      MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsSeparated) sq hg.1.2⟩,
      MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @QuasiCompact) sq hg.2⟩

instance etaleSeparatedFiniteType_isMultiplicative :
    etaleSeparatedFiniteType.{u}.IsMultiplicative where
  id_mem X := ⟨⟨inferInstance, inferInstance⟩, inferInstance⟩
  comp_mem f g hf hg := by
    have : Etale f := hf.1.1
    have : Etale g := hg.1.1
    have : IsSeparated f := hf.1.2
    have : IsSeparated g := hg.1.2
    have : QuasiCompact f := hf.2
    have : QuasiCompact g := hg.2
    exact ⟨⟨inferInstance, inferInstance⟩, inferInstance⟩

instance etaleSeparatedFiniteType_hasOfPostcompProperty :
    etaleSeparatedFiniteType.{u}.HasOfPostcompProperty etaleSeparatedFiniteType where
  of_postcomp f g hg hfg := by
    have : Etale g := hg.1.1
    have : IsSeparated g := hg.1.2
    have : Etale (f ≫ g) := hfg.1.1
    have : IsSeparated (f ≫ g) := hfg.1.2
    have : QuasiCompact (f ≫ g) := hfg.2
    exact ⟨⟨Etale.of_comp f g, IsSeparated.of_comp f g⟩, QuasiCompact.of_comp f g⟩

/-- The native small site category, retaining the actual schemes and scheme maps. -/
abbrev EtaleSeparatedFiniteType (S : Scheme.{u}) := etaleSeparatedFiniteType.Over ⊤ S

namespace EtaleSeparatedFiniteType

variable {S T : Scheme.{u}}

instance (X : EtaleSeparatedFiniteType S) : Etale X.hom := X.prop.1.1
instance (X : EtaleSeparatedFiniteType S) : IsSeparated X.hom := X.prop.1.2
instance (X : EtaleSeparatedFiniteType S) : QuasiCompact X.hom := X.prop.2

/-- Forget the structure map, without changing the underlying scheme. -/
abbrev forgetScheme (S : Scheme.{u}) : EtaleSeparatedFiniteType S ⥤ Scheme.{u} :=
  MorphismProperty.Over.forget _ _ S ⋙ Over.forget S

/-- The actual Nisnevich covering families on the small finite-type site. -/
def nisnevichPrecoverage (S : Scheme.{u}) : Precoverage (EtaleSeparatedFiniteType S) :=
  Nisnevich.precoverage.comap (forgetScheme S)

/-- The topology generated by actual Nisnevich families, not the étale topology. -/
def nisnevichTopology (S : Scheme.{u}) : GrothendieckTopology (EtaleSeparatedFiniteType S) :=
  (nisnevichPrecoverage S).toGrothendieck

/-- The underlying point and residue-field criterion is unchanged. -/
theorem ofArrows_mem_nisnevichPrecoverage_iff {X : EtaleSeparatedFiniteType S} {ι : Type*}
    {Y : ι → EtaleSeparatedFiniteType S} (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows Y f ∈ nisnevichPrecoverage S X ↔
      (∀ i, Etale (f i).left) ∧ ∀ x : X.left,
        ∃ (i : ι) (y : (Y i).left), (f i).left y = x ∧
          IsIso ((f i).left.residueFieldMap y) := by
  change (Presieve.ofArrows Y f).map (forgetScheme S) ∈ Nisnevich.precoverage X.left ↔ _
  rw [Presieve.map_ofArrows]
  exact Nisnevich.ofArrows_mem_precoverage_iff _

/-- Actual base change of separated finite-type étale objects. -/
def baseChange (f : T ⟶ S) : EtaleSeparatedFiniteType S ⥤ EtaleSeparatedFiniteType T :=
  MorphismProperty.Over.pullback etaleSeparatedFiniteType ⊤ f

/-- Restrict an ambient smooth presheaf to the finite-type étale neighborhood objects. -/
def toSmoothSite {B : Scheme.{u}} (X : SmoothSite B) :
    EtaleSeparatedFiniteType X.left ⥤ SmoothSite B where
  obj U := SmoothSite.mk (U.hom ≫ X.hom)
  map f := SmoothSite.homMk f.left (by simp [← Category.assoc])
  map_id _ := rfl
  map_comp _ _ := rfl

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).HasIsos := by
  unfold nisnevichPrecoverage
  infer_instance

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).IsStableUnderComposition := by
  unfold nisnevichPrecoverage
  infer_instance

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).IsStableUnderBaseChange := by
  unfold nisnevichPrecoverage
  infer_instance

instance (S : Scheme.{u}) : (forgetScheme S).IsContinuous
    (nisnevichTopology S) Nisnevich.topology :=
  Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy _ _ _ le_rfl

instance toSmoothSite_preservesPullbacks {B : Scheme.{u}} (X : SmoothSite B) :
    PreservesLimitsOfShape WalkingCospan (toSmoothSite X) := by
  have : PreservesLimitsOfShape WalkingCospan
      (toSmoothSite X ⋙ SmoothSite.forgetScheme B) :=
    inferInstanceAs (PreservesLimitsOfShape WalkingCospan (forgetScheme X.left))
  exact preservesLimitsOfShape_of_reflects_of_preserves
    (toSmoothSite X) (SmoothSite.forgetScheme B)

instance toSmoothSite_isContinuous {B : Scheme.{u}} (X : SmoothSite B) :
    (toSmoothSite X).IsContinuous
      (nisnevichTopology X.left) (SmoothSite.nisnevichTopology B) := by
  apply Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
  rw [SmoothSite.nisnevichPrecoverage, ← Precoverage.comap_comp]
  exact le_rfl

/-- Base change carries a map to its actual cartesian square of schemes. -/
theorem baseChange_map_isPullback (b : T ⟶ S) {U V : EtaleSeparatedFiniteType S} (f : U ⟶ V) :
    IsPullback ((baseChange b).map f).left (pullback.fst U.hom b)
      (pullback.fst V.hom b) f.left := by
  apply IsPullback.of_right (h₁₂ := pullback.snd V.hom b) (h₂₂ := V.hom)
    (v₁₃ := b)
  · change IsPullback
      (pullback.lift (pullback.fst U.hom b ≫ f.left) (pullback.snd U.hom b) _ ≫
        pullback.snd V.hom b) (pullback.fst U.hom b) b (f.left ≫ V.hom)
    rw [pullback.lift_snd, MorphismProperty.Over.w]
    exact (IsPullback.of_hasPullback U.hom b).flip
  · exact pullback.lift_fst _ _ _
  · exact (IsPullback.of_hasPullback V.hom b).flip

instance baseChange_preservesFiniteLimits (b : T ⟶ S) :
    PreservesFiniteLimits (baseChange b) :=
  inferInstanceAs (PreservesFiniteLimits
    (MorphismProperty.Over.pullback etaleSeparatedFiniteType ⊤ b))

instance baseChange_isContinuous (b : T ⟶ S) :
    (baseChange b).IsContinuous (nisnevichTopology S) (nisnevichTopology T) := by
  apply Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
  intro U R hR
  obtain ⟨ι, V, f, rfl⟩ := R.exists_eq_ofArrows
  change (Presieve.ofArrows V f).map (baseChange b) ∈ nisnevichPrecoverage T _
  rw [Presieve.map_ofArrows]
  change (Presieve.ofArrows _ _).map (forgetScheme T) ∈ Nisnevich.precoverage _
  rw [Presieve.map_ofArrows]
  apply Precoverage.mem_coverings_of_isPullback (fun i ↦ (f i).left)
    ((Nisnevich.ofArrows_mem_precoverage_iff _).mpr
      ((ofArrows_mem_nisnevichPrecoverage_iff f).mp hR))
    (pullback.fst U.hom b)
    (fun i ↦ ((baseChange b).map (f i)).left)
    (fun i ↦ pullback.fst (V i).hom b)
  intro i
  exact baseChange_map_isPullback b (f i)

/-- The original coefficient sheaf restricted to the actual small Nisnevich site. -/
def restrict {B : Scheme.{u}} (X : SmoothSite B) (A : Type*) [Category* A] :
    Sheaf (SmoothSite.nisnevichTopology B) A ⥤ Sheaf (nisnevichTopology X.left) A :=
  (toSmoothSite X).sheafPushforwardContinuous A _ _

end EtaleSeparatedFiniteType
end AlgebraicGeometry.Scheme
