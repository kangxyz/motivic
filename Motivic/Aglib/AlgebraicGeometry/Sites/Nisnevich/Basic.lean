module

public import Motivic.Aglib.AlgebraicGeometry.Sites.Nisnevich.FieldLifting
public import Mathlib.AlgebraicGeometry.Sites.Etale

/-!
# The big Nisnevich topology

A covering family consists of étale morphisms and lifts every field-valued
point. `mem_precoverage_iff` identifies this with the usual condition: every
point has a preimage inducing an isomorphism on residue fields. Isomorphisms,
base change and composition of covers are proved, yielding a genuine
pretopology and Grothendieck topology.

At `Spec K`, every covering family contains a split morphism and every covering
sieve is maximal. These statements are for the Nisnevich topology; they do not
assert exact evaluation for the étale topology.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Nisnevich

/-- Nisnevich covers: étale families lifting every field-valued point. -/
def precoverage : Precoverage Scheme.{u} :=
  Scheme.etalePrecoverage ⊓ fieldLiftingPrecoverage

section

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

-- Pin these higher-order property instances explicitly: the generic projection
-- search does not recover them for `@Etale` in this import configuration.
local instance : MorphismProperty.ContainsIdentities (@Etale : MorphismProperty Scheme.{u}) :=
  Etale.instIsMultiplicativeScheme.toContainsIdentities

local instance : MorphismProperty.IsStableUnderComposition
    (@Etale : MorphismProperty Scheme.{u}) :=
  Etale.instIsMultiplicativeScheme.toIsStableUnderComposition

local instance : Scheme.IsJointlySurjectivePreserving
    (@Etale : MorphismProperty Scheme.{u}) :=
  Scheme.isJointlySurjectivePreserving _

local instance : MorphismProperty.RespectsIso (@Etale : MorphismProperty Scheme.{u}) :=
  MorphismProperty.respectsIso_of_isStableUnderComposition (fun _ _ _f _ ↦ inferInstance)

instance : precoverage.{u}.HasIsos := by
  unfold precoverage Scheme.etalePrecoverage
  infer_instance

instance : precoverage.{u}.IsStableUnderBaseChange := by
  unfold precoverage Scheme.etalePrecoverage
  infer_instance

instance : precoverage.{u}.IsStableUnderComposition := by
  unfold precoverage Scheme.etalePrecoverage
  infer_instance

end

/-- The big Nisnevich pretopology on schemes. -/
def pretopology : Pretopology Scheme.{u} := precoverage.toPretopology

/-- The big Nisnevich Grothendieck topology on schemes. -/
def topology : GrothendieckTopology Scheme.{u} := precoverage.toGrothendieck

/-- The standard point-and-residue-field characterization of a Nisnevich family. -/
theorem mem_precoverage_iff {X : Scheme.{u}} {R : Presieve X} :
    R ∈ precoverage X ↔ (∀ ⦃Y : Scheme.{u}⦄ (f : Y ⟶ X), R f → Etale f) ∧
      IsResidueFieldLifting R := by
  constructor
  · rintro ⟨he, hl⟩
    exact ⟨fun {_} _ hf ↦ he.2 hf, mem_fieldLiftingPrecoverage_iff_residueField.mp hl⟩
  · rintro ⟨he, hl⟩
    refine ⟨⟨?_, fun {Y f} hf ↦ he f hf⟩,
      mem_fieldLiftingPrecoverage_iff_residueField.mpr hl⟩
    rw [Presieve.mem_comap_jointlySurjectivePrecoverage_iff]
    intro x
    obtain ⟨Y, f, hf, y, hy, _⟩ := hl x
    exact ⟨Y, f, hf, y, hy⟩

/-- An indexed family is Nisnevich exactly when it is étale and lifts all residue fields. -/
theorem ofArrows_mem_precoverage_iff {X : Scheme.{u}} {ι : Type*}
    {Y : ι → Scheme.{u}} (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows Y f ∈ precoverage X ↔
      (∀ i, Etale (f i)) ∧
        ∀ x : X, ∃ (i : ι) (y : Y i), f i y = x ∧ IsIso ((f i).residueFieldMap y) := by
  rw [mem_precoverage_iff]
  constructor
  · rintro ⟨he, hl⟩
    refine ⟨fun i ↦ he _ ⟨i⟩, fun x ↦ ?_⟩
    obtain ⟨_, _, ⟨i⟩, y, hy, hi⟩ := hl x
    exact ⟨i, y, hy, hi⟩
  · rintro ⟨he, hl⟩
    refine ⟨fun {_} _ ⟨i⟩ ↦ he i, fun x ↦ ?_⟩
    obtain ⟨i, y, hy, hi⟩ := hl x
    exact ⟨Y i, f i, ⟨i⟩, y, hy, hi⟩

/-- Zariski covering families are Nisnevich covering families. -/
theorem zariskiPrecoverage_le_precoverage : Scheme.zariskiPrecoverage.{u} ≤ precoverage := by
  intro X R hR
  rw [mem_precoverage_iff]
  refine ⟨fun {_} f hf ↦ ?_, fun x ↦ ?_⟩
  · have : IsOpenImmersion f := hR.2 hf
    infer_instance
  · obtain ⟨Y, f, hf, y, hy⟩ :=
      (Presieve.mem_comap_jointlySurjectivePrecoverage_iff Scheme.forget).mp hR.1 x
    have : IsOpenImmersion f := hR.2 hf
    exact ⟨Y, f, hf, y, hy, inferInstance⟩

/-- The Zariski topology is coarser than the Nisnevich topology. -/
theorem zariskiTopology_le_topology : Scheme.zariskiTopology.{u} ≤ topology :=
  Precoverage.toGrothendieck_mono zariskiPrecoverage_le_precoverage

/-- The Grothendieck topology is generated by the displayed pretopology. -/
theorem pretopology_toGrothendieck : pretopology.{u}.toGrothendieck = topology :=
  Precoverage.toGrothendieck_toPretopology_eq_toGrothendieck

/-- Nisnevich covers are étale covers. -/
theorem topology_le_etaleTopology : topology.{u} ≤ Scheme.etaleTopology :=
  Precoverage.toGrothendieck_mono inf_le_left

/-- Every Nisnevich cover lifts field-valued points. -/
theorem topology_le_fieldLiftingTopology : topology.{u} ≤ fieldLiftingTopology :=
  Precoverage.toGrothendieck_mono inf_le_right

/-- A Nisnevich covering family of `Spec K` contains a split morphism. -/
theorem exists_section_of_mem_precoverage (K : Type u) [Field K]
    {R : Presieve (Spec (.of K))} (hR : R ∈ precoverage _) :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)), R f ∧
      ∃ s : Spec (.of K) ⟶ Y, s ≫ f = 𝟙 _ :=
  exists_section_of_mem_fieldLiftingPrecoverage K hR.2

/-- The only covering sieve at a field spectrum is the maximal sieve. -/
theorem covering_sieve_eq_top (K : Type u) [Field K]
    {S : Sieve (Spec (.of K))} (hS : S ∈ topology _) : S = ⊤ :=
  fieldLifting_covering_sieve_eq_top K (topology_le_fieldLiftingTopology _ hS)

/-- Exact characterization of covering sieves at a field spectrum. -/
theorem mem_topology_iff (K : Type u) [Field K] (S : Sieve (Spec (.of K))) :
    S ∈ topology _ ↔ S = ⊤ := by
  constructor
  · exact covering_sieve_eq_top K
  · rintro rfl
    exact topology.top_mem _

end AlgebraicGeometry.Nisnevich
