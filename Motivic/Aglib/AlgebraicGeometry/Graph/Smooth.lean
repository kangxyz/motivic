module

public import Motivic.Aglib.AlgebraicGeometry.Graph.StalkTransport
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth

/-!
# Regular kernels of actual graphs into smooth schemes

For an arbitrary scheme map `X → Y` with `Y → S` smooth, the actual graph
`X → X ×[S] Y` has at every point a stalk kernel generated by a finite regular
list. Smoothness is used only on `Y → S`; the source `X` may be nonreduced,
disconnected, or non-Noetherian, and `X → Y` need not be flat.
The proof selects an étale polynomial chart on `Y` and an arbitrary affine
chart on its inverse image in `X`, then uses the actual affine graph theorem.
This existence theorem alone does not identify a common diagonal equation list
on an arbitrary correspondence coefficient module.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open RingTheory.Sequence

universe u

namespace AlgebraicGeometry.Scheme.Graph.Affine

set_option backward.isDefEq.respectTransparency false in
/-- A standard-smooth target chart gives a regular kernel for every actual affine graph. -/
theorem exists_regular_kernel_of_isStandardSmooth
    (R A B : Type u) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (f : B →ₐ[R] A)
    (hf : (algebraMap R B).IsStandardSmooth)
    (h : Spec.map (CommRingCat.ofHom f.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap R B)) =
        Spec.map (CommRingCat.ofHom (algebraMap R A))) (p : PrimeSpectrum A) :
    ∃ rs : List ((product R A B).presheaf.stalk
      (morphism (Spec.map (CommRingCat.ofHom (algebraMap R A)))
        (Spec.map (CommRingCat.ofHom (algebraMap R B)))
        (Spec.map (CommRingCat.ofHom f.toRingHom)) h p)),
      IsRegular ((product R A B).presheaf.stalk
        (morphism (Spec.map (CommRingCat.ofHom (algebraMap R A)))
          (Spec.map (CommRingCat.ofHom (algebraMap R B)))
          (Spec.map (CommRingCat.ofHom f.toRingHom)) h p)) rs ∧
      RingHom.ker ((morphism (Spec.map (CommRingCat.ofHom (algebraMap R A)))
        (Spec.map (CommRingCat.ofHom (algebraMap R B)))
        (Spec.map (CommRingCat.ofHom f.toRingHom)) h).stalkMap p).hom = Ideal.ofList rs := by
  obtain ⟨n, g, hcomp, hg⟩ := hf.exists_etale_mvPolynomial
  let := g.toAlgebra
  let := (f.toRingHom.comp g).toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin n) R) B :=
    IsScalarTower.of_algebraMap_eq' hcomp.symm
  have : IsScalarTower R (MvPolynomial (Fin n) R) A :=
    IsScalarTower.of_algebraMap_eq' (by
      symm
      change (f.toRingHom.comp g).comp (algebraMap R (MvPolynomial (Fin n) R)) =
        algebraMap R A
      rw [RingHom.comp_assoc, MvPolynomial.algebraMap_eq, hcomp]
      exact f.comp_algebraMap)
  have : Algebra.Etale (MvPolynomial (Fin n) R) B := hg
  let f' : B →ₐ[MvPolynomial (Fin n) R] A :=
    { __ := f.toRingHom, commutes' _ := rfl }
  have heq : graph R (Fin n) A B f' =
      morphism (Spec.map (CommRingCat.ofHom (algebraMap R A)))
        (Spec.map (CommRingCat.ofHom (algebraMap R B)))
        (Spec.map (CommRingCat.ofHom f.toRingHom)) h :=
    graph_eq_lift R (Fin n) A B f' _
  have hp := etale_stalkPresentation R (Fin n) A B f' p (List.finRange n)
    (List.nodup_finRange n) List.mem_finRange
  rw [← heq]
  exact ⟨_, hp⟩

end AlgebraicGeometry.Scheme.Graph.Affine

namespace AlgebraicGeometry.Scheme.Graph

/-- Every graph into a smooth target has a genuine finite regular stalk-kernel presentation. -/
theorem exists_regular_kernel_of_smooth {X Y S : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ S) [Smooth g] (x : X) :
    ∃ rs : List ((pullback (f ≫ g) g).presheaf.stalk (morphism (f ≫ g) g f rfl x)),
      IsRegular ((pullback (f ≫ g) g).presheaf.stalk (morphism (f ≫ g) g f rfl x)) rs ∧
        RingHom.ker ((morphism (f ≫ g) g f rfl).stalkMap x).hom = Ideal.ofList rs := by
  obtain ⟨U, hU, V, hV, hxV, hVU, hg⟩ := Smooth.exists_isStandardSmooth g (f x)
  obtain ⟨W, hW, hxW, hWV⟩ :=
    exists_isAffineOpen_mem_and_subset (show x ∈ f ⁻¹ᵁ V from hxV)
  obtain ⟨p, hp⟩ : x ∈ Set.range hW.fromSpec := by
    rw [hW.range_fromSpec]
    exact hxW
  let g₀ := (g.appLE U V hVU).hom
  let f₀ := (f.appLE V W hWV).hom
  let := g₀.toAlgebra
  let := (f₀.comp g₀).toAlgebra
  let fA : Γ(Y, V) →ₐ[Γ(S, U)] Γ(X, W) :=
    { __ := f₀, commutes' _ := rfl }
  let a₀ := Spec.map (CommRingCat.ofHom (algebraMap Γ(S, U) Γ(X, W)))
  let b₀ := Spec.map (CommRingCat.ofHom (algebraMap Γ(S, U) Γ(Y, V)))
  let φ₀ := Spec.map (CommRingCat.ofHom fA.toRingHom)
  have h₀ : φ₀ ≫ b₀ = a₀ := by
    rw [← Spec.map_comp]
    rfl
  have hb : b₀ ≫ hU.fromSpec = hV.fromSpec ≫ g :=
    IsAffineOpen.SpecMap_appLE_fromSpec g hU hV hVU
  have hφ : φ₀ ≫ hV.fromSpec = hW.fromSpec ≫ f :=
    IsAffineOpen.SpecMap_appLE_fromSpec f hV hW hWV
  have ha : a₀ ≫ hU.fromSpec = hW.fromSpec ≫ (f ≫ g) := by
    rw [← h₀, Category.assoc, hb, ← Category.assoc, hφ, Category.assoc]
  have hlocal := Affine.exists_regular_kernel_of_isStandardSmooth
    Γ(S, U) Γ(X, W) Γ(Y, V) fA hg h₀ p
  have e := arrowStalkIsoOfOpenChart (f ≫ g) g f rfl a₀ b₀ φ₀ h₀
    hW.fromSpec hV.fromSpec hU.fromSpec ha hb hφ p
  have hglobal := Diagonal.exists_regular_kernel_of_arrowIso e.symm hlocal
  exact Diagonal.exists_regular_kernel_of_arrowIso
    ((morphism (f ≫ g) g f rfl).arrowStalkMapIsoOfEq hp) hglobal

end AlgebraicGeometry.Scheme.Graph
