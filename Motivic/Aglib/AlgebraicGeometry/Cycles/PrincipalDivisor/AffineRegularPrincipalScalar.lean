module

public import Motivic.Aglib.AlgebraicGeometry.Cycles.PrincipalDivisor.AffineRegularPrincipalGenericity

/-!
# Original scalar kernels for affine principal quotient cycles

The literal quotient inclusion has stalk kernel generated by the original
scalar germ. This identifies the checked whole nonreduced zero-cycle coefficient
with the exact scalar quotient length. No ambient domain hypothesis is used.


Intended upstream module:
`Aglib.AlgebraicGeometry.Cycles.PrincipalDivisor.AffineRegularPrincipalScalar`.
Incoming project consumers:
`Motivic.Aglib.AlgebraicGeometry.Cycles.Divisors.Frame.AffineSectionZero`,
`Motivic.Aglib.AlgebraicGeometry.Cycles.Pushforward.Finite.AffineRegularNormCycle`.
-/

@[expose] public noncomputable section
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory AlgebraicGeometry

universe u
namespace AlgebraicGeometry.Scheme

variable (B : CommRingCat.{u}) (a : B)

/-- The actual affine principal quotient inclusion retains its original equation
in the global section kernel. -/
theorem principalQuotient_kernel_top :
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a})))).ker.ideal
        ⟨⊤, isAffineOpen_top (Spec B)⟩ =
      Ideal.span {(ΓSpecIso B).inv a} := by
  let i := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a})))
  rw [Hom.ker_apply]
  apply Ideal.comap_injective_of_surjective (ΓSpecIso B).inv.hom
    (ΓSpecIso B).symm.commRingCatIsoToRingEquiv.surjective
  rw [RingHom.comap_ker]
  have hn := congrArg CommRingCat.Hom.hom
    (ΓSpecIso_inv_naturality (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a}))))
  change (ΓSpecIso (.of (B ⧸ Ideal.span {a}))).inv.hom.comp
      (Ideal.Quotient.mk (Ideal.span {a})) =
    i.appTop.hom.comp (ΓSpecIso B).inv.hom at hn
  rw [← hn]
  have hi : Function.Injective (ΓSpecIso (.of (B ⧸ Ideal.span {a}))).inv.hom :=
    (ΓSpecIso (.of (B ⧸ Ideal.span {a}))).symm.commRingCatIsoToRingEquiv.injective
  rw [RingHom.ker_comp_of_injective _ hi, Ideal.mk_ker]
  have hm : Ideal.span {(ΓSpecIso B).inv a} =
      (Ideal.span {a}).map (ΓSpecIso B).inv.hom := by
    rw [Ideal.map_span, Set.image_singleton]
  have hb : Function.Bijective (ΓSpecIso B).inv.hom :=
    (ΓSpecIso B).symm.commRingCatIsoToRingEquiv.bijective
  rw [hm, Ideal.comap_map_of_bijective _ hb]

/-- At every original point the actual principal quotient kernel is the ideal
of the original scalar germ, including points outside the zero scheme. -/
theorem principalQuotient_kernel_stalk (x : Spec B) :
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a})))).ker.stalk x =
      Ideal.span {(Spec B).presheaf.germ ⊤ x (by trivial) ((ΓSpecIso B).inv a)} := by
  rw [IdealSheafData.stalk_eq_map _ ⟨⊤, isAffineOpen_top (Spec B)⟩ (by trivial),
    principalQuotient_kernel_top, Ideal.map_span, Set.image_singleton]

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme

open Classical in
/-- The original regular principal zero-cycle coefficient is the full scalar
quotient length at height one and zero elsewhere, without reducing the quotient. -/
theorem affine_regular_quotient_fundamentalCoefficient_scalar
    (B : CommRingCat.{u}) [IsNoetherianRing B]
    (a : B) (ha : a ∈ nonZeroDivisors B) (x : Spec B) :
    _root_.AlgebraicGeometry.Scheme.IntegralCycle.toPoints
      (_root_.AlgebraicGeometry.Scheme.IntegralCycle.finitePushforward
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {a}))))
        (_root_.AlgebraicGeometry.Scheme.fundamentalCycle (Spec (.of (B ⧸ Ideal.span {a}))))) x =
      if x.asIdeal.height = 1 then
        ((Module.length ((Spec B).presheaf.stalk x)
          (((Spec B).presheaf.stalk x) ⧸ Ideal.span {
            (Spec B).presheaf.germ ⊤ x (by trivial) ((Scheme.ΓSpecIso B).inv a)})).toNat : ℤ)
      else 0 := by
  classical
  have h := _root_.AlgebraicGeometry.Scheme.affine_regular_quotient_fundamentalCoefficient B a ha x
  dsimp only at h
  rw [Scheme.principalQuotient_kernel_stalk] at h
  exact h

end AlgebraicGeometry.Scheme
