module

public import Motivic.Aglib.AlgebraicGeometry.GraphClosedSupportBlock

/-!
# Actual graph-plus-endpoint Tor on a closed support

The two actual ambient quotients first identify the smooth graph coordinates,
then impose the literal endpoint equation. The coefficient quotient identifies
the same graph coordinates on the original closed support. The existing regular
leading-block Tor theorem therefore leaves precisely its original `t - a`
Koszul complex, in every degree. Only the ambient projection and ambient
parameter map are assumed flat; no support projection is assumed flat.

This local theorem retains the actual stalk scalar actions. The remaining
correspondence task is to identify these stalk modules with the four-factor
incidence modules and assemble the whole-family cycle identity.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory AlgebraicGeometry
open RingTheory.Sequence AlgebraicGeometry.FiniteFlatCurve

universe u

private theorem pointed_surjective {U V : Scheme.{u}} (q : U ⟶ V)
    [IsClosedImmersion q] (u : U) (v : V) (hv : v = q u) :
    Function.Surjective (Motivic.StalkTransport.pointedMap q u v hv) := by
  change Function.Surjective (fun r => q.stalkMap u
    ((V.presheaf.stalkCongr (.of_eq hv)).hom r))
  exact (q.stalkMap_surjective u).comp
    (ConcreteCategory.bijective_of_isIso (V.presheaf.stalkCongr (.of_eq hv)).hom).2

namespace Motivic.Graph

section SupportMaps

variable {C P X S : Scheme.{u}} (h : P ⟶ X) (b : X ⟶ S) (j : C ⟶ P)

/-- The actual coefficient stalk action is surjective for a closed support. -/
theorem supportStalkMap_surjective [IsClosedImmersion j] (x : C) :
    Function.Surjective (supportStalkMap h b j x) := by
  unfold supportStalkMap
  apply pointed_surjective

/-- The actual closed support square commutes on stalks, including the
canonical equality of its two ambient graph points. -/
theorem supportStalkMap_graphStalkMap (x : C) :
    supportStalkMap h b j x ≫ (correspondenceGraph (j ≫ h) b).stalkMap x =
      (correspondenceGraph h b).stalkMap (j x) ≫ j.stalkMap x := by
  simp only [supportStalkMap, StalkTransport.pointedMap, Category.assoc,
    ← Scheme.Hom.stalkMap_comp]
  exact (Scheme.Hom.stalkMap_congr_hom _ _ (supportProductMap_graph h b j).symm x).symm

end SupportMaps

variable {k : Type u} [Field k] {C P X : Scheme.{u}}
  (h : P ⟶ X) (b : X ⟶ Spec (.of k))
  (f : P ⟶ Spec (.of (Polynomial k))) (a : k) (j : C ⟶ P)

/-- The source point in the original closed support, before the endpoint cut. -/
abbrev cutPoint (z : fiber (j ≫ f) a) : C := fiberInclusion (j ≫ f) a z

/-- The actual endpoint-source stalk map, aligned at the original ambient point. -/
def endpointSourceStalkMap (z : fiber (j ≫ f) a) :
    P.presheaf.stalk (j (cutPoint f a j z)) ⟶
      (fiber f a).presheaf.stalk (fiberMap f a j z) :=
  StalkTransport.pointedMap (fiberInclusion f a) (fiberMap f a j z) (j (cutPoint f a j z))
    (congrArg (fun q : fiber (j ≫ f) a ⟶ P => q z) (fiberMap_inclusion f a j)).symm

/-- The actual closed endpoint stalk quotient is surjective. -/
theorem endpointSourceStalkMap_surjective (z : fiber (j ≫ f) a) :
    Function.Surjective (endpointSourceStalkMap f a j z) := by
  unfold endpointSourceStalkMap
  apply pointed_surjective

/-- Its literal kernel is generated by the original retained endpoint scalar. -/
theorem endpointSourceStalkMap_kernel (z : fiber (j ≫ f) a) :
    RingHom.ker (endpointSourceStalkMap f a j z).hom =
      Ideal.ofList [scalar f a (j (cutPoint f a j z))] := by
  rw [endpointSourceStalkMap, StalkTransport.pointedMap, CommRingCat.hom_comp,
    ← RingHom.comap_ker, ← Scheme.Hom.ker_stalk,
    Scheme.IdealSheafData.stalk_congr_comap, fiberInclusion_stalk]
  exact (congrArg (fun q : fiber (j ≫ f) a ⟶ P => q z)
    (fiberMap_inclusion f a j)).symm

/-- The endpoint is regular on the ambient source; its quotient is the actual
nonzero fiber stalk, so the singleton is a proper regular sequence. -/
theorem endpointSource_scalar_regular [Flat f] (z : fiber (j ≫ f) a) :
    IsRegular (P.presheaf.stalk (j (cutPoint f a j z)))
      [scalar f a (j (cutPoint f a j z))] := by
  refine ⟨(isWeaklyRegular_singleton_iff _ _).mpr (scalar_regular f a _), ?_⟩
  rw [Ideal.smul_eq_mul, Ideal.mul_top, ← endpointSourceStalkMap_kernel f a j z]
  exact (RingHom.ker_ne_top (endpointSourceStalkMap f a j z).hom).symm

/-- Both actual quotient paths send the ambient parameter to the original
closed-support parameter. No choice of an abstract scalar is involved. -/
theorem support_polynomialScalar (x : C) :
    ((correspondenceGraph (j ≫ h) b).stalkMap x).hom
      ((supportStalkMap h b j x).hom
        (scalar (polynomialParameter h b f) a (correspondenceGraph h b (j x)))) =
      scalar (j ≫ f) a x := by
  change (supportStalkMap h b j x ≫ (correspondenceGraph (j ≫ h) b).stalkMap x)
      (scalar (polynomialParameter h b f) a (correspondenceGraph h b (j x))) = _
  rw [supportStalkMap_graphStalkMap, CommRingCat.comp_apply, polynomialScalar_graph]
  exact (scalar_comp j f a x).symm

/-- The original ambient graph local ring at the point of the closed endpoint. -/
abbrev polynomialAmbientStalk (z : fiber (j ≫ f) a) : CommRingCat :=
  (pullback (h ≫ b) b).presheaf.stalk (correspondenceGraph h b (j (cutPoint f a j z)))

/-- The original closed product-support local ring at that graph point. -/
abbrev polynomialCoefficientStalk (z : fiber (j ≫ f) a) : CommRingCat :=
  (pullback ((j ≫ h) ≫ b) b).presheaf.stalk
    (correspondenceGraph (j ≫ h) b (cutPoint f a j z))

/-- The actual ambient-to-endpoint quotient, in graph-then-parameter order. -/
def graphEndpointStalkMap (z : fiber (j ≫ f) a) : polynomialAmbientStalk h b f a j z ⟶
    (fiber f a).presheaf.stalk (fiberMap f a j z) :=
  (correspondenceGraph h b).stalkMap (j (cutPoint f a j z)) ≫ endpointSourceStalkMap f a j z

/-- The actual categorical Tor object with its two original stalk actions. -/
abbrev polynomialTor (z : fiber (j ≫ f) a) (n : ℕ) :
    ModuleCat (polynomialAmbientStalk h b f a j z) :=
  ((Tor (ModuleCat (polynomialAmbientStalk h b f a j z)) n).obj
        ((ModuleCat.restrictScalars (supportStalkMap h b j (cutPoint f a j z)).hom).obj
          (ModuleCat.of (polynomialCoefficientStalk h b f a j z)
            (polynomialCoefficientStalk h b f a j z)))).obj
        ((ModuleCat.restrictScalars (graphEndpointStalkMap h b f a j z).hom).obj
          (ModuleCat.of ((fiber f a).presheaf.stalk (fiberMap f a j z))
            ((fiber f a).presheaf.stalk (fiberMap f a j z))))

/-- Actual categorical Tor loses exactly the common smooth graph block and
retains the original singleton endpoint complex on the original closed support. -/
theorem polynomialTor_length [Smooth b] [IsSeparated b] [Flat h] [Flat f]
    [IsClosedImmersion j] (z : fiber (j ≫ f) a) (n : ℕ) :
    Module.length (polynomialAmbientStalk h b f a j z)
      (polynomialTor h b f a j z n) =
      Module.length (C.presheaf.stalk (cutPoint f a j z))
        ((Koszul.coefficientComplex
          (ModuleCat.of (C.presheaf.stalk (cutPoint f a j z))
            (C.presheaf.stalk (cutPoint f a j z)))
          [scalar (j ≫ f) a (cutPoint f a j z)]).homology n) := by
  let x := cutPoint f a j z
  obtain ⟨t, ht, hft, hCt, hct⟩ := exists_common_graphKernel h b j x
  let r := scalar (polynomialParameter h b f) a (correspondenceGraph h b (j x))
  have hs : [r].map ((correspondenceGraph h b).stalkMap (j x)).hom =
      [scalar f a (j x)] := by
    rw [List.map_singleton]
    exact congrArg List.singleton (polynomialScalar_graph h b f a (j x))
  have hr : ([r].map (supportStalkMap h b j x).hom).map
      ((correspondenceGraph (j ≫ h) b).stalkMap x).hom = [scalar (j ≫ f) a x] := by
    rw [List.map_singleton, List.map_singleton]
    exact congrArg List.singleton (support_polynomialScalar h b f a j x)
  have he := Koszul.regularLeadingBlockTor_length
    ((correspondenceGraph h b).stalkMap (j x)).hom (endpointSourceStalkMap f a j z).hom
    ((correspondenceGraph h b).stalkMap_surjective (j x))
    (endpointSourceStalkMap_surjective f a j z)
    (supportStalkMap h b j x).hom ((correspondenceGraph (j ≫ h) b).stalkMap x).hom
    (supportStalkMap_surjective h b j x)
    ((correspondenceGraph (j ≫ h) b).stalkMap_surjective x)
    t [r] ht hft (hs.symm ▸ endpointSource_scalar_regular f a j z)
    (by rw [hs]; exact endpointSourceStalkMap_kernel f a j z)
    hct hCt.toIsWeaklyRegular n
  rw [hr] at he
  exact he

/-- Degree zero retains the literal principal quotient and its full extended-
natural length, without reducing the support or converting infinite lengths. -/
theorem polynomialTor_zero_length [Smooth b] [IsSeparated b] [Flat h] [Flat f]
    [IsClosedImmersion j] (z : fiber (j ≫ f) a) :
    Module.length (polynomialAmbientStalk h b f a j z)
      (polynomialTor h b f a j z 0) =
      Module.length (C.presheaf.stalk (cutPoint f a j z))
        ((C.presheaf.stalk (cutPoint f a j z)) ⧸
          Ideal.ofList [scalar (j ≫ f) a (cutPoint f a j z)]) := by
  rw [polynomialTor_length, Koszul.coefficientComplex_ring]
  exact (Koszul.homologyZeroIdealIso _).toLinearEquiv.length_eq

/-- A regular surviving scalar kills every positive actual Tor group. -/
theorem polynomialTor_isZero_succ_of_scalar_regular
    [Smooth b] [IsSeparated b] [Flat h] [Flat f] [IsClosedImmersion j]
    (z : fiber (j ≫ f) a)
    (hr : IsSMulRegular (C.presheaf.stalk (cutPoint f a j z))
      (scalar (j ≫ f) a (cutPoint f a j z))) (n : ℕ) :
    IsZero (polynomialTor h b f a j z (n + 1)) := by
  apply ModuleCat.isZero_iff_subsingleton.mpr
  apply (Module.length_eq_zero_iff
    (R := polynomialAmbientStalk h b f a j z)).mp
  rw [polynomialTor_length]
  have : Subsingleton ((Koszul.coefficientComplex
      (ModuleCat.of (C.presheaf.stalk (cutPoint f a j z))
        (C.presheaf.stalk (cutPoint f a j z)))
      [scalar (j ≫ f) a (cutPoint f a j z)]).homology (n + 1)) :=
    ModuleCat.isZero_iff_subsingleton.mp
      (Koszul.coefficient_exactAt_succ_of_weaklyRegular _ _
        ((isWeaklyRegular_singleton_iff _ _).mpr hr) n).isZero_homology
  exact Module.length_eq_zero

/-- For the original reduced generic supports of a whole flat family,
regularity comes from dominance, not component flatness over the relative base. -/
theorem polynomialTor_component_isZero_succ
    [Smooth b] [IsSeparated b] [Flat h] [Flat f] (v : genericPoints P)
    (z : fiber ((IntegralClosedSubscheme.pointClosure v.val).val.subschemeι ≫ f) a)
    (n : ℕ) :
    IsZero (polynomialTor h b f a
      (IntegralClosedSubscheme.pointClosure v.val).val.subschemeι z (n + 1)) :=
  polynomialTor_isZero_succ_of_scalar_regular h b f a _ z
    (flat_polynomial_component_scalar_regular f v a _) n

end Motivic.Graph
