module

public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.RingTheory.Polynomial.Ideal

/-! # The literal zero fiber of a polynomial chart -/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme

/-- An actual quotient with kernel generated by the specified coordinate is
its schematic zero fiber. The target of the quotient is not replaced. -/
theorem isPullback_polynomial_zero_of_surjective
    {H B D : Type u} [CommRing H] [CommRing B] [CommRing D]
    (ψ : Polynomial H →+* B) (q : B →+* D) (σ : H →+* D)
    (hq : Function.Surjective q) (hk : RingHom.ker q = Ideal.span {ψ Polynomial.X})
    (hσ : (q.comp ψ).comp Polynomial.C = σ) :
    IsPullback (Spec.map (CommRingCat.ofHom q)) (Spec.map (CommRingCat.ofHom σ))
      (Spec.map (CommRingCat.ofHom ψ))
      (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))) := by
  have hz : q (ψ Polynomial.X) = 0 := by
    apply RingHom.mem_ker.mp
    rw [hk]
    exact Ideal.subset_span (by simp)
  have hc : q.comp ψ = σ.comp (Polynomial.evalRingHom 0) := by
    apply Polynomial.ringHom_ext
    · intro h
      simpa using RingHom.congr_fun hσ h
    · simpa using hz
  apply isPullback_SpecMap_of_isPushout
  have hw : CommRingCat.ofHom ψ ≫ CommRingCat.ofHom q =
      CommRingCat.ofHom (Polynomial.evalRingHom (0 : H)) ≫ CommRingCat.ofHom σ := by
    exact CommRingCat.hom_ext hc
  apply IsPushout.of_isColimit (c := PushoutCocone.mk _ _ hw)
  apply PushoutCocone.isColimitAux'
  intro s
  have hker : RingHom.ker q ≤ RingHom.ker s.inl.hom := by
    rw [hk]
    apply Ideal.span_le.mpr
    rintro x (rfl : x = ψ Polynomial.X)
    have h := congrArg (fun f ↦ f.hom Polynomial.X) s.condition
    change s.inl.hom (ψ Polynomial.X) = s.inr.hom ((Polynomial.evalRingHom 0) Polynomial.X) at h
    simpa [RingHom.mem_ker] using h
  let d : CommRingCat.of D ⟶ s.pt := CommRingCat.ofHom
    (q.liftOfSurjective hq ⟨s.inl.hom, hker⟩)
  have hd (b : B) : d (q b) = s.inl b := q.liftOfSurjective_comp_apply hq ⟨s.inl.hom, hker⟩ b
  refine ⟨d, ?_, ?_, ?_⟩
  · ext b
    exact hd b
  · ext h
    have hs := congrArg (fun f ↦ f.hom (Polynomial.C h)) s.condition
    change s.inl.hom (ψ (Polynomial.C h)) =
      s.inr.hom ((Polynomial.evalRingHom 0) (Polynomial.C h)) at hs
    have hσh := RingHom.congr_fun hσ h
    change q (ψ (Polynomial.C h)) = σ h at hσh
    change d (σ h) = s.inr h
    rw [← hσh, hd]
    simpa using hs
  · intro m hm _
    ext d'
    obtain ⟨b, rfl⟩ := hq d'
    exact (congrArg (fun f ↦ f b) hm).trans (hd b).symm

end AlgebraicGeometry.Scheme
