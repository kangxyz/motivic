module
public import Motivic.Aglib.AlgebraicGeometry.ProjectiveSpace.QuadraticGlobalChartCoordinates
public import Motivic.Aglib.RingTheory.Bertini.QuadraticInfinityAvoidance
/-! # Whole infinity chart equations are empty, including nilpotents -/
@[expose] public noncomputable section
open AlgebraicGeometry
universe u
attribute [local instance] MvPolynomial.gradedAlgebra
namespace ProjectiveEvaluationIncidence
/-- All field-valued common zeros detect the full unit ideal of the original forms. -/
theorem span_rows_eq_top_of_no_field_points
    (k A : Type u) [CommRing k] [CommRing A] [Algebra k A]
    {N : Type u} [Fintype N] (a : N → A) (n : ℕ) (c : Fin n × N → k)
    (h : ∀ (K : Type u) [Field K] [Algebra k K] [Algebra A K]
      [IsScalarTower k A K], ¬ Vanishes k A K a n c) :
    Ideal.span (Set.range (fun i => ∑ e, algebraMap k A (c (i, e)) * a e)) = ⊤ := by
  by_contra hn
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hn
  let : m.IsMaximal := hm
  let : Field (A ⧸ m) := Ideal.Quotient.field m
  apply h (A ⧸ m)
  intro i
  have hz : Ideal.Quotient.mk m (∑ e, algebraMap k A (c (i, e)) * a e) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (hle (Ideal.subset_span ⟨i, rfl⟩))
  change algebraMap A (A ⧸ m) (∑ e, algebraMap k A (c (i, e)) * a e) = 0 at hz
  simpa only [map_sum, map_mul, ← IsScalarTower.algebraMap_apply k A (A ⧸ m)] using hz
end ProjectiveEvaluationIncidence

namespace QuadraticIncidence.InfinityChart
variable (k R : Type u) [Field k] [CommRing R] [IsDomain R] [Algebra k R]
  {σ : Type u} [Finite σ] (g : σ → R) (d : ℕ)

/-- The actual same-family homogeneous row on the full original infinity quotient. -/
def boundaryRow (j : Exponent σ) (c : Fin (d + 1) × Exponent σ → k)
    (i : Fin (d + 1)) : boundaryRing k R g j :=
  ∑ e, algebraMap k (boundaryRing k R g j) (c (i, e)) * boundaryCoordinate k R g j e

/-- Field-valued avoidance forces the full ideal of original boundary equations to
be the unit ideal. This proves scheme emptiness, not only absence of rational points. -/
theorem boundaryRow_span_eq_top (j : Exponent σ)
    (hj : monomialFunction k R g j ≠ 0) (c : Fin (d + 1) × Exponent σ → k)
    (hc : NoCommonInfinityZero k R g d c) :
    Ideal.span (Set.range (boundaryRow k R g d j c)) = ⊤ := by
  exact ProjectiveEvaluationIncidence.span_rows_eq_top_of_no_field_points
    k (boundaryRing k R g j) (boundaryCoordinate k R g j) (d + 1) c (hc j hj)

/-- The same original homogeneous row, before quotienting by infinity. -/
def chartRow (j : Exponent σ) (c : Fin (d + 1) × Exponent σ → k)
    (i : Fin (d + 1)) : chart k R g j :=
  ∑ e, algebraMap k (chart k R g j) (c (i, e)) *
    ⟨ratio k R g j e, Algebra.subset_adjoin (Or.inl ⟨e, rfl⟩)⟩

theorem chartRow_quotient (j : Exponent σ) (c : Fin (d + 1) × Exponent σ → k)
    (i : Fin (d + 1)) :
    Ideal.Quotient.mk (Ideal.span {infinityCoordinate k R g j})
      (chartRow k R g d j c i) = boundaryRow k R g d j c i := by
  change algebraMap (chart k R g j) (boundaryRing k R g j) _ = _
  simp only [chartRow, boundaryRow, map_sum, map_mul,
    ← IsScalarTower.algebraMap_apply k (chart k R g j) (boundaryRing k R g j)]
  rfl

/-- The full original chart ideal generated by infinity and all homogeneous rows is the
unit ideal. In particular no nilpotent thickening remains at their common zero scheme. -/
theorem chartRow_infinity_span_eq_top (j : Exponent σ)
    (hj : monomialFunction k R g j ≠ 0) (c : Fin (d + 1) × Exponent σ → k)
    (hc : NoCommonInfinityZero k R g d c) :
    Ideal.span (Set.range (chartRow k R g d j c)) ⊔
      Ideal.span {infinityCoordinate k R g j} = ⊤ := by
  let φ := Ideal.Quotient.mk (Ideal.span {infinityCoordinate k R g j})
  have hm : (Ideal.span (Set.range (chartRow k R g d j c))).map φ = ⊤ := by
    rw [Ideal.map_span, ← Set.range_comp]
    have he : φ ∘ chartRow k R g d j c = boundaryRow k R g d j c := by
      funext i
      exact chartRow_quotient k R g d j c i
    rw [he]
    exact boundaryRow_span_eq_top k R g d j hj c hc
  have he := Ideal.comap_map_of_surjective φ (Ideal.Quotient.mk_surjective)
    (Ideal.span (Set.range (chartRow k R g d j c)))
  rw [hm, Ideal.comap_top] at he
  simpa only [φ, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] using he.symm

/-- The native chart's normalized homogeneous row is exactly the original ratio row. -/
theorem nativeChartMapToRatioRing_row (j : Exponent σ)
    (hj : monomialFunction k R g j ≠ 0) (c : Fin (d + 1) × Exponent σ → k)
    (i : Fin (d + 1)) :
    nativeChartMapToRatioRing k R g j hj
      (∑ e, ProjectiveSpace.coordinateRingCoefficient k (Exponent σ) j (c (i, e)) *
        ProjectiveSpace.coordinateRatio k (Exponent σ) j e) =
      chartRow k R g d j c i := by
  apply Subtype.ext
  change nativeDehomogenization k R g j _ = _
  simp [chartRow, nativeDehomogenization_ratio k R g j _ hj]

/-- The actual affine zero scheme of infinity and the original homogeneous rows is empty. -/
theorem isEmpty_chart_infinity_commonZero (j : Exponent σ)
    (hj : monomialFunction k R g j ≠ 0) (c : Fin (d + 1) × Exponent σ → k)
    (hc : NoCommonInfinityZero k R g d c) :
    IsEmpty (Spec (.of (chart k R g j ⧸
      (Ideal.span (Set.range (chartRow k R g d j c)) ⊔
        Ideal.span {infinityCoordinate k R g j}))) : Scheme.{u}) := by
  rw [chartRow_infinity_span_eq_top k R g d j hj c hc]
  change IsEmpty (PrimeSpectrum (chart k R g j ⧸ (⊤ : Ideal (chart k R g j))))
  infer_instance

end QuadraticIncidence.InfinityChart
