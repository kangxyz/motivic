module

public import Aglib.RingTheory.FittingIdeal.Basic
public import Mathlib.RingTheory.Norm.Basic

/-! # The original norm as a zeroth Fitting ideal

The multiplication presentation retains the whole principal quotient. An actual
linear equivalence with a target cyclic quotient then identifies the two ideals.
No reducedness, domain assumption, or geometric quotient identification is supplied.


Intended upstream module: `Aglib.RingTheory.Norm.FiniteFree.Fitting`.
Incoming project consumers:
`Motivic.Aglib.AlgebraicGeometry.Morphisms.Finite.Norm.AffineClosedTriangle`.
-/

@[expose] public noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open scoped Matrix
open Module

universe u v

namespace Matrix

/-- All maximal minors of a square matrix generate its determinant ideal. -/
theorem minorIdeal_fin_self {R : Type u} [CommRing R] {n : ℕ}
    (A : Matrix (Fin n) (Fin n) R) : A.minorIdeal n = Ideal.span {A.det} := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨e, c, rfl⟩
    have hfactor : A.submatrix e c =
        (1 : Matrix (Fin n) (Fin n) R).submatrix e id * A *
          (1 : Matrix (Fin n) (Fin n) R).submatrix id c := by
      calc
        A.submatrix e c = ((1 * A) * 1).submatrix e c := by simp
        _ = _ := by
          rw [Matrix.submatrix_mul _ _ e id c Function.bijective_id,
            Matrix.submatrix_mul _ _ e id id Function.bijective_id]
          rfl
    rw [hfactor, Matrix.det_mul, Matrix.det_mul]
    apply Ideal.mem_span_singleton'.mpr
    refine ⟨((1 : Matrix (Fin n) (Fin n) R).submatrix e id).det *
      ((1 : Matrix (Fin n) (Fin n) R).submatrix id c).det, ?_⟩
    ring
  · apply Ideal.span_le.mpr
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact Ideal.subset_span ⟨id, id, rfl⟩

end Matrix

namespace Algebra

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
  [Module.Finite R S] [Module.Free R S]

/-- The actual principal quotient has zeroth Fitting ideal generated by its norm. -/
theorem fittingIdeal_zero_quotient_span_eq_norm (g : S) :
    Module.fittingIdeal R (S ⧸ Ideal.span {g}) 0 = Ideal.span {norm R g} := by
  nontriviality R
  let b := Module.finBasis R S
  let q : S →ₗ[R] S ⧸ Ideal.span {g} :=
    (Ideal.Quotient.mkₐ R (Ideal.span {g})).toLinearMap
  let f := q.comp b.equivFun.symm.toLinearMap
  have hf : Function.Surjective f :=
    (Ideal.Quotient.mk_surjective).comp b.equivFun.symm.surjective
  let A := Algebra.leftMulMatrix b g
  have hmulrepr (y : S) : A *ᵥ b.equivFun y = b.equivFun (g * y) := by
    simpa only [A, Basis.equivFun_apply] using Algebra.leftMulMatrix_mulVec_repr b g y
  have hA : Submodule.span R (Set.range Aᵀ) = LinearMap.ker f := by
    change Submodule.span R (Set.range A.col) = LinearMap.ker f
    rw [← Matrix.range_mulVecLin]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      change q (b.equivFun.symm (A *ᵥ y)) = 0
      have hmul : b.equivFun.symm (A *ᵥ y) = g * b.equivFun.symm y := by
        apply b.equivFun.injective
        rw [b.equivFun.apply_symm_apply]
        simpa only [b.equivFun.apply_symm_apply] using hmulrepr (b.equivFun.symm y)
      rw [hmul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_span_singleton.mpr ⟨b.equivFun.symm y, rfl⟩)
    · intro hx
      have hx' : b.equivFun.symm x ∈ Ideal.span {g} :=
        Ideal.Quotient.eq_zero_iff_mem.mp hx
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hx'
      refine ⟨b.equivFun y, ?_⟩
      change A *ᵥ b.equivFun y = x
      rw [hmulrepr, ← hy]
      exact b.equivFun.apply_symm_apply x
  rw [Module.fittingIdeal_eq_minorIdeal hf hA, Nat.card_fin, Nat.sub_zero,
    Matrix.minorIdeal_fin_self, ← Algebra.norm_eq_matrix_det b]

/-- An actual target-linear quotient equivalence identifies the original norm ideal.
This is only the algebraic consumer; constructing the geometric graph quotient
and its scalar compatibility is a separate obligation. -/
theorem span_norm_eq_of_quotient_linearEquiv (g : S) (a : R)
    (e : (S ⧸ Ideal.span {g}) ≃ₗ[R] (R ⧸ Ideal.span {a})) :
    Ideal.span {norm R g} = Ideal.span {a} := by
  rw [← fittingIdeal_zero_quotient_span_eq_norm,
    Module.fittingIdeal_congr e, Module.fittingIdeal_zero_quotient]

end Algebra
