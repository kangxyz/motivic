module

public import Motivic.Aglib.RingTheory.MvPolynomial.RegularSequence
public import Mathlib.Algebra.MvPolynomial.Rename
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The diagonal ideal in two sets of polynomial coordinates

The diagonal evaluation identifies the right coordinates with the left ones.
Its kernel is exactly the ideal generated by their differences, and its quotient
is the polynomial ring in one set of coordinates. Translation by the left
coordinates proves that every finite list of distinct coordinate differences
is weakly regular. The coefficient ring is an arbitrary commutative ring.
-/

@[expose] public section

noncomputable section

namespace MvPolynomial.Diagonal

open _root_.MvPolynomial RingTheory.Sequence

variable (R σ : Type*) [CommRing R]

/-- The polynomial ring containing independent left and right coordinates. -/
abbrev Ambient := MvPolynomial (σ ⊕ σ) R

/-- The right coordinate minus the matching left coordinate. -/
def difference (i : σ) : Ambient R σ := X (Sum.inr i) - X (Sum.inl i)

/-- Evaluation on the polynomial diagonal identifies the two coordinate copies. -/
def evaluation : Ambient R σ →ₐ[R] MvPolynomial σ R :=
  rename (Sum.elim id id)

@[simp]
theorem evaluation_X_left (i : σ) : evaluation R σ (X (Sum.inl i)) = X i := by
  simp [evaluation]

@[simp]
theorem evaluation_X_right (i : σ) : evaluation R σ (X (Sum.inr i)) = X i := by
  simp [evaluation]

@[simp]
theorem evaluation_difference (i : σ) : evaluation R σ (difference R σ i) = 0 := by
  simp [difference]

/-- Inclusion of the left coordinates is a section of diagonal evaluation. -/
theorem evaluation_rename_left (p : MvPolynomial σ R) :
    evaluation R σ (rename Sum.inl p) = p := by
  simpa only [evaluation, rename_rename, Function.comp_def, Sum.elim_inl] using
    (rename_id_apply (R := R) p)

/-- Diagonal evaluation is onto, for every coefficient ring. -/
theorem evaluation_surjective : Function.Surjective (evaluation R σ) :=
  fun p => ⟨rename Sum.inl p, evaluation_rename_left R σ p⟩

/-- The actual ideal generated by the coordinate differences. -/
def ideal : Ideal (Ambient R σ) := Ideal.span (Set.range (difference R σ))

/-- All diagonal differences vanish in the diagonal quotient. -/
theorem mk_X_right_eq_left (i : σ) :
    Ideal.Quotient.mk (ideal R σ) (X (Sum.inr i)) =
      Ideal.Quotient.mk (ideal R σ) (X (Sum.inl i)) := by
  rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_range_self i)

/-- Passing to the difference quotient makes diagonal evaluation the identity. -/
theorem mk_rename_left_evaluation (p : Ambient R σ) :
    Ideal.Quotient.mk (ideal R σ) (rename Sum.inl (evaluation R σ p)) =
      Ideal.Quotient.mk (ideal R σ) p := by
  let q := Ideal.Quotient.mkₐ R (ideal R σ)
  have h : (q.comp (rename Sum.inl)).comp (evaluation R σ) = q := by
    ext i
    cases i with
    | inl i => simp [q]
    | inr i => simpa [q] using (mk_X_right_eq_left R σ i).symm
  exact DFunLike.congr_fun h p

/-- The diagonal kernel is precisely the coordinate-difference ideal. -/
theorem ker_evaluation : RingHom.ker (evaluation R σ) = ideal R σ := by
  apply le_antisymm
  · intro p hp
    rw [RingHom.mem_ker] at hp
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← mk_rename_left_evaluation R σ p, hp]
    simp
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact evaluation_difference R σ i

/-- The coordinate-difference quotient is the polynomial ring on the diagonal. -/
def quotientEquiv : (Ambient R σ ⧸ ideal R σ) ≃ₐ[R] MvPolynomial σ R :=
  (Ideal.quotientEquivAlgOfEq R (ker_evaluation R σ).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (evaluation_surjective R σ))

@[simp]
theorem quotientEquiv_mk (p : Ambient R σ) :
    quotientEquiv R σ (Ideal.Quotient.mk (ideal R σ) p) = evaluation R σ p := by
  simp [quotientEquiv]

/-- Translation sends each right variable to its difference from the left one. -/
def translation : Ambient R σ ≃ₐ[R] Ambient R σ :=
  AlgEquiv.ofAlgHom
    (aeval (Sum.elim (fun i => X (Sum.inl i)) (difference R σ)))
    (aeval (Sum.elim (fun i => X (Sum.inl i))
      (fun i => X (Sum.inr i) + X (Sum.inl i))))
    (by ext i; cases i <;> simp [difference])
    (by ext i; cases i <;> simp [difference])

@[simp]
theorem translation_X_left (i : σ) : translation R σ (X (Sum.inl i)) = X (Sum.inl i) :=
  aeval_X _ _

@[simp]
theorem translation_X_right (i : σ) : translation R σ (X (Sum.inr i)) = difference R σ i :=
  aeval_X _ _

/-- Every distinct finite list of diagonal differences is weakly regular. -/
theorem isWeaklyRegular_differences (l : List σ) (hl : l.Nodup) :
    IsWeaklyRegular (Ambient R σ) (l.map (difference R σ)) := by
  have h := isWeaklyRegular_X (R := R) (σ := σ ⊕ σ)
    (l.map Sum.inr) (hl.map Sum.inr_injective)
  let e := (translation R σ).toRingEquiv
  let := RingHomInvPair.of_ringEquiv e
  let := RingHomInvPair.symm (e : Ambient R σ →+* Ambient R σ)
    (e.symm : Ambient R σ →+* Ambient R σ)
  have ht := (e.toSemilinearEquiv.isWeaklyRegular_congr'
    ((l.map Sum.inr).map X)).mp h
  simp only [List.map_map, Function.comp_def] at ht
  change IsWeaklyRegular (Ambient R σ)
    (l.map (fun i => translation R σ (X (Sum.inr i)))) at ht
  simpa only [translation_X_right] using ht

/-- For a nonzero base ring, diagonal differences also satisfy the proper-quotient condition. -/
theorem isRegular_differences [Nontrivial R] (l : List σ) (hl : l.Nodup) :
    RingTheory.Sequence.IsRegular (Ambient R σ) (l.map (difference R σ)) := by
  refine ⟨isWeaklyRegular_differences R σ l hl, ?_⟩
  rw [Ideal.smul_eq_mul, Ideal.mul_top]
  intro h
  have hle : Ideal.ofList (l.map (difference R σ)) ≤ RingHom.ker (evaluation R σ) := by
    apply Ideal.span_le.mpr
    intro p hp
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hp
    exact evaluation_difference R σ i
  exact (RingHom.ker_ne_top (evaluation R σ)) (top_unique (h.le.trans hle))

end MvPolynomial.Diagonal
