module

public import Motivic.Aglib.RingTheory.MvPolynomial.RegularSequence
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Polynomial graph kernels over an arbitrary coefficient ring

Evaluation at any family of coefficients has kernel generated by the literal
coordinates minus those coefficients. Translation of variables proves that a
finite distinct list of these differences is weakly regular, without any
flatness or regularity assumption on the coefficient ring. The quotient is the
original coefficient ring, so a nonzero coefficient ring gives regularity.
This is the polynomial algebra needed for smooth graph transversality; no
smooth-section or correspondence unit theorem is claimed here.
-/

@[expose] public section

noncomputable section

namespace MvPolynomial.Graph

open _root_.MvPolynomial RingTheory.Sequence

variable {R σ : Type*} [CommRing R] (c : σ → R)

/-- The equation of the graph in one polynomial coordinate. -/
def difference (i : σ) : MvPolynomial σ R := X i - C (c i)

/-- Evaluation at the given coefficient family. -/
def evaluation : MvPolynomial σ R →ₐ[R] R := aeval c

@[simp]
theorem evaluation_difference (i : σ) : evaluation c (difference c i) = 0 := by
  simp [evaluation, difference]

/-- Evaluation has the constants as a section. -/
theorem evaluation_surjective : Function.Surjective (evaluation c) :=
  fun r => ⟨C r, by simp [evaluation]⟩

/-- The ideal of all actual graph equations. -/
def ideal : Ideal (MvPolynomial σ R) := Ideal.span (Set.range (difference c))

/-- Every coordinate becomes its prescribed constant in the graph quotient. -/
theorem mk_X_eq_C (i : σ) :
    Ideal.Quotient.mk (ideal c) (X i) = Ideal.Quotient.mk (ideal c) (C (c i)) := by
  rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_range_self i)

/-- Graph evaluation followed by constants is the identity in the graph quotient. -/
theorem mk_C_evaluation (p : MvPolynomial σ R) :
    Ideal.Quotient.mk (ideal c) (C (evaluation c p)) = Ideal.Quotient.mk (ideal c) p := by
  let q := Ideal.Quotient.mkₐ R (ideal c)
  have h : (q.comp (Algebra.ofId R (MvPolynomial σ R))).comp (evaluation c) = q := by
    ext i
    simp only [AlgHom.comp_apply, evaluation, aeval_X, Algebra.ofId_apply]
    change q (algebraMap R (MvPolynomial σ R) (c i)) = q (X i)
    rw [MvPolynomial.algebraMap_eq]
    exact (mk_X_eq_C c i).symm
  exact DFunLike.congr_fun h p

/-- The kernel of the literal evaluation map is precisely the graph ideal. -/
theorem ker_evaluation : RingHom.ker (evaluation c) = ideal c := by
  apply le_antisymm
  · intro p hp
    rw [RingHom.mem_ker] at hp
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← mk_C_evaluation c p, hp]
    simp
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact evaluation_difference c i

/-- The graph quotient is the original coefficient ring. -/
def quotientEquiv : (MvPolynomial σ R ⧸ ideal c) ≃ₐ[R] R :=
  (Ideal.quotientEquivAlgOfEq R (ker_evaluation c).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (evaluation_surjective c))

@[simp]
theorem quotientEquiv_mk (p : MvPolynomial σ R) :
    quotientEquiv c (Ideal.Quotient.mk (ideal c) p) = evaluation c p := by
  simp [quotientEquiv]

/-- Translation by constants is an actual polynomial algebra automorphism. -/
def translation : MvPolynomial σ R ≃ₐ[R] MvPolynomial σ R :=
  AlgEquiv.ofAlgHom (aeval (difference c)) (aeval (fun i => X i + C (c i)))
    (by ext i; simp [difference]) (by ext i; simp [difference])

@[simp]
theorem translation_X (i : σ) : translation c (X i) = difference c i := aeval_X _ _

/-- Arbitrary coefficient values preserve weak regularity of distinct coordinates. -/
theorem isWeaklyRegular_differences (l : List σ) (hl : l.Nodup) :
    IsWeaklyRegular (MvPolynomial σ R) (l.map (difference c)) := by
  have h := isWeaklyRegular_X (R := R) l hl
  let e := (translation c).toRingEquiv
  let := RingHomInvPair.of_ringEquiv e
  let := RingHomInvPair.symm (e : MvPolynomial σ R →+* MvPolynomial σ R)
    (e.symm : MvPolynomial σ R →+* MvPolynomial σ R)
  have ht := (e.toSemilinearEquiv.isWeaklyRegular_congr' (l.map X)).mp h
  simp only [List.map_map, Function.comp_def] at ht
  change IsWeaklyRegular (MvPolynomial σ R) (l.map (fun i => translation c (X i))) at ht
  simpa only [translation_X] using ht

/-- A nonzero coefficient ring makes every distinct list of graph equations regular. -/
theorem isRegular_differences [Nontrivial R] (l : List σ) (hl : l.Nodup) :
    RingTheory.Sequence.IsRegular (MvPolynomial σ R) (l.map (difference c)) := by
  refine ⟨isWeaklyRegular_differences c l hl, ?_⟩
  rw [Ideal.smul_eq_mul, Ideal.mul_top]
  intro h
  have hle : Ideal.ofList (l.map (difference c)) ≤ RingHom.ker (evaluation c) := by
    apply Ideal.span_le.mpr
    intro p hp
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hp
    exact evaluation_difference c i
  exact (RingHom.ker_ne_top (evaluation c)) (top_unique (h.le.trans hle))

/-- A complete coordinate list generates the entire literal evaluation kernel. -/
theorem ker_evaluation_eq_ofList (l : List σ) (hcover : ∀ i, i ∈ l) :
    RingHom.ker (evaluation c) = Ideal.ofList (l.map (difference c)) := by
  rw [ker_evaluation, ideal, Ideal.ofList]
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact List.mem_map.mpr ⟨i, hcover i, rfl⟩
  · intro hx
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
    exact ⟨i, rfl⟩

end MvPolynomial.Graph
