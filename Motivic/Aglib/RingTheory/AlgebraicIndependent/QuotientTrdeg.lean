module
public import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! # Transcendence-degree drop under a quotient containing a regular element

The quotient is not required to be reduced or a domain. Algebraic independence
in the quotient lifts to independence together with any regular kernel element.
-/
@[expose] public noncomputable section

open Algebra Function

universe u v w z

namespace AlgebraicIndependent

/-- A regular element killed by an algebra map is transcendental over the
subalgebra generated by any family whose image is algebraically independent. -/
theorem transcendental_of_comp_of_regular_ker
    {k : Type u} {R : Type v} {S : Type w} {ι : Type z}
    [CommRing k] [CommRing R] [CommRing S] [Algebra k R] [Algebra k S]
    (f : R →ₐ[k] S) {x : ι → R} (hx : AlgebraicIndependent k (f ∘ x))
    {t : R} (ht : t ∈ nonZeroDivisors R) (hft : f t = 0) :
    Transcendental (adjoin k (Set.range x)) t := by
  have hx' : AlgebraicIndependent k x := hx.of_comp f
  have hinj : Injective (fun a : adjoin k (Set.range x) => f a) := by
    intro a b hab
    apply hx'.aevalEquiv.symm.injective
    apply hx
    change MvPolynomial.aeval (f ∘ x) (hx'.repr a) =
      MvPolynomial.aeval (f ∘ x) (hx'.repr b)
    simpa only [comp_def, ← MvPolynomial.comp_aeval_apply, hx'.aeval_repr] using hab
  intro ha
  obtain ⟨a, ha, b, hab⟩ := ha.exists_nonzero_dvd ht
  apply ha
  apply hinj
  change f (algebraMap (adjoin k (Set.range x)) R a) = f 0
  rw [hab, map_mul, hft, zero_mul, map_zero]

/-- Lift an algebraically independent family through an algebra map and append
one regular kernel element, without any reducedness assumption on the target. -/
theorem option_of_comp_of_regular_ker
    {k : Type u} {R : Type v} {S : Type w} {ι : Type z}
    [CommRing k] [CommRing R] [CommRing S] [Algebra k R] [Algebra k S]
    (f : R →ₐ[k] S) {x : ι → R} (hx : AlgebraicIndependent k (f ∘ x))
    {t : R} (ht : t ∈ nonZeroDivisors R) (hft : f t = 0) :
    AlgebraicIndependent k (fun o : Option ι => o.elim t x) :=
  (hx.of_comp f).option_iff_transcendental t |>.mpr
    (hx.transcendental_of_comp_of_regular_ker f ht hft)

end AlgebraicIndependent

namespace Ideal

/-- A quotient by an ideal containing a regular element has one fewer possible
algebraically independent parameters. No reducedness or finite-type hypothesis
is required. -/
theorem trdeg_quotient_le_of_regular_mem
    {k R : Type u} [CommRing k] [Nontrivial k] [CommRing R] [Algebra k R]
    (I : Ideal R) {t : R} (ht : t ∈ nonZeroDivisors R) (htI : t ∈ I)
    {d : Cardinal.{u}} (hd : Algebra.trdeg k R ≤ d + 1) :
    Algebra.trdeg k (R ⧸ I) ≤ d := by
  classical
  rw [Algebra.trdeg]
  refine ciSup_le' fun s => ?_
  let f := Ideal.Quotient.mkₐ k I
  let x : s.1 → R := fun a => invFun f a
  have hfx : f ∘ x = fun a : s.1 => (a : R ⧸ I) := by
    funext a
    exact invFun_eq (Ideal.Quotient.mkₐ_surjective k I a)
  have hx : AlgebraicIndependent k (f ∘ x) := by
    rw [hfx]
    exact s.2
  have hi := hx.option_of_comp_of_regular_ker f ht
    (Ideal.Quotient.eq_zero_iff_mem.mpr htI)
  have hcard := hi.cardinalMk_le_trdeg.trans hd
  simpa only [Cardinal.mk_option, Cardinal.add_one_le_add_one_iff] using hcard

/-- A nonzero ideal in a domain decreases a finite bound on the actual native
transcendence degree, even if the quotient has nilpotents. -/
theorem trdeg_quotient_le_of_ne_bot
    {k R : Type u} [Field k] [CommRing R] [IsDomain R] [Algebra k R]
    (I : Ideal R) (hI : I ≠ ⊥) {d : ℕ}
    (hd : Algebra.trdeg k R ≤ (d : Cardinal.{u}) + 1) :
    Algebra.trdeg k (R ⧸ I) ≤ d := by
  obtain ⟨t, htI, ht⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  exact I.trdeg_quotient_le_of_regular_mem (mem_nonZeroDivisors_of_ne_zero ht) htI hd

end Ideal
