module

public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse

/-! # Transcendence-degree bounds from linear relations

The actual transcendence degree of a finitely generated algebra is bounded by
its generators' linear span. Independent homogeneous linear relations therefore
lower the bound, without assuming any transcendence-degree estimate as input.
-/

@[expose] public noncomputable section

open Module
open scoped BigOperators

universe u v w

namespace Algebra

variable {F E : Type u} [Field F] [CommRing E] [Algebra F E]

/-- The algebra generated by a finite-dimensional linear subspace has
transcendence degree at most the dimension of that subspace. -/
theorem trdeg_adjoin_submodule_le_finrank (V : Submodule F E)
    [FiniteDimensional F V] :
    trdeg F (adjoin F (V : Set E)) ≤ (finrank F V : Cardinal.{u}) := by
  classical
  let b := Module.finBasis F V
  let x : Fin (finrank F V) → E := fun i => b i
  have hx : Submodule.span F (Set.range x) = V := by
    calc
      Submodule.span F (Set.range x) =
          (Submodule.span F (Set.range b)).map V.subtype := by
        rw [Submodule.map_span, ← Set.range_comp]
        rfl
      _ = V := by rw [b.span_eq, Submodule.map_top, V.range_subtype]
  have ha : adjoin F (Set.range x) = adjoin F (V : Set E) := by
    exact (adjoin_span (R := F) (s := Set.range x)).symm.trans
      (congrArg (fun P : Submodule F E => adjoin F (P : Set E)) hx)
  let f : MvPolynomial (Fin (finrank F V)) F →ₐ[F] E := MvPolynomial.aeval x
  have hf : f.range = adjoin F (V : Set E) := by
    rw [MvPolynomial.aeval_range]
    exact ha
  have h := trdeg_le_of_surjective f.rangeRestrict f.rangeRestrict_surjective
  rw [hf] at h
  simpa only [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin,
    Cardinal.lift_natCast] using h

/-- Rank-nullity gives the intrinsic bound: the transcendence degree plus the
dimension of all linear relations is no greater than the number of generators. -/
theorem trdeg_adjoin_add_finrank_ker_linearCombination_le
    {N : Type v} [Fintype N] (x : N → E) :
    trdeg F (adjoin F (Set.range x)) +
      (finrank F (LinearMap.ker (Fintype.linearCombination F x)) : Cardinal.{u}) ≤
        Fintype.card N := by
  let e := Fintype.linearCombination F x
  have h : trdeg F (adjoin F (Set.range x)) ≤
      (finrank F (LinearMap.range e) : Cardinal.{u}) := by
    have ha : adjoin F (LinearMap.range e : Set E) = adjoin F (Set.range x) := by
      rw [show LinearMap.range e = Submodule.span F (Set.range x) from
        Fintype.range_linearCombination F x, adjoin_span]
    rw [← ha]
    exact trdeg_adjoin_submodule_le_finrank (LinearMap.range e)
  have hr := e.finrank_range_add_finrank_ker
  rw [Module.finrank_pi] at hr
  calc
    _ ≤ (finrank F (LinearMap.range e) : Cardinal.{u}) +
        (finrank F (LinearMap.ker e) : Cardinal.{u}) := add_le_add h le_rfl
    _ = Fintype.card N := by rw [← Nat.cast_add, hr]

/-- An injective family of linear relations reduces the transcendence-degree
bound by its dimension. The relations map into the actual evaluation kernel. -/
theorem trdeg_adjoin_add_card_le_of_injective_linear_relations
    {N : Type v} {Q : Type w} [Fintype N] [Fintype Q] (x : N → E)
    (r : (Q → F) →ₗ[F] (N → F)) (hr : Function.Injective r)
    (hrel : ∀ c, Fintype.linearCombination F x (r c) = 0) :
    trdeg F (adjoin F (Set.range x)) + (Fintype.card Q : Cardinal.{u}) ≤
      Fintype.card N := by
  let rk : (Q → F) →ₗ[F] LinearMap.ker (Fintype.linearCombination F x) :=
    r.codRestrict _ hrel
  have hri : Function.Injective rk := fun a b h => hr (congrArg Subtype.val h)
  have hdim := LinearMap.finrank_le_finrank_of_injective hri
  rw [Module.finrank_pi] at hdim
  exact (add_le_add le_rfl (Nat.cast_le.mpr hdim)).trans
    (trdeg_adjoin_add_finrank_ker_linearCombination_le x)

/-- Full row rank over the base field supplies independent relations even when
the coordinates lie in an arbitrary commutative algebra over that field. -/
theorem trdeg_adjoin_add_card_le_of_surjective_matrix
    {N : Type v} {Q : Type w} [Fintype N] [Fintype Q]
    (A : Matrix Q N F) (hA : Function.Surjective A.mulVec) (x : N → E)
    (hx : (A.map (algebraMap F E)).mulVec x = 0) :
    trdeg F (adjoin F (Set.range x)) + (Fintype.card Q : Cardinal.{u}) ≤
      Fintype.card N := by
  classical
  obtain ⟨B, hAB⟩ := Matrix.mulVec_surjective_iff_exists_right_inverse.mp hA
  apply trdeg_adjoin_add_card_le_of_injective_linear_relations x A.vecMulLinear
  · intro c d h
    have h' := congrArg (fun v => Matrix.vecMul v B) h
    simpa only [Matrix.vecMulLinear_apply, Matrix.vecMul_vecMul, hAB,
      Matrix.vecMul_one] using h'
  · intro c
    calc
      Fintype.linearCombination F x (A.vecMulLinear c) =
          dotProduct (Matrix.vecMul (algebraMap F E ∘ c) (A.map (algebraMap F E))) x := by
        simp only [Fintype.linearCombination_apply, Matrix.vecMulLinear_apply,
          Algebra.smul_def, RingHom.map_vecMul, dotProduct]
      _ = dotProduct (algebraMap F E ∘ c) ((A.map (algebraMap F E)).mulVec x) :=
        (Matrix.dotProduct_mulVec _ _ _).symm
      _ = 0 := by rw [hx, dotProduct_zero]

end Algebra
