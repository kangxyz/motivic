module
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-! # The canonical coefficient field inside an incidence component

This is the field generated by the image of the original coefficient algebra,
not a supplied intermediate field. Its source image and fraction-ring structure
are retained for the moving-point dimension calculation.
-/
@[expose] public noncomputable section
namespace IncidenceCoefficientField
universe u
variable (k A E : Type u) [Field k] [CommRing A] [Field E]
  [Algebra k A] [Algebra k E] [Algebra A E] [IsScalarTower k A E]

/-- The actual image of the original coefficient algebra. -/
def image : Subalgebra k E := (IsScalarTower.toAlgHom k A E).range

/-- The smallest field containing that unchanged image. -/
def field : IntermediateField k E := IntermediateField.adjoin k (image k A E : Set E)

/-- The literal coefficient map into its generated field. -/
def lift : A →ₐ[k] field k A E :=
  (IsScalarTower.toAlgHom k A E).codRestrict (field k A E).toSubalgebra
    (fun a => IntermediateField.subset_adjoin k _ ⟨a, rfl⟩)

/-- Use locally to retain the canonical, rather than a chosen, coefficient action. -/
abbrev algebra : Algebra A (field k A E) := (lift k A E).toRingHom.toAlgebra

attribute [local instance] algebra

@[simp]
theorem lift_coe (a : A) : (lift k A E a : E) = algebraMap A E a := rfl

instance tower_ground : IsScalarTower k A (field k A E) :=
  IsScalarTower.of_algebraMap_eq' (lift k A E).comp_algebraMap.symm

instance tower_target : IsScalarTower A (field k A E) E :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

/-- The original image embeds canonically into its field closure. -/
abbrev imageAlgebra : Algebra (image k A E) (field k A E) :=
  (Subalgebra.inclusion (show image k A E ≤ (field k A E).toSubalgebra from
    IntermediateField.subset_adjoin k _)).toAlgebra

attribute [local instance] imageAlgebra

instance image_tower_ground : IsScalarTower k (image k A E) (field k A E) :=
  Subalgebra.inclusion.isScalarTower_left
    (show image k A E ≤ (field k A E).toSubalgebra from
      IntermediateField.subset_adjoin k _) _

instance image_tower_target : IsScalarTower (image k A E) (field k A E) E :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

@[simp]
theorem image_algebraMap_coe (x : image k A E) :
    (algebraMap (image k A E) (field k A E) x : E) = x := rfl

/-- The canonical coefficient field is precisely a fraction field of the image. -/
instance fractionRing : IsFractionRing (image k A E) (field k A E) := by
  have : FaithfulSMul (image k A E) (field k A E) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr
      (fun a b h => Subtype.ext
        (congrArg (fun z : field k A E => (z : E)) h))
  apply IsFractionRing.of_field
  rintro ⟨x, hx⟩
  obtain ⟨a, ha, b, hb, he⟩ := IntermediateField.mem_adjoin_iff_div.mp hx
  rw [Algebra.adjoin_eq] at ha hb
  exact ⟨⟨a, ha⟩, ⟨b, hb⟩, Subtype.ext he⟩

/-- The coefficient-image map is genuinely surjective. -/
def imageMap : A →ₐ[k] image k A E := (IsScalarTower.toAlgHom k A E).rangeRestrict

theorem imageMap_surjective : Function.Surjective (imageMap k A E) :=
  (IsScalarTower.toAlgHom k A E).rangeRestrict_surjective

end IncidenceCoefficientField
