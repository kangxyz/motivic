module
public import Motivic.Aglib.RingTheory.Bertini.QuadraticIncidenceAlgebra
public import Motivic.Aglib.RingTheory.AlgebraicIndependent.QuotientTrdeg
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.RingTheory.Localization.FractionRing

/-! # Actual monomial-ratio rings for the same quadratic projective charts

These rings use the unchanged original quadratic monomials. Killing the actual
infinity coordinate lowers transcendence degree, even for nonreduced quotients.
-/
@[expose] public noncomputable section
open _root_.MvPolynomial
universe u
namespace QuadraticIncidence.InfinityChart
variable (k R : Type u) [Field k] [CommRing R] [IsDomain R] [Algebra k R]
  {σ : Type u}

/-- The unchanged quadratic monomial function on the original affine scheme. -/
def monomialFunction (g : σ → R) (e : Exponent σ) : R :=
  aeval g (monomial e.val (1 : k))

/-- The homogeneous chart coordinates, interpreted in the original fraction field. -/
def ratio (g : σ → R) (j e : Exponent σ) : FractionRing R :=
  algebraMap R (FractionRing R) (monomialFunction k R g e) /
    algebraMap R (FractionRing R) (monomialFunction k R g j)

/-- The constant monomial is the original homogenizing coordinate. -/
def constantIndex : Exponent σ := ⟨0, by simp⟩

omit [IsDomain R] in
@[simp]
theorem monomialFunction_constant (g : σ → R) :
    monomialFunction k R g (constantIndex (σ := σ)) = 1 := by
  simp [monomialFunction, constantIndex]

/-- The homogenizing ratio is literally the inverse of the original chart function. -/
theorem ratio_constant (g : σ → R) (j : Exponent σ) :
    ratio k R g j (constantIndex (σ := σ)) =
      (algebraMap R (FractionRing R) (monomialFunction k R g j))⁻¹ := by
  simp [ratio]

/-- The pivot coordinate is one on its actual nonempty chart. -/
theorem ratio_self (g : σ → R) (j : Exponent σ)
    (hj : monomialFunction k R g j ≠ 0) : ratio k R g j j = 1 := by
  apply div_self
  simpa using (IsFractionRing.injective R (FractionRing R)).ne hj

/-- The literal ring generated by the original monomial ratios and infinity coordinate. -/
def chart (g : σ → R) (j : Exponent σ) : Subalgebra k (FractionRing R) :=
  Algebra.adjoin k (Set.range (ratio k R g j) ∪
    { (algebraMap R (FractionRing R) (monomialFunction k R g j))⁻¹ })

/-- No extra generator has been added to the projective chart. -/
theorem chart_eq_adjoin_ratios (g : σ → R) (j : Exponent σ) :
    chart k R g j = Algebra.adjoin k (Set.range (ratio k R g j)) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro x (hx | hx)
    · exact Algebra.subset_adjoin hx
    · rw [Set.mem_singleton_iff] at hx
      subst x
      exact Algebra.subset_adjoin ⟨constantIndex, ratio_constant k R g j⟩
  · exact Algebra.adjoin_mono Set.subset_union_left

instance [Finite σ] (g : σ → R) (j : Exponent σ) :
    Algebra.FiniteType k (chart k R g j) := by
  rw [chart_eq_adjoin_ratios]
  exact Algebra.FiniteType.adjoin_of_finite (Set.finite_range _)

/-- The actual coordinate vanishing at infinity in this chart. -/
def infinityCoordinate (g : σ → R) (j : Exponent σ) : chart k R g j :=
  ⟨_, Algebra.subset_adjoin (Or.inr (Set.mem_singleton _))⟩

/-- A nonempty original chart has a nonzero infinity coordinate in its domain ring. -/
theorem infinityCoordinate_ne_zero (g : σ → R) (j : Exponent σ)
    (hj : monomialFunction k R g j ≠ 0) : infinityCoordinate k R g j ≠ 0 := by
  intro h
  have hz := congrArg (fun a : chart k R g j => (a : FractionRing R)) h
  have hf : algebraMap R (FractionRing R) (monomialFunction k R g j) ≠ 0 :=
    by simpa using (IsFractionRing.injective R (FractionRing R)).ne hj
  exact (inv_ne_zero hf) hz

/-- The chart lies in the unchanged original function field. -/
theorem trdeg_chart_le (g : σ → R) (j : Exponent σ) :
    Algebra.trdeg k (chart k R g j) ≤ Algebra.trdeg k R := by
  have : Algebra.IsAlgebraic R (FractionRing R) :=
    IsLocalization.isAlgebraic (FractionRing R) (nonZeroDivisors R)
  have he : Algebra.trdeg k (FractionRing R) = Algebra.trdeg k R := by
    simpa only [trdeg_eq_zero, add_zero] using
      (trdeg_add_eq k R (A := FractionRing R)).symm
  rw [← he]
  exact trdeg_le_of_injective (chart k R g j).val Subtype.val_injective

/-- Every actual closed subscheme at infinity has the required one-dimension drop;
no reduction or prime quotient is substituted for that subscheme. -/
theorem trdeg_infinity_quotient_le (g : σ → R) (j : Exponent σ)
    (hj : monomialFunction k R g j ≠ 0) (I : Ideal (chart k R g j))
    (hI : infinityCoordinate k R g j ∈ I) {d : ℕ}
    (hd : Algebra.trdeg k R ≤ (d : Cardinal.{u}) + 1) :
    Algebra.trdeg k ((chart k R g j) ⧸ I) ≤ d := by
  exact I.trdeg_quotient_le_of_regular_mem
    (mem_nonZeroDivisors_of_ne_zero (infinityCoordinate_ne_zero k R g j hj)) hI
    ((trdeg_chart_le k R g j).trans hd)

end QuadraticIncidence.InfinityChart
