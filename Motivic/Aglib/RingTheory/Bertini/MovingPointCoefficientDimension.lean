module
public import Motivic.Aglib.RingTheory.Bertini.IncidenceCoefficientField
public import Motivic.Aglib.RingTheory.Bertini.NormalizedMovingPointEvaluation
public import Motivic.Aglib.RingTheory.AlgebraicIndependent.PolynomialQuotientFractionTrdeg

/-! # The actual moving-point coefficient field has at most `2d` parameters

Finite closed-point coefficient extensions, normalization of one weight, and
localization off the diagonal are all included. The coefficient algebra may be
nonreduced or reducible; no geometric-integrality assumption is introduced.
-/
@[expose] public noncomputable section
namespace QuadraticIncidence.MovingPointChart
universe u
variable (k R B : Type u) [Field k] [CommRing R] [IsDomain R] [CommRing B]
  [Algebra k R] [Algebra k B] [Algebra R B] [IsScalarTower k R B]
  [Module.Finite R B] (d : ℕ) (i₀ : Fin d) (t : B)
  (E : Type u) [Field E] [Algebra k E] [Algebra (Ring B d i₀ t) E]
  [IsScalarTower k (Ring B d i₀ t) E]

/-- This bounds the canonical field generated by the actual chart image, rather
than assuming a suitable intermediate field or a dimension bound for it. -/
theorem trdeg_coefficientField_le :
    Algebra.trdeg k (IncidenceCoefficientField.field k (Ring B d i₀ t) E) ≤
      Algebra.trdeg k R + (d - 1 : ℕ) := by
  let A := Ring B d i₀ t
  let K := IncidenceCoefficientField.field k A E
  let := IncidenceCoefficientField.imageAlgebra k A E
  have h := AlgHom.trdeg_fractionRing_le_of_finite_localized_mvPolynomial_surjective
    (R := R) (K := K) (MvPolynomial.C t : PolynomialRing B d i₀)
    (IncidenceCoefficientField.imageMap k A E)
    (IncidenceCoefficientField.imageMap_surjective k A E)
  simpa only [card_weightIndex] using h

/-- For an original `(d+1)`-dimensional affine variety, the entire normalized
moving-point coefficient field has at most `2d` parameters. -/
theorem trdeg_coefficientField_le_twice
    (hd : Algebra.trdeg k R = (d + 1 : ℕ)) :
    Algebra.trdeg k (IncidenceCoefficientField.field k (Ring B d i₀ t) E) ≤
      (2 * d : ℕ) := by
  have h := trdeg_coefficientField_le k R B d i₀ t E
  rw [hd, ← Nat.cast_add] at h
  have hp : 0 < d := lt_of_le_of_lt (Nat.zero_le _) i₀.isLt
  have he : d + 1 + (d - 1) = 2 * d := by omega
  simpa only [he] using h

end QuadraticIncidence.MovingPointChart
