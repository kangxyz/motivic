module

public import Motivic.Algebra.Homology.KoszulScalarRestriction
public import Motivic.Algebra.Homology.TorComparison.RegularQuotientBalance
public import Motivic.Algebra.Homology.TorComparison.Balanced
public import Motivic.Algebra.Homology.TorComparison.AmbientLength

/-!
# Eliminating one actual regular leading Koszul block

A surjection whose kernel is generated by a weakly regular list removes that
leading block from the actual Koszul homology. Every remaining equation is
mapped by the original surjection, and every homological degree is retained.
No flatness of the quotient map or regularity of the remaining list is assumed.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.MonoidalCategory

universe u

namespace Motivic.Koszul

variable {R S : Type u} [CommRing R] [CommRing S]

set_option backward.isDefEq.respectTransparency false in
/-- The literal kernel presentation identifies the quotient with the actual
restricted target-ring module. -/
def regularBlockQuotientIso (f : R →+* S) (hf : Function.Surjective f)
    (t : List R) (hker : RingHom.ker f = Ideal.ofList t) :
    ModuleCat.of R (R ⧸ Ideal.ofList t) ≅
      (ModuleCat.restrictScalars f).obj (ModuleCat.of S S) := by
  let := f.toAlgebra
  let μ : R →ₐ[R] S := Algebra.ofId R S
  have hμ : Function.Surjective μ := hf
  have hk : Ideal.ofList t = RingHom.ker μ := hker.symm
  exact ((Ideal.quotientEquivAlgOfEq R hk).trans
    (Ideal.quotientKerAlgEquivOfSurjective hμ)).toLinearEquiv.toModuleIso

/-- The quotient-module comparison is induced by the specified surjection. -/
@[simp]
theorem regularBlockQuotientIso_mk (f : R →+* S) (hf : Function.Surjective f)
    (t : List R) (hker : RingHom.ker f = Ideal.ofList t) (r : R) :
    (regularBlockQuotientIso f hf t hker).hom (Ideal.Quotient.mk (Ideal.ofList t) r) =
      f r := rfl

/-- Regular-block elimination identifies actual homology, with the original
source-ring action on the restricted target homology. -/
def regularBlockHomologyIso (f : R →+* S) (hf : Function.Surjective f)
    (t s : List R) (hker : RingHom.ker f = Ideal.ofList t)
    (ht : RingTheory.Sequence.IsWeaklyRegular R t) (n : ℕ) :
    (coefficientComplex (ModuleCat.of R R) (t ++ s)).homology n ≅
      (ModuleCat.restrictScalars f).obj
        ((coefficientComplex (ModuleCat.of S S) (s.map f)).homology n) := by
  have : QuasiIso (idealAugmentation t) := idealAugmentation_quasiIso_of_weaklyRegular t ht
  let H := HomologicalComplex.homologyFunctor (ModuleCat R) (ComplexShape.down ℕ) n
  exact H.mapIso (eqToIso (coefficientComplex_ring (t ++ s)) ≪≫
      appendIso t s ≪≫ TorComparison.tensorTotalSymmetryIso (chainComplex t) (chainComplex s)) ≪≫
    tensorHomologyIso (idealAugmentation t) s n ≪≫
    H.mapIso ((TorComparison.coefficientComplexTensorIso
      (ModuleCat.of R (R ⧸ Ideal.ofList t)) s).symm ≪≫
        coefficientIso (regularBlockQuotientIso f hf t hker) s) ≪≫
    coefficientRestrictHomologyIso f (ModuleCat.of S S) s n

/-- The all-degree extended-natural length identity eliminates only the
proved regular block and keeps the same remaining list and actual scalars. -/
theorem regularBlockHomology_length (f : R →+* S) (hf : Function.Surjective f)
    (t s : List R) (hker : RingHom.ker f = Ideal.ofList t)
    (ht : RingTheory.Sequence.IsWeaklyRegular R t) (n : ℕ) :
    Module.length R ((coefficientComplex (ModuleCat.of R R) (t ++ s)).homology n) =
      Module.length S ((coefficientComplex (ModuleCat.of S S) (s.map f)).homology n) :=
  (regularBlockHomologyIso f hf t s hker ht n).toLinearEquiv.length_eq.trans
    (TorComparison.length_restrictScalars_of_surjective f hf _)

end Motivic.Koszul
