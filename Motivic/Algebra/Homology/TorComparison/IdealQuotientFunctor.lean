module

public import Motivic.Algebra.Homology.KoszulCoefficientRegularity
public import Mathlib.LinearAlgebra.TensorProduct.Quotient

/-!
# Actual ideal quotients as tensor coefficient functors

Quotienting modules by the action of an ideal is an additive functor, naturally
isomorphic to tensoring with the actual quotient ring. Its finite-list recursion
agrees with the literal scalar-range quotient functor. These are ordinary
module isomorphisms with proved naturality, used to identify the target of the
regular-Koszul resolution augmentation.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.MonoidalCategory
open Motivic.Koszul
open scoped Pointwise TensorProduct

universe u

namespace Motivic.TorComparison

variable {R : Type u} [CommRing R]

/-- Quotient a module by the actual submodule generated by an ideal action. -/
def idealQuotientFunctor (I : Ideal R) : ModuleCat.{u} R ⥤ ModuleCat R where
  obj M := ModuleCat.of R (M ⧸ (I • (⊤ : Submodule R M)))
  map f := ModuleCat.ofHom (Submodule.mapQ _ _ f.hom
    (Submodule.smul_top_le_comap_smul_top I f.hom))
  map_id M := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction x using Submodule.Quotient.induction_on with
    | _ x => rfl
  map_comp f g := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction x using Submodule.Quotient.induction_on with
    | _ x => rfl

instance idealQuotientFunctor_additive (I : Ideal R) : (idealQuotientFunctor I).Additive where
  map_add {_ _ f g} := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction x using Submodule.Quotient.induction_on with
    | _ x => rfl

/-- Ideal quotient is naturally the actual quotient-ring tensor functor. -/
def idealQuotientFunctorIsoTensor (I : Ideal R) :
    idealQuotientFunctor I ≅ (tensoringLeft (ModuleCat R)).obj (ModuleCat.of R (R ⧸ I)) :=
  NatIso.ofComponents (fun M => (TensorProduct.quotTensorEquivQuotSMul M I).symm.toModuleIso)
    (by
      intro M N f
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      induction x using Submodule.Quotient.induction_on with
      | _ x =>
        change (TensorProduct.quotTensorEquivQuotSMul N I).symm
            (Submodule.Quotient.mk (f x)) =
          (𝟙 (ModuleCat.of R (R ⧸ I)) ⊗ₘ f)
            ((TensorProduct.quotTensorEquivQuotSMul M I).symm (Submodule.Quotient.mk x))
        simp only [TensorProduct.quotTensorEquivQuotSMul_symm_mk]
        rfl)

/-- Successive quotient by one scalar and by a list equals quotient by the
actual ideal generated by their concatenation. -/
def idealQuotientFunctorConsIso (a : R) (s : List R) :
    idealQuotientFunctor (Ideal.ofList (a :: s)) ≅
      scalarQuotientFunctor a ⋙ idealQuotientFunctor (Ideal.ofList s) :=
  NatIso.ofComponents (fun M =>
    (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner M a s).toModuleIso ≪≫
      (idealQuotientFunctor (Ideal.ofList s)).mapIso
        (singleQuotientEquivQuotSMulTop M a).toModuleIso.symm) (by
    intro M N f
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction x using Submodule.Quotient.induction_on with
    | _ x => rfl)

/-- Quotient by the ideal generated by the empty list is naturally the identity. -/
def idealQuotientFunctorNilIso : idealQuotientFunctor (Ideal.ofList ([] : List R)) ≅
    𝟭 (ModuleCat.{u} R) :=
  NatIso.ofComponents (fun M =>
    (Submodule.quotEquivOfEqBot (Ideal.ofList [] • (⊤ : Submodule R M)) (by simp)).toModuleIso)
    (by
      intro M N f
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      induction x using Submodule.Quotient.induction_on with
      | _ x => rfl)

/-- The actual succession of scalar quotient functors in list order. -/
def iteratedQuotientFunctor : List R → ModuleCat.{u} R ⥤ ModuleCat R
  | [] => 𝟭 _
  | a :: s => scalarQuotientFunctor a ⋙ iteratedQuotientFunctor s

instance iteratedQuotientFunctor_additive (s : List R) : (iteratedQuotientFunctor s).Additive := by
  induction s with
  | nil => exact inferInstanceAs (Functor.Additive (𝟭 (ModuleCat R)))
  | cons a s ih => exact inferInstanceAs
      (Functor.Additive (scalarQuotientFunctor a ⋙ iteratedQuotientFunctor s))

/-- All intermediate scalar quotients combine to the actual generated-ideal quotient. -/
def iteratedQuotientFunctorIso : (s : List R) →
    iteratedQuotientFunctor s ≅ idealQuotientFunctor (Ideal.ofList s)
  | [] => idealQuotientFunctorNilIso.symm
  | a :: s => Functor.isoWhiskerLeft (scalarQuotientFunctor a) (iteratedQuotientFunctorIso s) ≪≫
      (idealQuotientFunctorConsIso a s).symm

end Motivic.TorComparison
