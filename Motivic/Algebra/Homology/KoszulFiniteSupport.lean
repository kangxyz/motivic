module

public import Motivic.Algebra.Homology.KoszulCoefficientFiniteness
public import Motivic.Algebra.Homology.KoszulScalarHomotopy
public import Mathlib.Algebra.Homology.BifunctorHomotopy
public import Mathlib.Algebra.Homology.ShortComplex.Linear
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Support of arbitrary finite Koszul homology

Each defining equation acts by a genuine chain map homotopic to zero on the
actual coefficient Koszul complex. The homotopies are constructed from the
one-element identity contraction and transported through the tensor recursion.
Consequently the ideal generated by the entire list, together with the
coefficient annihilator, annihilates every actual homology module. Neither the
ring nor the coefficient module is required to satisfy any regularity condition.
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory

namespace Motivic.Koszul

variable {R : Type u} [CommRing R]

/-- A scalar map homotopic to zero acts as zero on actual homology. -/
theorem mem_annihilator_homology_of_scalar_homotopy
    (K : ChainComplex (ModuleCat R) ℕ) (a : R) (h : Homotopy (a • 𝟙 K) 0) (n : ℕ) :
    a ∈ Module.annihilator R (K.homology n) := by
  have hs : HomologicalComplex.homologyMap (a • 𝟙 K) n = a • 𝟙 (K.homology n) := by
    change ShortComplex.homologyMap (a • 𝟙 (K.sc n)) = _
    rw [ShortComplex.homologyMap_smul, ShortComplex.homologyMap_id]
    rfl
  have hz : a • 𝟙 (K.homology n) = 0 := by
    simpa only [hs, HomologicalComplex.homologyMap_zero] using h.homologyMap_eq n
  exact Module.mem_annihilator.mpr (fun x => ConcreteCategory.congr_hom hz x)

/-- Tensoring a zero map in the first factor gives the zero chain map. -/
theorem tensorHom_zero_left (K L : ChainComplex (ModuleCat R) ℕ) :
    HomologicalComplex.tensorHom (0 : K ⟶ K) (𝟙 L) = 0 := by
  simpa only [zero_smul] using tensorHom_scalar_left K L (0 : R)

/-- Tensoring a zero map in the second factor gives the zero chain map. -/
theorem tensorHom_zero_right (K L : ChainComplex (ModuleCat R) ℕ) :
    HomologicalComplex.tensorHom (𝟙 K) (0 : L ⟶ L) = 0 := by
  simpa only [zero_smul] using tensorHom_scalar_right K L (0 : R)

/-- Every member of the defining list acts null-homotopically on the actual
finite coefficient complex. This construction does not assume regularity. -/
noncomputable def coefficientScalarHomotopy (M : ModuleCat R) (s : List R)
    (a : R) (ha : a ∈ s) : Homotopy (a • 𝟙 (coefficientComplex M s)) 0 := by
  classical
  induction s with
  | nil => simp only [List.not_mem_nil] at ha
  | cons b s ih =>
    by_cases hab : a = b
    · subst b
      exact (Homotopy.ofEq (tensorHom_scalar_left
        (singleComplex R a) (coefficientComplex M s) a).symm).trans
        ((HomologicalComplex.mapBifunctorMapHomotopy₁ (singleScalarHomotopy R a)
          (𝟙 (coefficientComplex M s)) (curriedTensor (ModuleCat R)) (ComplexShape.down ℕ)).trans
          (Homotopy.ofEq (tensorHom_zero_left (singleComplex R a) (coefficientComplex M s))))
    · have ha : a ∈ s := (List.mem_cons.mp ha).resolve_left hab
      exact (Homotopy.ofEq (tensorHom_scalar_right
        (singleComplex R b) (coefficientComplex M s) a).symm).trans
        ((HomologicalComplex.mapBifunctorMapHomotopy₂ (𝟙 (singleComplex R b)) (ih ha)
          (curriedTensor (ModuleCat R)) (ComplexShape.down ℕ)).trans
          (Homotopy.ofEq (tensorHom_zero_right (singleComplex R b) (coefficientComplex M s))))

/-- Every defining equation annihilates every actual finite Koszul homology module. -/
theorem mem_annihilator_coefficient_homology (M : ModuleCat R) (s : List R)
    (a : R) (ha : a ∈ s) (n : ℕ) :
    a ∈ Module.annihilator R ((coefficientComplex M s).homology n) :=
  mem_annihilator_homology_of_scalar_homotopy (coefficientComplex M s) a
    (coefficientScalarHomotopy M s a ha) n

/-- The entire defining ideal annihilates the actual finite Koszul homology. -/
theorem ofList_le_annihilator_coefficient_homology (M : ModuleCat R) (s : List R) (n : ℕ) :
    Ideal.ofList s ≤ Module.annihilator R ((coefficientComplex M s).homology n) :=
  Ideal.span_le.mpr (fun a ha => mem_annihilator_coefficient_homology M s a ha n)

/-- The equations and coefficient annihilator jointly annihilate actual Koszul homology. -/
theorem support_le_annihilator_coefficient_homology (M : ModuleCat R) (s : List R) (n : ℕ) :
    Ideal.ofList s ⊔ Module.annihilator R M ≤
      Module.annihilator R ((coefficientComplex M s).homology n) :=
  sup_le (ofList_le_annihilator_coefficient_homology M s n)
    (coefficient_annihilator_le_annihilator_homology M s n)

end Motivic.Koszul
