module

public import Motivic.AlgebraicGeometry.Diagonal.StalkTransport
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth

/-!
# Regular kernels of actual smooth diagonal stalks

A standard-smooth affine chart admits étale polynomial coordinates. Their
explicit regular diagonal list transfers through the actual open chart maps
and the induced open immersion of self-products. Consequently every stalk of
the diagonal of a smooth scheme morphism has a kernel generated by a regular
sequence. The base scheme is arbitrary and no separatedness or regularity of
coefficient modules is assumed.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open RingTheory.Sequence

universe u

namespace Motivic.AffineDiagonal

/-- Standard-smooth affine coordinates give an actual regular diagonal stalk kernel. -/
theorem exists_regular_kernel_of_isStandardSmooth
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    (hf : (algebraMap R S).IsStandardSmooth) (p : PrimeSpectrum S) :
    ∃ rs : List ((product R S).presheaf.stalk (diagonal R S p)),
      IsRegular ((product R S).presheaf.stalk (diagonal R S p)) rs ∧
        RingHom.ker ((diagonal R S).stalkMap p).hom = Ideal.ofList rs := by
  obtain ⟨n, g, hcomp, hg⟩ := hf.exists_etale_mvPolynomial
  let := g.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin n) R) S :=
    IsScalarTower.of_algebraMap_eq' hcomp.symm
  have : Algebra.Etale (MvPolynomial (Fin n) R) S := hg
  exact ⟨_, etale_stalkPresentation R (Fin n) S p (List.finRange n)
    (List.nodup_finRange n) List.mem_finRange⟩

end Motivic.AffineDiagonal

namespace Motivic.Diagonal

/-- Every actual diagonal stalk of a smooth morphism has a regular-list kernel. -/
theorem exists_regular_kernel_of_smooth {X Y : Scheme.{u}} (f : X ⟶ Y) [Smooth f]
    (x : X) :
    ∃ rs : List ((pullback f f).presheaf.stalk (pullback.diagonal f x)),
      IsRegular ((pullback f f).presheaf.stalk (pullback.diagonal f x)) rs ∧
        RingHom.ker ((pullback.diagonal f).stalkMap x).hom = Ideal.ofList rs := by
  obtain ⟨U, hU, V, hV, hx, hVU, hf⟩ := Smooth.exists_isStandardSmooth f x
  obtain ⟨p, hp⟩ : x ∈ Set.range hV.fromSpec := by
    rw [hV.range_fromSpec]
    exact hx
  let := (f.appLE U V hVU).hom.toAlgebra
  have hlocal := AffineDiagonal.exists_regular_kernel_of_isStandardSmooth
    Γ(Y, U) Γ(X, V) hf p
  have e := arrowStalkIsoOfOpenChart f (Spec.map (f.appLE U V hVU))
    hV.fromSpec hU.fromSpec (IsAffineOpen.SpecMap_appLE_fromSpec f hU hV hVU) p
  have hglobal := exists_regular_kernel_of_arrowIso e.symm hlocal
  exact exists_regular_kernel_of_arrowIso
    ((pullback.diagonal f).arrowStalkMapIsoOfEq hp) hglobal

end Motivic.Diagonal
