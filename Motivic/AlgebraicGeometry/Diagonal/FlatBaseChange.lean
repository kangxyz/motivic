module

public import Motivic.AlgebraicGeometry.Diagonal.Smooth
public import Motivic.AlgebraicGeometry.Correspondences.IntersectionAmbientIdeal
public import Motivic.RingTheory.RegularSequence.FlatKernel
public import Motivic.AlgebraicGeometry.IdealSheaf.StalkKernel
public import Motivic.AlgebraicGeometry.IdealSheaf.StalkPullback

/-!
# Flat base change of actual regular stalk equations

The literal stalk map of a flat base-change morphism carries regular equations
into the kernel of the base-changed morphism. The pullback square supplies the
point identification and the commuting square of actual stalk homomorphisms.
Properness follows from containment in the kernel of the actual source stalk,
which is nonzero. The proved ideal-sheaf stalk calculus identifies the entire
base-changed kernel with the ideal generated by these literal images. Applied
to the smooth middle diagonal this gives the actual triple-product inclusion
a regular kernel. No regularity is asserted for arbitrary support coefficients.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open RingTheory.Sequence

universe u

namespace Motivic.Diagonal

variable {W D Q P : Scheme.{u}} {a : W ⟶ D} {b : W ⟶ Q} {i : D ⟶ P} {q : Q ⟶ P}

/-- The point identification supplied by an actual Cartesian square. -/
def baseChangeStalkIso (sq : IsPullback a b i q) (z : W) :
    P.presheaf.stalk (i (a z)) ≅ P.presheaf.stalk (q (b z)) :=
  P.presheaf.stalkCongr (.of_eq (congrArg (fun k : W ⟶ P => k z) sq.w))

/-- The literal base-change stalk map, after its canonical point identification. -/
def baseChangeStalkMap (sq : IsPullback a b i q) (z : W) :
    P.presheaf.stalk (i (a z)) ⟶ Q.presheaf.stalk (b z) :=
  (baseChangeStalkIso sq z).hom ≫ q.stalkMap (b z)

set_option backward.isDefEq.respectTransparency false in
/-- The actual stalk square commutes, including the required point identification. -/
@[reassoc]
theorem baseChangeStalkMap_comp (sq : IsPullback a b i q) (z : W) :
    baseChangeStalkMap sq z ≫ b.stalkMap z = i.stalkMap (a z) ≫ a.stalkMap z := by
  simp only [baseChangeStalkMap, baseChangeStalkIso, Category.assoc,
    ← Scheme.Hom.stalkMap_comp]
  exact (Scheme.Hom.stalkMap_congr_hom _ _ sq.w z).symm

/-- The actual base-change stalk homomorphism is flat when the scheme morphism is flat. -/
theorem baseChangeStalkMap_flat [Flat q] (sq : IsPullback a b i q) (z : W) :
    (baseChangeStalkMap sq z).hom.Flat :=
  (RingHom.Flat.of_bijective
    (baseChangeStalkIso sq z).commRingCatIsoToRingEquiv.bijective).comp (Flat.stalkMap q (b z))

/-- Images of the original equations lie in the literal base-changed stalk kernel. -/
theorem mapped_equations_le_kernel (sq : IsPullback a b i q) (z : W)
    {rs : List (P.presheaf.stalk (i (a z)))}
    (hker : Ideal.ofList rs ≤ RingHom.ker (i.stalkMap (a z)).hom) :
    Ideal.ofList (rs.map (baseChangeStalkMap sq z).hom) ≤ RingHom.ker (b.stalkMap z).hom := by
  apply RegularSequence.map_ofList_le_ker_of_commSq
    (i.stalkMap (a z)).hom (baseChangeStalkMap sq z).hom
    (a.stalkMap z).hom (b.stalkMap z).hom _ hker
  exact congrArg CommRingCat.Hom.hom (baseChangeStalkMap_comp sq z)

/-- Flatness preserves weak regularity without any extra assumption on the equations. -/
theorem mapped_equations_isWeaklyRegular [Flat q] (sq : IsPullback a b i q) (z : W)
    {rs : List (P.presheaf.stalk (i (a z)))}
    (hrs : IsWeaklyRegular (P.presheaf.stalk (i (a z))) rs) :
    IsWeaklyRegular (Q.presheaf.stalk (b z)) (rs.map (baseChangeStalkMap sq z).hom) :=
  RegularSequence.isWeaklyRegular_map_of_flat
    (baseChangeStalkMap sq z).hom (baseChangeStalkMap_flat sq z) hrs

/-- The actual nonzero source stalk proves properness of the mapped equation ideal. -/
theorem mapped_equations_ne_top (sq : IsPullback a b i q) (z : W)
    {rs : List (P.presheaf.stalk (i (a z)))}
    (hker : Ideal.ofList rs ≤ RingHom.ker (i.stalkMap (a z)).hom) :
    Ideal.ofList (rs.map (baseChangeStalkMap sq z).hom) ≠ ⊤ :=
  ne_top_of_le_ne_top (RingHom.ker_ne_top (b.stalkMap z).hom)
    (mapped_equations_le_kernel sq z hker)

/-- Flatness preserves the regular equations as a literal proper image list. -/
theorem mapped_equations_isRegular [Flat q] (sq : IsPullback a b i q) (z : W)
    {rs : List (P.presheaf.stalk (i (a z)))} (hrs : IsWeaklyRegular (P.presheaf.stalk (i (a z))) rs)
    (hker : Ideal.ofList rs ≤ RingHom.ker (i.stalkMap (a z)).hom) :
    IsRegular (Q.presheaf.stalk (b z)) (rs.map (baseChangeStalkMap sq z).hom) :=
  RegularSequence.isRegular_map_of_flat_of_le_ker
    (baseChangeStalkMap sq z).hom (b.stalkMap z).hom (baseChangeStalkMap_flat sq z) hrs
    (mapped_equations_le_kernel sq z hker)

/-- Closed-immersion base change extends the literal kernel of the actual stalk map. -/
theorem baseChange_stalk_kernel [IsClosedImmersion i]
    (sq : IsPullback a b i q) (z : W) :
    RingHom.ker (b.stalkMap z).hom =
      (RingHom.ker (i.stalkMap (a z)).hom).map (baseChangeStalkMap sq z).hom := by
  have : IsClosedImmersion b :=
    MorphismProperty.of_isPullback sq (inferInstanceAs (IsClosedImmersion i))
  calc
    RingHom.ker (b.stalkMap z).hom = b.ker.stalk (b z) := (b.ker_stalk z).symm
    _ = (i.ker.comap q).stalk (b z) :=
      congrArg (fun I : Q.IdealSheafData => I.stalk (b z))
        (ker_eq_comap_of_isPullback b a q i sq.flip)
    _ = (i.ker.stalk (q (b z))).map (q.stalkMap (b z)).hom :=
      i.ker.stalk_comap q (b z)
    _ = (RingHom.ker (i.stalkMap (a z)).hom).map (baseChangeStalkMap sq z).hom := by
      rw [← i.ker_stalk (a z)]
      change _ = (i.ker.stalk (i (a z))).map
        ((q.stalkMap (b z)).hom.comp (baseChangeStalkIso sq z).hom.hom)
      rw [← Ideal.map_map]
      congr 1
      exact (i.ker.stalk_congr (congrArg (fun k : W ⟶ P => k z) sq.w)).symm

/-- The literal images generate the entire base-changed kernel and form a regular list. -/
theorem mapped_equations_regular_kernel [IsClosedImmersion i] [Flat q]
    (sq : IsPullback a b i q) (z : W)
    {rs : List (P.presheaf.stalk (i (a z)))}
    (hrs : IsRegular (P.presheaf.stalk (i (a z))) rs)
    (hker : RingHom.ker (i.stalkMap (a z)).hom = Ideal.ofList rs) :
    IsRegular (Q.presheaf.stalk (b z)) (rs.map (baseChangeStalkMap sq z).hom) ∧
      RingHom.ker (b.stalkMap z).hom =
        Ideal.ofList (rs.map (baseChangeStalkMap sq z).hom) := by
  refine ⟨mapped_equations_isRegular sq z hrs.toIsWeaklyRegular hker.ge, ?_⟩
  rw [baseChange_stalk_kernel sq z, hker, Ideal.map_ofList]

/-- A genuine regular stalk-kernel list survives flat Cartesian base change. -/
theorem exists_regular_kernel_of_flat_isPullback [IsClosedImmersion i] [Flat q]
    (sq : IsPullback a b i q) (z : W)
    (hregular : ∃ rs : List (P.presheaf.stalk (i (a z))),
      IsRegular (P.presheaf.stalk (i (a z))) rs ∧
        RingHom.ker (i.stalkMap (a z)).hom = Ideal.ofList rs) :
    ∃ rs : List (Q.presheaf.stalk (b z)),
      IsRegular (Q.presheaf.stalk (b z)) rs ∧
        RingHom.ker (b.stalkMap z).hom = Ideal.ofList rs := by
  obtain ⟨rs, hrs, hker⟩ := hregular
  exact ⟨rs.map (baseChangeStalkMap sq z).hom,
    mapped_equations_regular_kernel sq z hrs hker⟩

end Motivic.Diagonal

namespace Motivic

/-- The actual triple inclusion has a regular kernel by flat base change of the smooth middle
scheme diagonal. No regularity condition is imposed on a correspondence support. -/
theorem exists_regular_kernel_correspondenceTripleInclusion {S X Y Z : Scheme.{u}}
    (f : X ⟶ S) (g : Y ⟶ S) (h : Z ⟶ S)
    [Flat f] [Smooth g] [IsSeparated g] [Flat h] (x : correspondenceTripleProduct f g h) :
    ∃ rs : List ((correspondenceIntersectionAmbient f g h).presheaf.stalk
      (correspondenceTripleInclusion f g h x)),
      IsRegular ((correspondenceIntersectionAmbient f g h).presheaf.stalk
        (correspondenceTripleInclusion f g h x)) rs ∧
          RingHom.ker ((correspondenceTripleInclusion f g h).stalkMap x).hom = Ideal.ofList rs :=
  Diagonal.exists_regular_kernel_of_flat_isPullback
    (correspondenceTriple_isPullback f g h) x
    (Diagonal.exists_regular_kernel_of_smooth g (correspondenceTripleMiddle f g h x))

end Motivic
