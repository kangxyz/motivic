module

public import Motivic.AlgebraicGeometry.Correspondences.NisnevichSignedLocalLift
public import Motivic.AlgebraicGeometry.Correspondences.FiniteCoproducts
public import Motivic.AlgebraicGeometry.SmoothSiteNisnevich

/-!
# The Nisnevich topology on actual finite correspondences

A sieve is covering exactly when it contains the graph of a genuine singleton
Nisnevich cover. Finite disjoint unions and signed local lifting prove stability
under arbitrary correspondences. In particular the topology has a basis of
principal covering sieves. Covering families are totalized before passing to
ordinary sieves: the sieve generated by their individual graph legs would not
in general contain sums of correspondences through different legs.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Motivic.Cor

variable (k : Type u) [Field k]

/-- A genuine singleton Nisnevich cover of smooth schemes, with actual residue fields. -/
def IsNisnevichCover {X Y : SmoothSite (Spec (.of k))} (q : Y ⟶ X) : Prop :=
  Etale q.left ∧ ∀ x : X.left, ∃ y : Y.left,
    q.left y = x ∧ IsIso (q.left.residueFieldMap y)

/-- Identity maps are genuine singleton Nisnevich covers, including on the empty scheme. -/
theorem isNisnevichCover_id (X : SmoothSite (Spec (.of k))) :
    IsNisnevichCover k (𝟙 X) := by
  refine ⟨?_, fun x => ⟨x, rfl, ?_⟩⟩
  · change Etale (𝟙 X.left)
    infer_instance
  · change IsIso ((𝟙 X.left : X.left ⟶ X.left).residueFieldMap x)
    infer_instance

set_option backward.isDefEq.respectTransparency false in
/-- Composing two genuine singleton covers preserves the residue-field lifting condition. -/
theorem IsNisnevichCover.comp {X Y Z : SmoothSite (Spec (.of k))}
    {q : Y ⟶ X} {r : Z ⟶ Y} (hr : IsNisnevichCover k r)
    (hq : IsNisnevichCover k q) : IsNisnevichCover k (r ≫ q) := by
  let : Etale r.left := hr.1
  let : Etale q.left := hq.1
  refine ⟨?_, fun x => ?_⟩
  · change Etale (r.left ≫ q.left)
    infer_instance
  · obtain ⟨y, hy, hry⟩ := hq.2 x
    obtain ⟨z, hz, hrz⟩ := hr.2 y
    refine ⟨z, ?_, ?_⟩
    · change q.left (r.left z) = x
      rw [hz, hy]
    · change IsIso ((r.left ≫ q.left).residueFieldMap z)
      rw [Scheme.residueFieldMap_comp]
      have : IsIso (q.left.residueFieldMap (r.left z)) := by rw [hz]; exact hry
      have : IsIso (r.left.residueFieldMap z) := hrz
      infer_instance

/-- The explicit cover predicate agrees with the ordinary singleton Nisnevich precoverage. -/
theorem isNisnevichCover_iff_singleton_mem {X Y : SmoothSite (Spec (.of k))}
    (q : Y ⟶ X) : IsNisnevichCover k q ↔
      Presieve.singleton q ∈ SmoothSite.nisnevichPrecoverage (Spec (.of k)) X := by
  rw [← Presieve.ofArrows_of_unique (fun _ : Unit => q)]
  rw [SmoothSite.ofArrows_mem_nisnevichPrecoverage_iff]
  simp only [IsNisnevichCover]
  constructor
  · rintro ⟨he, hl⟩
    exact ⟨fun _ => he, fun x => by obtain ⟨y, hy, hr⟩ := hl x; exact ⟨Unit.unit, y, hy, hr⟩⟩
  · rintro ⟨he, hl⟩
    exact ⟨he Unit.unit, fun x => by obtain ⟨_, y, hy, hr⟩ := hl x; exact ⟨y, hy, hr⟩⟩

set_option backward.isDefEq.respectTransparency false in
/-- Pointwise genuine correspondence factorizations glue after one actual singleton cover.
This also applies to Čech boundary arrows, not only to graphs. -/
theorem exists_nisnevich_cover_of_pointwise_factorization
    {X Y V : SmoothSite (Spec (.of k))}
    (α : Cor.mk X ⟶ Cor.mk Y) (δ : Cor.mk V ⟶ Cor.mk Y)
    (h : ∀ x : X.left, ∃ (U : SmoothSite (Spec (.of k))) (g : U ⟶ X),
      Etale g.left ∧ ∃ u : U.left, g.left u = x ∧ IsIso (g.left.residueFieldMap u) ∧
      ∃ β : Cor.mk U ⟶ Cor.mk V, β ≫ δ = (graphFunctor k).map g ≫ α) :
    ∃ (U : SmoothSite (Spec (.of k))) (g : U ⟶ X), IsNisnevichCover k g ∧
      ∃ β : Cor.mk U ⟶ Cor.mk V, β ≫ δ = (graphFunctor k).map g ≫ α := by
  classical
  choose W g hg w hw hr β hβ using h
  let (x : X.left) : Etale (g x).left := hg x
  let N := SmoothSite.normalizeFiniteNisnevichCover g
    (fun x => ⟨x, w x, hw x, hr x⟩)
  refine ⟨N.total, N.map, ⟨inferInstance, N.residueFieldLifting⟩,
    finiteCoproductDesc k (fun i => β (N.index i)), ?_⟩
  apply finiteCoproductDesc_comp_eq k
  intro i
  rw [← Category.assoc, ← Functor.map_comp, N.inclusion_map]
  exact hβ (N.index i)

/-- An arbitrary signed correspondence lifts through a genuine singleton Nisnevich
cover after one genuine singleton cover of its source. -/
theorem exists_nisnevich_cover_graph_factorization
    {X Y V : SmoothSite (Spec (.of k))}
    (α : Cor.mk X ⟶ Cor.mk Y) (q : V ⟶ Y) (hq : IsNisnevichCover k q) :
    ∃ (U : SmoothSite (Spec (.of k))) (g : U ⟶ X), IsNisnevichCover k g ∧
      ∃ β : Cor.mk U ⟶ Cor.mk V,
        β ≫ (graphFunctor k).map q = (graphFunctor k).map g ≫ α := by
  let : Etale q.left := hq.1
  exact exists_nisnevich_cover_of_pointwise_factorization k α ((graphFunctor k).map q)
    (FiniteCorrespondence.exists_nisnevich_graph_factorization k α q hq.2)

/-- The genuine Nisnevich topology on `Cor`: covering sieves contain a graph of an
actual singleton Nisnevich cover. The graphs are not assumed full. -/
def nisnevichTopology : GrothendieckTopology (Cor k) where
  sieves X := {R | ∃ (U : SmoothSite (Spec (.of k))) (q : U ⟶ X.toSmoothSite),
    IsNisnevichCover k q ∧ R ((graphFunctor k).map q)}
  top_mem' X := ⟨X.toSmoothSite, 𝟙 _, isNisnevichCover_id k _, by trivial⟩
  pullback_stable' {X Y} {R} α hR := by
    obtain ⟨V, q, hq, hRq⟩ := hR
    obtain ⟨U, g, hg, β, hβ⟩ := exists_nisnevich_cover_graph_factorization k α q hq
    refine ⟨U, g, hg, ?_⟩
    change R ((graphFunctor k).map g ≫ α)
    rw [← hβ]
    exact R.downward_closed hRq β
  transitive' {X} {R} hR T hT := by
    obtain ⟨U, q, hq, hRq⟩ := hR
    obtain ⟨V, r, hr, hTr⟩ := hT hRq
    refine ⟨V, r ≫ q, hr.comp k hq, ?_⟩
    rw [Functor.map_comp]
    exact hTr

/-- The exact covering-sieve criterion retains étaleness and actual residue-field isomorphisms. -/
theorem mem_nisnevichTopology_iff {X : Cor k} {R : Sieve X} :
    R ∈ nisnevichTopology k X ↔
      ∃ (U : SmoothSite (Spec (.of k))) (q : U ⟶ X.toSmoothSite),
        IsNisnevichCover k q ∧ R ((graphFunctor k).map q) := Iff.rfl

/-- The principal sieve generated by the graph of a genuine singleton cover is covering. -/
theorem graph_cover_mem_nisnevichTopology {X U : SmoothSite (Spec (.of k))}
    (q : U ⟶ X) (hq : IsNisnevichCover k q) :
    Sieve.generate (Presieve.singleton ((graphFunctor k).map q)) ∈
      nisnevichTopology k (Cor.mk X) :=
  ⟨U, q, hq, ⟨_, 𝟙 _, _, Presieve.singleton_self _, Category.id_comp _⟩⟩

/-- Every covering sieve contains a covering principal sieve. This is the exact
hypothesis needed for additivity of ordinary sheafification in source arrows. -/
theorem principal_covering_basis (X : Cor k) (R : Sieve X)
    (hR : R ∈ nisnevichTopology k X) :
    ∃ (Y : Cor k) (q : Y ⟶ X), R q ∧
      Sieve.generate (Presieve.singleton q) ∈ nisnevichTopology k X := by
  obtain ⟨U, q, hq, hRq⟩ := hR
  exact ⟨Cor.mk U, (graphFunctor k).map q, hRq,
    graph_cover_mem_nisnevichTopology k q hq⟩

/-- A covering `Cor` sieve restricts to an ordinary Nisnevich covering sieve.
This assertion alone does not claim unrestricted continuity for ordinary presheaves. -/
theorem graph_functorPullback_mem_nisnevichTopology
    {X : SmoothSite (Spec (.of k))} {R : Sieve (Cor.mk X)}
    (hR : R ∈ nisnevichTopology k (Cor.mk X)) :
    R.functorPullback (graphFunctor k) ∈ SmoothSite.nisnevichTopology (Spec (.of k)) X := by
  obtain ⟨U, q, hq, hRq⟩ := hR
  apply SmoothSite.mem_nisnevichTopology_iff.mpr
  refine ⟨Presieve.singleton q, (isNisnevichCover_iff_singleton_mem k q).mp hq, ?_⟩
  rw [Presieve.singleton_le_iff]
  exact hRq

end Motivic.Cor
