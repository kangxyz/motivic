module

public import Motivic.AlgebraicGeometry.Correspondences.Composition.Associativity.Diagonal.RightIntermediateLists
public import Motivic.Aglib.AlgebraicGeometry.Stalk.Generic.Support
public import Motivic.Aglib.Algebra.Homology.Koszul.FiniteSupport.Euler

/-!
# Actual right remaining-Y-diagonal support at generic triple-incidence points

The remaining middle diagonal cuts out the full triple incidence inside the
actual right-first-stage support. Its literal stalk kernel is generated by the
images of the original middle equations. Consequently it annihilates every
remaining Koszul homology module, for arbitrary coefficients with the actual
first-stage stalk action. At a genuine generic triple-incidence point, finite
generation and this geometric support imply finite length. Neither finite
length nor a support containment is assumed as an input.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Motivic.FiniteCorrespondenceGenerator
open _root_.AlgebraicGeometry.Scheme

variable {S X Y Z W : Scheme.{u}}
  {f : X ⟶ S} {g : Y ⟶ S} {h : Z ⟶ S} {i : W ⟶ S}
  (F : FiniteCorrespondenceGenerator f g) (G : FiniteCorrespondenceGenerator g h)
  (H : FiniteCorrespondenceGenerator h i)

variable [IsSeparated g] (w : F.tripleIncidence G H)
  (s : List ((pullback g g).presheaf.stalk
    (F.rightSupportMiddlePair G H (F.tripleIncidenceToRightSupportProduct G H w))))
  (hker : (pullback.diagonal g).ker.stalk
      (F.rightSupportMiddlePair G H (F.tripleIncidenceToRightSupportProduct G H w)) =
    Ideal.ofList s)

include hker in
/-- The original middle equations generate the exact remaining-incidence
stalk kernel after the actual first-stage middle stalk map. -/
theorem rightRemainingDiagonal_stalkKernel :
    RingHom.ker ((F.tripleIncidenceToRightSupportProduct G H).stalkMap w).hom =
      Ideal.ofList (s.map ((F.rightSupportMiddlePair G H).stalkMap
        (F.tripleIncidenceToRightSupportProduct G H w)).hom) := by
  rw [← (F.tripleIncidenceToRightSupportProduct G H).ker_stalk w,
    F.rightRemainingDiagonal_kernel G H, Scheme.IdealSheafData.stalk_comap,
    hker, Ideal.map_ofList]

include hker in
/-- The full actual remaining-incidence ideal annihilates all remaining
Koszul homology degrees for the original first-stage module action. -/
theorem rightRemainingKoszul_kernel_annihilator
    (M : ModuleCat.{u} ((F.rightIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToRightSupportProduct G H w))) (n : ℕ) :
    RingHom.ker ((F.tripleIncidenceToRightSupportProduct G H).stalkMap w).hom ≤
      Module.annihilator _
        ((_root_.ChainComplex.Koszul.coefficientComplex M (s.map ((F.rightSupportMiddlePair G
            H).stalkMap
          (F.tripleIncidenceToRightSupportProduct G H w)).hom)).homology n) := by
  rw [F.rightRemainingDiagonal_stalkKernel G H w s hker]
  exact _root_.ChainComplex.Koszul.ofList_le_annihilator_coefficient_homology M _ n

include hker in
/-- At a genuine generic point of the final incidence, every remaining Koszul
homology degree has finite length, with its actual first-stage stalk scalars. -/
theorem rightRemainingKoszul_length_ne_top
    [IsLocallyNoetherian (F.rightIntermediateSupportProduct G H)]
    (hw : w ∈ genericPoints (F.tripleIncidence G H))
    (M : ModuleCat.{u} ((F.rightIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToRightSupportProduct G H w)))
    [Module.Finite ((F.rightIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToRightSupportProduct G H w)) M] (n : ℕ) :
    Module.length ((F.rightIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToRightSupportProduct G H w))
      ((_root_.ChainComplex.Koszul.coefficientComplex M (s.map ((F.rightSupportMiddlePair G
          H).stalkMap
        (F.tripleIncidenceToRightSupportProduct G H w)).hom)).homology n) ≠ ⊤ := by
  have hclosed : IsClosedImmersion (F.tripleIncidenceToRightSupportProduct G H) := inferInstance
  have hfinite := (IsClosedImmersion.iff_isFinite_and_mono
    (F.tripleIncidenceToRightSupportProduct G H)).mp hclosed
  have : LocallyOfFiniteType (F.tripleIncidenceToRightSupportProduct G H) :=
    ((IsFinite.iff_isIntegralHom_and_locallyOfFiniteType _).mp hfinite.1).2
  have := LocallyOfFiniteType.isLocallyNoetherian
    (F.tripleIncidenceToRightSupportProduct G H)
  exact length_ne_top_of_generic_stalk_support
    (F.tripleIncidenceToRightSupportProduct G H) w hw _
    (F.rightRemainingKoszul_kernel_annihilator G H w s hker M n)

include hker in
/-- Genuine final-incidence genericity gives finite length and the actual
list-length degree bound, without any coefficient regularity assumption. -/
theorem rightRemainingKoszul_finiteHomology
    [IsLocallyNoetherian (F.rightIntermediateSupportProduct G H)]
    (hw : w ∈ genericPoints (F.tripleIncidence G H))
    (M : ModuleCat.{u} ((F.rightIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToRightSupportProduct G H w)))
    [Module.Finite ((F.rightIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToRightSupportProduct G H w)) M] :
    _root_.HomologicalComplex.ModuleLengthEuler.FiniteHomology
      (_root_.ChainComplex.Koszul.coefficientComplex M (s.map ((F.rightSupportMiddlePair G
          H).stalkMap
        (F.tripleIncidenceToRightSupportProduct G H w)).hom)) where
  finite_length := F.rightRemainingKoszul_length_ne_top G H w s hker hw M
  finite_support := (Finset.range ((s.map ((F.rightSupportMiddlePair G H).stalkMap
    (F.tripleIncidenceToRightSupportProduct G H w)).hom).length + 1)).finite_toSet.subset
      (_root_.ChainComplex.Koszul.coefficient_homology_length_support_subset M _)

end Motivic.FiniteCorrespondenceGenerator
