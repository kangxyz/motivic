module

public import Motivic.AlgebraicGeometry.Correspondences.Composition.Associativity.Diagonal.IntermediateLists
public import Motivic.Aglib.AlgebraicGeometry.Stalk.Generic.Support
public import Motivic.Aglib.Algebra.Homology.Koszul.FiniteSupport.Euler

/-!
# Actual remaining-diagonal support at generic triple-incidence points

The remaining middle diagonal cuts out the full triple incidence inside the
actual first-stage support. Its literal stalk kernel is generated by the
images of the original middle equations. Consequently it annihilates every
remaining Koszul homology module, for arbitrary coefficients with the actual
first-stage stalk action. At a genuine generic triple-incidence point, finite
generation and this geometric support imply finite length. Neither finite
length nor a support containment is assumed as an input.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Motivic.FiniteCorrespondenceGenerator
open _root_.AlgebraicGeometry.Scheme _root_.AlgebraicGeometry.Scheme.Hom

variable {S X Y Z W : Scheme.{u}}
  {f : X ⟶ S} {g : Y ⟶ S} {h : Z ⟶ S} {i : W ⟶ S}
  (F : FiniteCorrespondenceGenerator f g) (G : FiniteCorrespondenceGenerator g h)
  (H : FiniteCorrespondenceGenerator h i)

/-- The actual triple incidence is the pullback of the original remaining
middle diagonal, including the entire scheme structure. -/
theorem remainingDiagonal_isPullback :
    IsPullback (F.tripleIncidenceFst G H ≫ F.incidenceTarget G)
      (F.tripleIncidenceToLeftSupportProduct G H)
      (pullback.diagonal h) (F.leftSupportMiddlePair G H) :=
  pullback_map_diagonal_isPullback (F.incidenceTarget G) H.projection h

/-- The literal remaining-incidence ideal is the pullback of the original
middle diagonal ideal, without taking radicals. -/
theorem remainingDiagonal_kernel [IsSeparated h] :
    (F.tripleIncidenceToLeftSupportProduct G H).ker =
      (pullback.diagonal h).ker.comap (F.leftSupportMiddlePair G H) :=
  ker_eq_comap_of_isPullback _ _ _ _ (F.remainingDiagonal_isPullback G H).flip

variable [IsSeparated h] (w : F.tripleIncidence G H)
  (s : List ((pullback h h).presheaf.stalk
    (F.leftSupportMiddlePair G H (F.tripleIncidenceToLeftSupportProduct G H w))))
  (hker : (pullback.diagonal h).ker.stalk
      (F.leftSupportMiddlePair G H (F.tripleIncidenceToLeftSupportProduct G H w)) =
    Ideal.ofList s)

include hker in
/-- The original middle equations generate the exact remaining-incidence
stalk kernel after the actual first-stage middle stalk map. -/
theorem remainingDiagonal_stalkKernel :
    RingHom.ker ((F.tripleIncidenceToLeftSupportProduct G H).stalkMap w).hom =
      Ideal.ofList (s.map ((F.leftSupportMiddlePair G H).stalkMap
        (F.tripleIncidenceToLeftSupportProduct G H w)).hom) := by
  rw [← (F.tripleIncidenceToLeftSupportProduct G H).ker_stalk w,
    F.remainingDiagonal_kernel G H, Scheme.IdealSheafData.stalk_comap,
    hker, Ideal.map_ofList]

include hker in
/-- The full actual remaining-incidence ideal annihilates all remaining
Koszul homology degrees for the original first-stage module action. -/
theorem remainingKoszul_kernel_annihilator
    (M : ModuleCat.{u} ((F.leftIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToLeftSupportProduct G H w))) (n : ℕ) :
    RingHom.ker ((F.tripleIncidenceToLeftSupportProduct G H).stalkMap w).hom ≤
      Module.annihilator _
        ((_root_.ChainComplex.Koszul.coefficientComplex M (s.map ((F.leftSupportMiddlePair G
            H).stalkMap
          (F.tripleIncidenceToLeftSupportProduct G H w)).hom)).homology n) := by
  rw [F.remainingDiagonal_stalkKernel G H w s hker]
  exact _root_.ChainComplex.Koszul.ofList_le_annihilator_coefficient_homology M _ n

include hker in
/-- At a genuine generic point of the final incidence, every remaining Koszul
homology degree has finite length, with its actual first-stage stalk scalars. -/
theorem remainingKoszul_length_ne_top
    [IsLocallyNoetherian (F.leftIntermediateSupportProduct G H)]
    (hw : w ∈ genericPoints (F.tripleIncidence G H))
    (M : ModuleCat.{u} ((F.leftIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToLeftSupportProduct G H w)))
    [Module.Finite ((F.leftIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToLeftSupportProduct G H w)) M] (n : ℕ) :
    Module.length ((F.leftIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToLeftSupportProduct G H w))
      ((_root_.ChainComplex.Koszul.coefficientComplex M (s.map ((F.leftSupportMiddlePair G
          H).stalkMap
        (F.tripleIncidenceToLeftSupportProduct G H w)).hom)).homology n) ≠ ⊤ := by
  have hclosed : IsClosedImmersion (F.tripleIncidenceToLeftSupportProduct G H) := inferInstance
  have hfinite := (IsClosedImmersion.iff_isFinite_and_mono
    (F.tripleIncidenceToLeftSupportProduct G H)).mp hclosed
  have : LocallyOfFiniteType (F.tripleIncidenceToLeftSupportProduct G H) :=
    ((IsFinite.iff_isIntegralHom_and_locallyOfFiniteType _).mp hfinite.1).2
  have := LocallyOfFiniteType.isLocallyNoetherian
    (F.tripleIncidenceToLeftSupportProduct G H)
  exact length_ne_top_of_generic_stalk_support
    (F.tripleIncidenceToLeftSupportProduct G H) w hw _
    (F.remainingKoszul_kernel_annihilator G H w s hker M n)

include hker in
/-- Genuine final-incidence genericity gives finite length and the actual
list-length degree bound, without any coefficient regularity assumption. -/
theorem remainingKoszul_finiteHomology
    [IsLocallyNoetherian (F.leftIntermediateSupportProduct G H)]
    (hw : w ∈ genericPoints (F.tripleIncidence G H))
    (M : ModuleCat.{u} ((F.leftIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToLeftSupportProduct G H w)))
    [Module.Finite ((F.leftIntermediateSupportProduct G H).presheaf.stalk
      (F.tripleIncidenceToLeftSupportProduct G H w)) M] :
    _root_.HomologicalComplex.ModuleLengthEuler.FiniteHomology
      (_root_.ChainComplex.Koszul.coefficientComplex M (s.map ((F.leftSupportMiddlePair G
          H).stalkMap
        (F.tripleIncidenceToLeftSupportProduct G H w)).hom)) where
  finite_length := F.remainingKoszul_length_ne_top G H w s hker hw M
  finite_support := (Finset.range ((s.map ((F.leftSupportMiddlePair G H).stalkMap
    (F.tripleIncidenceToLeftSupportProduct G H w)).hom).length + 1)).finite_toSet.subset
      (_root_.ChainComplex.Koszul.coefficient_homology_length_support_subset M _)

end Motivic.FiniteCorrespondenceGenerator
