module

public import Motivic.AlgebraicGeometry.SmoothSiteNisnevichPullbacks
public import Motivic.AlgebraicGeometry.Sites.Nisnevich
public import Mathlib.CategoryTheory.Sites.Over

/-!
# The Nisnevich topology on the smooth site

A family of smooth separated finite-type schemes is covering exactly when
its underlying scheme maps form a Nisnevich family. Cover-specific étale
pullbacks give base-change stability and a genuine generated Grothendieck
topology without asserting arbitrary pullbacks in the smooth category.
The inclusion into schemes over the base is continuous for these topologies.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v

namespace Motivic.SmoothSite

/-- Nisnevich covering families on the actual category of smooth schemes. -/
def nisnevichPrecoverage (S : Scheme.{u}) : Precoverage (SmoothSite S) :=
  Nisnevich.precoverage.comap (forgetScheme S)

/-- The Grothendieck topology generated by actual smooth Nisnevich families. -/
def nisnevichTopology (S : Scheme.{u}) : GrothendieckTopology (SmoothSite S) :=
  (nisnevichPrecoverage S).toGrothendieck

variable {S : Scheme.{u}}

/-- Membership is literally the big Nisnevich condition on the underlying maps. -/
theorem mem_nisnevichPrecoverage_iff {X : SmoothSite S} {R : Presieve X} :
    R ∈ nisnevichPrecoverage S X ↔
      R.map (forgetScheme S) ∈ Nisnevich.precoverage X.left := Iff.rfl

/-- The geometric point-and-residue-field criterion for a smooth covering family. -/
theorem ofArrows_mem_nisnevichPrecoverage_iff {X : SmoothSite S} {ι : Type*}
    {Y : ι → SmoothSite S} (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows Y f ∈ nisnevichPrecoverage S X ↔
      (∀ i, Etale (f i).left) ∧ ∀ x : X.left,
        ∃ (i : ι) (y : (Y i).left), (f i).left y = x ∧
          IsIso ((f i).left.residueFieldMap y) := by
  rw [mem_nisnevichPrecoverage_iff, Presieve.map_ofArrows]
  exact Nisnevich.ofArrows_mem_precoverage_iff (fun i ↦ (f i).left)

/-- Each map in a smooth Nisnevich covering family is étale. -/
theorem etale_of_mem_nisnevichPrecoverage {X Y : SmoothSite S} {R : Presieve X}
    (hR : R ∈ nisnevichPrecoverage S X) {f : Y ⟶ X} (hf : R f) : Etale f.left :=
  (Nisnevich.mem_precoverage_iff.mp hR).1 _ (Presieve.map_map hf)

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).HasIsos := by
  unfold nisnevichPrecoverage
  infer_instance

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).IsStableUnderComposition := by
  unfold nisnevichPrecoverage
  infer_instance

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).HasPullbacks where
  hasPullbacks_of_mem {X Y} {R} f hR := ⟨fun {Y g} hg ↦ by
    have : Etale g.left := etale_of_mem_nisnevichPrecoverage hR hg
    infer_instance⟩

set_option backward.isDefEq.respectTransparency false in
instance (S : Scheme.{u}) : (nisnevichPrecoverage S).IsStableUnderBaseChange where
  mem_coverings_of_isPullback {ι} {W} {V} f hf {Y} g {P} p₁ p₂ h := by
    rw [mem_nisnevichPrecoverage_iff, Presieve.map_ofArrows]
    apply Precoverage.mem_coverings_of_isPullback (fun i ↦ (f i).left)
      ((Nisnevich.ofArrows_mem_precoverage_iff (fun i ↦ (f i).left)).mpr
        ((ofArrows_mem_nisnevichPrecoverage_iff f).mp hf))
      g.left (fun i ↦ (p₁ i).left) (fun i ↦ (p₂ i).left)
    intro i
    have : Etale (f i).left := (ofArrows_mem_nisnevichPrecoverage_iff f).mp hf |>.1 i
    exact ((forgetScheme S).map_isPullback (h i).flip).flip

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).PullbacksPreservedBy (forgetScheme S) where
  preservesPairwisePullbacks_of_mem {X} {R} hR := by
    refine ⟨?_⟩
    intro Y Z f g hf hg
    have := etale_of_mem_nisnevichPrecoverage hR hf
    infer_instance

instance (S : Scheme.{u}) : (nisnevichPrecoverage S).PullbacksPreservedBy (forget S) where
  preservesPairwisePullbacks_of_mem {X} {R} hR := by
    refine ⟨?_⟩
    intro Y Z f g hf hg
    have := etale_of_mem_nisnevichPrecoverage hR hf
    infer_instance

/-- Covering sieves contain an actual smooth Nisnevich family. -/
theorem mem_nisnevichTopology_iff {X : SmoothSite S} {R : Sieve X} :
    R ∈ nisnevichTopology S X ↔ ∃ Q ∈ nisnevichPrecoverage S X, Q ≤ R :=
  Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition

instance (S : Scheme.{u}) : (forgetScheme S).IsContinuous
    (nisnevichTopology S) Nisnevich.topology :=
  Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy _ _ _ le_rfl

instance (S : Scheme.{u}) : (forget S).IsContinuous
    (nisnevichTopology S) (Nisnevich.topology.over S) := by
  rw [Nisnevich.topology, over_toGrothendieck_eq_toGrothendieck_comap_forget]
  apply Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
  rw [nisnevichPrecoverage, forgetScheme, Precoverage.comap_comp]

/-- Restriction of ordinary Nisnevich sheaves to smooth schemes over the base. -/
def restrictNisnevichSheaf (S : Scheme.{u}) (A : Type*) [Category* A] :
    Sheaf (Nisnevich.topology.over S) A ⥤ Sheaf (nisnevichTopology S) A :=
  (forget S).sheafPushforwardContinuous A _ _

end Motivic.SmoothSite
