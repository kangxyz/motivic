module

public import Motivic.RingTheory.TensorProduct.GraphRelations
public import Motivic.RingTheory.TensorProduct.UnramifiedDiagonal
public import Motivic.RingTheory.MvPolynomial.Graph
public import Motivic.RingTheory.RegularSequence.FlatKernel
public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Smooth.Flat
public import Mathlib.RingTheory.TensorProduct.MvPolynomial

/-!
# Actual graph kernels in étale polynomial coordinates

For an arbitrary polynomial-algebra map `B → A`, with `B` étale over the
polynomial ring, the actual localized graph map `(A ⊗[R] B)_q → A_p` has
kernel generated by a regular list of coordinate differences. The coefficient
ring `A` may be nonreduced or disconnected, and the graph map need not be flat.
Flatness is proved only for the base change of the étale coordinate chart.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct
open RingTheory.Sequence

namespace Motivic.PolynomialTensorGraph

variable (R σ A B : Type*) [CommRing R] [CommRing A] [CommRing B]
  [Algebra R A] [Algebra R B]
  [Algebra (MvPolynomial σ R) A] [IsScalarTower R (MvPolynomial σ R) A]
  [Algebra (MvPolynomial σ R) B] [IsScalarTower R (MvPolynomial σ R) B]

/-- The actual base-changed polynomial coordinate map. -/
def coordinateMap : MvPolynomial σ A →ₐ[A] A ⊗[R] B :=
  (Algebra.TensorProduct.map (AlgHom.id A A)
    (IsScalarTower.toAlgHom R (MvPolynomial σ R) B)).comp
      (MvPolynomial.algebraTensorAlgEquiv R A).symm.toAlgHom

omit [Algebra (MvPolynomial σ R) A] [IsScalarTower R (MvPolynomial σ R) A] in
@[simp]
theorem coordinateMap_X (i : σ) :
    coordinateMap R σ A B (MvPolynomial.X i) =
      1 ⊗ₜ[R] algebraMap (MvPolynomial σ R) B (MvPolynomial.X i) := by
  simp [coordinateMap]

omit [IsScalarTower R (MvPolynomial σ R) A] in
@[simp]
theorem coordinateMap_difference (i : σ) :
    coordinateMap R σ A B
      (PolynomialGraph.difference (fun j => algebraMap (MvPolynomial σ R) A (MvPolynomial.X j)) i) =
      difference R σ A B i := by
  simp [PolynomialGraph.difference, difference]

omit [Algebra (MvPolynomial σ R) A] [IsScalarTower R (MvPolynomial σ R) A] in
/-- The actual coordinate map is flat by base change, independently of any graph map. -/
theorem coordinateMap_flat [Module.Flat (MvPolynomial σ R) B] :
    (coordinateMap R σ A B).Flat := by
  apply (RingHom.Flat.of_bijective
    (MvPolynomial.algebraTensorAlgEquiv (σ := σ) R A).symm.bijective).comp
  exact RingHom.Flat.tensorProductMap (RingHom.Flat.id A)
    (RingHom.flat_algebraMap_iff.mpr inferInstance)

omit [IsScalarTower R (MvPolynomial σ R) A] in
/-- Distinct graph coordinate differences are weakly regular for arbitrary `A`. -/
theorem isWeaklyRegular_differences [Module.Flat (MvPolynomial σ R) B]
    (l : List σ) (hl : l.Nodup) :
    IsWeaklyRegular (A ⊗[R] B) (l.map (difference R σ A B)) := by
  have h := RegularSequence.isWeaklyRegular_map_of_flat
    (coordinateMap R σ A B).toRingHom (coordinateMap_flat R σ A B)
    (PolynomialGraph.isWeaklyRegular_differences
      (fun i => algebraMap (MvPolynomial σ R) A (MvPolynomial.X i)) l hl)
  simpa only [List.map_map, Function.comp_def, AlgHom.toRingHom_eq_coe,
    AlgHom.coe_toRingHom, coordinateMap_difference] using h

variable (f : B →ₐ[MvPolynomial σ R] A)

/-- The actual prime of the ambient tensor product at a graph point. -/
def graphPrime (p : Ideal A) : Ideal (A ⊗[R] B) :=
  p.comap (evaluation R σ A B f).toRingHom

instance graphPrime_isPrime (p : Ideal A) [p.IsPrime] : (graphPrime R σ A B f p).IsPrime :=
  Ideal.IsPrime.comap _

/-- The actual local graph evaluation map. -/
def localEvaluation (p : Ideal A) [p.IsPrime] :
    Localization.AtPrime (graphPrime R σ A B f p) →+* Localization.AtPrime p :=
  Localization.localRingHom (graphPrime R σ A B f p) p
    (evaluation R σ A B f).toRingHom rfl

@[simp]
theorem localEvaluation_algebraMap (p : Ideal A) [p.IsPrime] (x : A ⊗[R] B) :
    localEvaluation R σ A B f p (algebraMap _ _ x) =
      algebraMap A (Localization.AtPrime p) (evaluation R σ A B f x) :=
  Localization.localRingHom_to_map _ _ _ _ x

/-- The literal graph coordinate difference in the actual localized ambient ring. -/
def localDifference (p : Ideal A) [p.IsPrime] (i : σ) :
    Localization.AtPrime (graphPrime R σ A B f p) :=
  algebraMap (A ⊗[R] B) _ (difference R σ A B i)

/-- Graph equations lie in the ambient graph prime. -/
theorem difference_mem_graphPrime (p : Ideal A) (i : σ) :
    difference R σ A B i ∈ graphPrime R σ A B f p := by
  change evaluation R σ A B f (difference R σ A B i) ∈ p
  rw [evaluation_difference]
  exact p.zero_mem

/-- The actual localized graph equations lie in the maximal ideal. -/
theorem localDifference_mem_maximalIdeal (p : Ideal A) [p.IsPrime] (i : σ) :
    localDifference R σ A B f p i ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime (graphPrime R σ A B f p)) :=
  (IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _).mpr
    (difference_mem_graphPrime R σ A B f p i)

set_option backward.isDefEq.respectTransparency false in
/-- Distinct actual graph equations form a regular list at every graph point. -/
theorem isRegular_localDifferences [Module.Flat (MvPolynomial σ R) B]
    (p : Ideal A) [p.IsPrime] (l : List σ) (hl : l.Nodup) :
    IsRegular (Localization.AtPrime (graphPrime R σ A B f p))
      (l.map (localDifference R σ A B f p)) := by
  have h := RegularSequence.isWeaklyRegular_map_of_flat
    (algebraMap (A ⊗[R] B) (Localization.AtPrime (graphPrime R σ A B f p)))
    (RingHom.flat_algebraMap_iff.mpr inferInstance)
    (isWeaklyRegular_differences R σ A B l hl)
  have hw : IsWeaklyRegular (Localization.AtPrime (graphPrime R σ A B f p))
      (l.map (localDifference R σ A B f p)) := by
    convert! h using 1
    simp only [List.map_map]
    rfl
  apply IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal _ _ hw
  intro x hx
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
  exact localDifference_mem_maximalIdeal R σ A B f p i

omit [Algebra R A] [Algebra R B]
    [IsScalarTower R (MvPolynomial σ R) A] [IsScalarTower R (MvPolynomial σ R) B] in
/-- An actual section of the relative étale algebra has idempotent-generated kernel. -/
theorem relativeEvaluation_kernel_idempotent [Algebra.Etale (MvPolynomial σ R) B] :
    ∃ e : A ⊗[MvPolynomial σ R] B, IsIdempotentElem e ∧
      RingHom.ker (relativeEvaluation R σ A B f) = Ideal.span {e} := by
  let g := relativeEvaluation R σ A B f
  let := g.toAlgebra
  have : IsScalarTower A (A ⊗[MvPolynomial σ R] B) A :=
    .of_algebraMap_eq' g.comp_algebraMap.symm
  exact (Ideal.isIdempotentElem_iff_of_fg _
    (Algebra.FinitePresentation.ker_fG_of_surjective g
      (relativeEvaluation_surjective R σ A B f))).mp
        ((Algebra.FormallyEtale.iff_of_surjective
          (relativeEvaluation_surjective R σ A B f)).mp
            (.of_restrictScalars (R := A)))

/-- The actual localized graph kernel is precisely the localized coordinate ideal. -/
theorem ker_localEvaluation [Algebra.Etale (MvPolynomial σ R) B]
    (p : Ideal A) [p.IsPrime] :
    RingHom.ker (localEvaluation R σ A B f p) =
      (ideal R σ A B).map
        (algebraMap (A ⊗[R] B) (Localization.AtPrime (graphPrime R σ A B f p))) := by
  obtain ⟨e, he, hker⟩ := relativeEvaluation_kernel_idempotent R σ A B f
  have hcomp : (relativeEvaluation R σ A B f).toRingHom.comp
      (toRelative R σ A B).toRingHom = (evaluation R σ A B f).toRingHom :=
    congrArg AlgHom.toRingHom (relativeEvaluation_comp_toRelative R σ A B f)
  have h := RelativePolynomialTensor.ker_localRingHom_comp_of_idempotent
    (toRelative R σ A B).toRingHom (relativeEvaluation R σ A B f).toRingHom
    (toRelative_surjective R σ A B) (relativeEvaluation_surjective R σ A B f) e he hker p
  rw [hcomp] at h
  have hk : RingHom.ker (toRelative R σ A B).toRingHom = ideal R σ A B :=
    ker_toRelative R σ A B
  rw [hk] at h
  exact h

/-- A complete coordinate list generates the literal localized graph kernel. -/
theorem ker_localEvaluation_eq_ofList [Algebra.Etale (MvPolynomial σ R) B]
    (p : Ideal A) [p.IsPrime] (l : List σ) (hcover : ∀ i, i ∈ l) :
    RingHom.ker (localEvaluation R σ A B f p) =
      Ideal.ofList (l.map (localDifference R σ A B f p)) := by
  rw [ker_localEvaluation, ideal, Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    exact List.mem_map.mpr ⟨i, hcover i, rfl⟩
  · intro hx
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
    exact ⟨difference R σ A B i, ⟨i, rfl⟩, rfl⟩

/-- Étale polynomial coordinates give an actual regular local graph presentation. -/
theorem etale_localGraphPresentation [Algebra.Etale (MvPolynomial σ R) B]
    (p : Ideal A) [p.IsPrime] (l : List σ) (hl : l.Nodup) (hcover : ∀ i, i ∈ l) :
    IsRegular (Localization.AtPrime (graphPrime R σ A B f p))
      (l.map (localDifference R σ A B f p)) ∧
    RingHom.ker (localEvaluation R σ A B f p) =
      Ideal.ofList (l.map (localDifference R σ A B f p)) :=
  ⟨isRegular_localDifferences R σ A B f p l hl,
    ker_localEvaluation_eq_ofList R σ A B f p l hcover⟩

end Motivic.PolynomialTensorGraph
