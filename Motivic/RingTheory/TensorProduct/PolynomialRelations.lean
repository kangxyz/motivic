module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.RingTheory.TensorProduct.Maps
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Polynomial relations and the relative tensor product

For a compatible algebra structure over `P = MvPolynomial σ R`, the tensor
product `S ⊗[P] S` is the quotient of `S ⊗[R] S` by the actual ideal generated
by `1 ⊗ g(X i) - g(X i) ⊗ 1`. The equivalence is constructed from the two
inclusions of `S`, and formulas retain both tensor factors. No flatness,
finiteness, reducedness, or nonzero-ring hypothesis is needed.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

namespace Motivic.RelativePolynomialTensor

variable (R σ S : Type*) [CommRing R] [CommRing S]
  [Algebra R S]

section Core

variable [Algebra (MvPolynomial σ R) S] [IsScalarTower R (MvPolynomial σ R) S]

/-- The right coordinate image minus the matching left coordinate image. -/
def difference (i : σ) : S ⊗[R] S :=
  1 ⊗ₜ[R] algebraMap (MvPolynomial σ R) S (MvPolynomial.X i) -
    algebraMap (MvPolynomial σ R) S (MvPolynomial.X i) ⊗ₜ[R] 1

/-- The literal ideal generated by the polynomial coordinate relations. -/
def ideal : Ideal (S ⊗[R] S) := Ideal.span (Set.range (difference R σ S))

/-- The canonical map changes the tensor base from `R` to the polynomial algebra. -/
def toRelative : S ⊗[R] S →ₐ[R] S ⊗[MvPolynomial σ R] S :=
  Algebra.TensorProduct.lift Algebra.TensorProduct.includeLeft
    (Algebra.TensorProduct.includeRight.restrictScalars R) (fun _ _ => .all _ _)

@[simp]
theorem toRelative_tmul (a b : S) :
    toRelative R σ S (a ⊗ₜ[R] b) = a ⊗ₜ[MvPolynomial σ R] b := by
  simp [toRelative, Algebra.TensorProduct.tmul_mul_tmul]

@[simp]
theorem toRelative_difference (i : σ) :
    toRelative R σ S (difference R σ S i) = 0 := by
  simp only [difference, map_sub, toRelative_tmul]
  exact sub_eq_zero.mpr (Algebra.TensorProduct.tmul_one_eq_one_tmul _).symm

/-- Every coordinate relation vanishes in the relative tensor product. -/
theorem ideal_le_ker_toRelative : ideal R σ S ≤ RingHom.ker (toRelative R σ S) := by
  apply Ideal.span_le.mpr
  rintro x ⟨i, rfl⟩
  exact toRelative_difference R σ S i

/-- The induced forward homomorphism on the coordinate-relation quotient. -/
def quotientToRelative : (S ⊗[R] S ⧸ ideal R σ S) →ₐ[R] S ⊗[MvPolynomial σ R] S :=
  Ideal.Quotient.liftₐ (ideal R σ S) (toRelative R σ S) (ideal_le_ker_toRelative R σ S)

@[simp]
theorem quotientToRelative_mk (x : S ⊗[R] S) :
    quotientToRelative R σ S (Ideal.Quotient.mk (ideal R σ S) x) =
      toRelative R σ S x := rfl

omit [IsScalarTower R (MvPolynomial σ R) S] in
/-- In the quotient the two copies agree on each polynomial generator. -/
theorem mk_right_X_eq_left (i : σ) :
    Ideal.Quotient.mk (ideal R σ S)
      (1 ⊗ₜ[R] algebraMap (MvPolynomial σ R) S (MvPolynomial.X i)) =
    Ideal.Quotient.mk (ideal R σ S)
      (algebraMap (MvPolynomial σ R) S (MvPolynomial.X i) ⊗ₜ[R] 1) := by
  rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span (Set.mem_range_self i)

/-- Polynomial extensionality extends the generator relations to every polynomial. -/
theorem mk_right_eq_left (p : MvPolynomial σ R) :
    Ideal.Quotient.mk (ideal R σ S) (1 ⊗ₜ[R] algebraMap (MvPolynomial σ R) S p) =
    Ideal.Quotient.mk (ideal R σ S) (algebraMap (MvPolynomial σ R) S p ⊗ₜ[R] 1) := by
  let q := Ideal.Quotient.mkₐ R (ideal R σ S)
  let g := IsScalarTower.toAlgHom R (MvPolynomial σ R) S
  have h : (q.comp Algebra.TensorProduct.includeRight).comp g =
      (q.comp Algebra.TensorProduct.includeLeft).comp g := by
    ext i
    exact mk_right_X_eq_left R σ S i
  exact DFunLike.congr_fun h p

/-- The right inclusion becomes a polynomial-algebra map after imposing the relations. -/
def quotientIncludeRight : S →ₐ[MvPolynomial σ R] (S ⊗[R] S ⧸ ideal R σ S) where
  __ := (Ideal.Quotient.mk (ideal R σ S)).comp Algebra.TensorProduct.includeRight.toRingHom
  commutes' p := mk_right_eq_left R σ S p

@[simp]
theorem quotientIncludeRight_apply (s : S) :
    quotientIncludeRight R σ S s = Ideal.Quotient.mk (ideal R σ S) (1 ⊗ₜ[R] s) := rfl

/-- The inverse is induced by the actual left and right quotient inclusions of `S`. -/
def fromRelative : S ⊗[MvPolynomial σ R] S →ₐ[R] (S ⊗[R] S ⧸ ideal R σ S) :=
  (Algebra.TensorProduct.lift
    ((Ideal.Quotient.mkₐ (MvPolynomial σ R) (ideal R σ S)).comp
      Algebra.TensorProduct.includeLeft)
    (quotientIncludeRight R σ S) (fun _ _ => .all _ _)).restrictScalars R

@[simp]
theorem fromRelative_tmul (a b : S) :
    fromRelative R σ S (a ⊗ₜ[MvPolynomial σ R] b) =
      Ideal.Quotient.mk (ideal R σ S) (a ⊗ₜ[R] b) := by
  simp [fromRelative, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul]

/-- The quotient by the coordinate relations is the actual relative tensor algebra. -/
def quotientEquiv : (S ⊗[R] S ⧸ ideal R σ S) ≃ₐ[R] S ⊗[MvPolynomial σ R] S :=
  AlgEquiv.ofAlgHom (quotientToRelative R σ S) (fromRelative R σ S)
    (by
      apply AlgHom.ext
      intro x
      induction x using TensorProduct.inductionOn with
      | tmul a b => simp
      | add x y hx hy => simpa using congrArg₂ (· + ·) hx hy)
    (by
      apply Ideal.Quotient.algHom_ext
      apply AlgHom.ext
      intro x
      induction x using TensorProduct.inductionOn with
      | tmul a b => simp
      | add x y hx hy => simpa using congrArg₂ (· + ·) hx hy)

@[simp]
theorem quotientEquiv_mk (x : S ⊗[R] S) :
    quotientEquiv R σ S (Ideal.Quotient.mk (ideal R σ S) x) =
      toRelative R σ S x := rfl

theorem quotientEquiv_mk_tmul (a b : S) :
    quotientEquiv R σ S (Ideal.Quotient.mk (ideal R σ S) (a ⊗ₜ[R] b)) =
      a ⊗ₜ[MvPolynomial σ R] b := by simp

@[simp]
theorem quotientEquiv_symm_tmul (a b : S) :
    (quotientEquiv R σ S).symm (a ⊗ₜ[MvPolynomial σ R] b) =
      Ideal.Quotient.mk (ideal R σ S) (a ⊗ₜ[R] b) := fromRelative_tmul R σ S a b

/-- The kernel of the actual base-change map is exactly the generated relation ideal. -/
theorem ker_toRelative : RingHom.ker (toRelative R σ S) = ideal R σ S := by
  apply le_antisymm
  · intro x hx
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    apply (quotientEquiv R σ S).injective
    simpa using hx
  · exact ideal_le_ker_toRelative R σ S

/-- Multiplication commutes with the map to the relative tensor product. -/
theorem lmul_comp_toRelative :
    ((Algebra.TensorProduct.lmul' (MvPolynomial σ R) :
      S ⊗[MvPolynomial σ R] S →ₐ[MvPolynomial σ R] S).restrictScalars R).comp
      (toRelative R σ S) = Algebra.TensorProduct.lmul' R := by
  apply AlgHom.ext
  intro x
  induction x using TensorProduct.inductionOn with
  | tmul a b => simp
  | add x y hx hy => simpa using congrArg₂ (· + ·) hx hy

end Core

section ExplicitHom

variable {R σ S}

/-- The quotient comparison with the polynomial algebra structure specified by an explicit map. -/
def quotientEquivOfHom (g : MvPolynomial σ R →ₐ[R] S) :
    letI := g.toAlgebra
    (S ⊗[R] S ⧸ Ideal.span (Set.range (fun i : σ =>
      1 ⊗ₜ[R] g (MvPolynomial.X i) - g (MvPolynomial.X i) ⊗ₜ[R] 1))) ≃ₐ[R]
      S ⊗[MvPolynomial σ R] S := by
  letI := g.toAlgebra
  exact quotientEquiv R σ S

@[simp]
theorem quotientEquivOfHom_mk_tmul (g : MvPolynomial σ R →ₐ[R] S) (a b : S) :
    letI := g.toAlgebra
    quotientEquivOfHom g (Ideal.Quotient.mk _ (a ⊗ₜ[R] b)) =
      a ⊗ₜ[MvPolynomial σ R] b := by
  let := g.toAlgebra
  exact quotientEquiv_mk_tmul R σ S a b

@[simp]
theorem quotientEquivOfHom_symm_tmul (g : MvPolynomial σ R →ₐ[R] S) (a b : S) :
    letI := g.toAlgebra
    (quotientEquivOfHom g).symm (a ⊗ₜ[MvPolynomial σ R] b) =
      Ideal.Quotient.mk _ (a ⊗ₜ[R] b) := by
  let := g.toAlgebra
  exact quotientEquiv_symm_tmul R σ S a b

end ExplicitHom

end Motivic.RelativePolynomialTensor
