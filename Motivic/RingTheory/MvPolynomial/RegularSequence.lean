module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Polynomial variables form weakly regular sequences

Over an arbitrary commutative coefficient ring, any finite list of distinct
polynomial variables is weakly regular. The proof uses the coefficientwise
membership criterion for variable-generated ideals. No reducedness, domain,
Noetherianity, or regularity assumption is imposed on the coefficient ring.
-/

@[expose] public section

namespace Motivic.MvPolynomial

open _root_.MvPolynomial RingTheory.Sequence

variable {R σ : Type*} [CommRing R]

/-- A new variable is regular modulo the ideal generated by any other variables. -/
theorem isSMulRegular_quotient_span_X (s : Set σ) (i : σ) (hi : i ∉ s) :
    IsSMulRegular (MvPolynomial σ R ⧸ Ideal.span ((X : σ → MvPolynomial σ R) '' s))
      (X i : MvPolynomial σ R) := by
  classical
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  rw [smul_eq_mul, mem_ideal_span_X_image] at hp
  rw [mem_ideal_span_X_image]
  intro m hm
  have hm' : Finsupp.single i 1 + m ∈ (X i * p).support := by
    simpa only [mem_support_iff, coeff_X_mul] using hm
  obtain ⟨j, hj, h⟩ := hp _ hm'
  refine ⟨j, hj, ?_⟩
  have hij : i ≠ j := fun h => hi (h ▸ hj)
  simpa only [Finsupp.add_apply, Finsupp.single_eq_of_ne hij.symm, zero_add] using h

/-- Every list of distinct variables is weakly regular, over any coefficient ring. -/
theorem isWeaklyRegular_X (l : List σ) (hl : l.Nodup) :
    IsWeaklyRegular (MvPolynomial σ R) (l.map (X : σ → MvPolynomial σ R)) := by
  constructor
  intro i hi
  have hi' : i < l.length := by simpa only [List.length_map] using hi
  have hnew : l[i] ∉ {j | j ∈ l.take i} := by
    intro h
    obtain ⟨j, hj, he⟩ := List.mem_take_iff_getElem.mp h
    have hji : j = i := hl.getElem_inj.mp he
    omega
  have heq : Ideal.ofList ((l.map (X : σ → MvPolynomial σ R)).take i) =
      Ideal.span (X '' {j | j ∈ l.take i}) := by
    rw [← List.map_take]
    unfold Ideal.ofList
    congr 1
    ext p
    exact List.mem_map
  rw [heq, Ideal.smul_eq_mul, Ideal.mul_top, List.getElem_map]
  exact isSMulRegular_quotient_span_X _ _ hnew

end Motivic.MvPolynomial
