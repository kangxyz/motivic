module

public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Regular kernels under composition of surjective ring maps

A regular kernel of the first surjection and a regular kernel in its actual
quotient give a regular kernel of the composite. The second list is lifted
through the first surjection. Its regularity is used over the quotient, not
merely over the original ring. No independence assertion about two arbitrary
regular lists is used.
-/

@[expose] public section

open RingTheory.Sequence

namespace Motivic.RegularSequence

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]

/-- Lifts of a regular kernel list in an actual quotient append to the first
regular list. The composite kernel is generated by this literal append. -/
theorem isRegular_append_of_surjective_kernel [Nontrivial T]
    (f : R →+* S) (g : S →+* T) (hf : Function.Surjective f)
    (t u : List R) (ht : IsRegular R t)
    (hft : RingHom.ker f = Ideal.ofList t)
    (hu : IsRegular S (u.map f))
    (hgu : RingHom.ker g = Ideal.ofList (u.map f)) :
    IsRegular R (t ++ u) ∧ RingHom.ker (g.comp f) = Ideal.ofList (t ++ u) := by
  let := f.toAlgebra
  let μ : R →ₐ[R] S := Algebra.ofId R S
  have hμ : Function.Surjective μ := hf
  have hker : Ideal.ofList t = RingHom.ker μ := hft.symm
  let e : (R ⧸ Ideal.ofList t) ≃ₐ[R] S :=
    (Ideal.quotientEquivAlgOfEq R hker).trans
      (Ideal.quotientKerAlgEquivOfSurjective hμ)
  have hu' : IsWeaklyRegular S u :=
    (isWeaklyRegular_map_algebraMap_iff S S u).mp hu.toIsWeaklyRegular
  have hquot : IsWeaklyRegular (R ⧸ (Ideal.ofList t • ⊤ : Submodule R R)) u := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
    exact (e.toLinearEquiv.isWeaklyRegular_congr u).mpr hu'
  have hk : RingHom.ker (g.comp f) = Ideal.ofList (t ++ u) := by
    rw [← RingHom.comap_ker, hgu, ← Ideal.map_ofList,
      Ideal.comap_map_of_surjective' f hf, hft, Ideal.ofList_append, sup_comm]
  refine ⟨⟨(isWeaklyRegular_append_iff R t u).mpr ⟨ht.toIsWeaklyRegular, hquot⟩, ?_⟩, hk⟩
  rw [Ideal.smul_eq_mul, Ideal.mul_top, ← hk]
  exact (RingHom.ker_ne_top (g.comp f)).symm

/-- Composition of actual surjective regular-kernel maps has a regular kernel;
the proof constructs lifts of the second kernel's equations. -/
theorem exists_regular_kernel_comp_of_surjective [Nontrivial T]
    (f : R →+* S) (g : S →+* T) (hf : Function.Surjective f)
    (hfirst : ∃ t : List R, IsRegular R t ∧ RingHom.ker f = Ideal.ofList t)
    (hsecond : ∃ s : List S, IsRegular S s ∧ RingHom.ker g = Ideal.ofList s) :
    ∃ r : List R, IsRegular R r ∧ RingHom.ker (g.comp f) = Ideal.ofList r := by
  classical
  obtain ⟨t, ht, hft⟩ := hfirst
  obtain ⟨s, hs, hgs⟩ := hsecond
  let lift : S → R := fun y => Classical.choose (hf y)
  have hlift (y : S) : f (lift y) = y := Classical.choose_spec (hf y)
  have hmap : (s.map lift).map f = s := by
    simp [List.map_map, Function.comp_def, hlift]
  refine ⟨t ++ s.map lift, ?_⟩
  apply isRegular_append_of_surjective_kernel f g hf t (s.map lift) ht hft
  · simpa only [hmap] using hs
  · simpa only [hmap] using hgs

end Motivic.RegularSequence
