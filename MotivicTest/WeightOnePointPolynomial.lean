module

public import Motivic.Cohomology.Motivic.WeightOnePointPolynomial
public import Lean.Util.CollectAxioms

/-!
# Consumers of exact point-polynomial presentations

These statements retain the actual finite-correspondence generator, the
literal scalar action, and the full support immersion. They impose no
separability, perfection, or algebraic-closure hypothesis on the field.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Polynomial
open Motivic Motivic.WeightOnePointNorm Motivic.WeightOneInterpolationCycle
open Motivic.WeightOnePointPolynomial

universe u

namespace MotivicTest.WeightOnePointPolynomial

variable {k : Type u} [Field k] (Z : Generator k)

/-- The whole coordinate algebra is generated by its original Laurent unit. -/
theorem actual_coordinate_generates :
    Algebra.adjoin k ({(coordinateUnit Z : coordinateRing Z)} : Set (coordinateRing Z)) = ⊤ :=
  coordinate_adjoin_eq_top Z

/-- The spectrum chart is an exact isomorphism of the original closed immersion. -/
theorem actual_closed_support :
    (polynomialSupportIso Z).hom ≫ Z.inclusion =
      polynomialInclusion (coordinatePolynomial Z) (coordinatePolynomial_coeff_zero_ne_zero Z) :=
  polynomialSupportIso_inclusion Z

/-- The polynomial presentation is over the unchanged literal base-field map. -/
theorem actual_scalar_map :
    (polynomialSupportIso Z).hom ≫ Z.projection =
      Spec.map (CommRingCat.ofHom (AdjoinRoot.of (coordinatePolynomial Z))) :=
  polynomialSupportIso_projection Z

/-- Every original generator is the actual whole polynomial correspondence. -/
theorem actual_generator_polynomial :
    ∃ (p : k[X]) (hp : p.Monic) (h0 : p.coeff 0 ≠ 0),
      1 ≤ p.natDegree ∧ Z.cycle = polynomialCycle p hp h0 :=
  exists_polynomialCycle Z

end MotivicTest.WeightOnePointPolynomial

open Lean in
run_cmd do
  for name in #[
      `Motivic.WeightOnePointPolynomial.torusProjection_closed,
      `Motivic.WeightOnePointPolynomial.coordinatePullback_eq_eval,
      `Motivic.WeightOnePointPolynomial.coordinate_eval_surjective,
      `Motivic.WeightOnePointPolynomial.coordinate_adjoin_eq_top,
      `Motivic.WeightOnePointPolynomial.coordinatePolynomial_monic,
      `Motivic.WeightOnePointPolynomial.coordinatePolynomial_natDegree_pos,
      `Motivic.WeightOnePointPolynomial.coordinatePolynomial_coeff_zero_ne_zero,
      `Motivic.WeightOnePointPolynomial.coordinateRootEquiv,
      `Motivic.WeightOnePointPolynomial.polynomialSupportIso,
      `Motivic.WeightOnePointPolynomial.polynomialSupportIso_projection,
      `Motivic.WeightOnePointPolynomial.polynomialSupportIso_inclusion,
      `Motivic.WeightOnePointPolynomial.generator_cycle_eq_polynomialCycle,
      `Motivic.WeightOnePointPolynomial.exists_polynomialCycle,
      `MotivicTest.WeightOnePointPolynomial.actual_coordinate_generates,
      `MotivicTest.WeightOnePointPolynomial.actual_closed_support,
      `MotivicTest.WeightOnePointPolynomial.actual_scalar_map,
      `MotivicTest.WeightOnePointPolynomial.actual_generator_polynomial] do
    let dependencies ← collectAxioms name
    for dependency in dependencies do
      unless #[`propext, `Classical.choice, `Quot.sound].contains dependency do
        throwError "{name} depends on unsupported assumption {dependency}"
  logInfo "Exact torus point polynomial presentations use only standard Lean foundations."
