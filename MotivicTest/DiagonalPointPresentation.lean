module

public import Motivic.Cohomology.Motivic.DiagonalPointPresentation
public import Lean.Util.CollectAxioms

/-!
Original integral support, signed cycle, raw diagonal homology, and derived
consumers of the all-weight whole-field presentation. No norm comparison or
retraction is used, and characteristic zero is not assumed.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Motivic
open DiagonalCycleSymbols DiagonalPointNorm DiagonalPointPresentation DiagonalCorestriction

universe w u

namespace MotivicTest.DiagonalPointPresentation

variable {k : Type u} [Field k] {q : ℕ} (Z : Generator k q)

/-- The actual support chart preserves exactly the original scalar homomorphism. -/
theorem actual_scalar_map :
    (supportIsoSpec Z).inv ≫ Z.projection =
      Spec.map (CommRingCat.ofHom (algebraMap k (coordinateRing Z))) :=
  supportIsoSpec_inv_projection Z

/-- Every original coordinate, including nonprimitive coordinates, is preserved. -/
theorem actual_coordinate (i : Fin q) :
    (supportIsoSpec Z).inv ≫ coordinateProjection Z i =
      WeightTwoCubicBoundary.unitMap (algebraMap k (coordinateRing Z))
        (coordinateUnit Z i) := supportIsoSpec_inv_coordinate Z i

/-- This is equality of the whole original inclusion before passing to cycles. -/
theorem actual_closed_support :
    (supportIsoSpec Z).inv ≫ Z.inclusion =
      finitePointMap (k := k) q
        (rationalTuple (coordinateRing Z) q (coordinateUnit Z)) :=
  supportIsoSpec_inv_inclusion Z

/-- An actual generator is transferred with multiplicity one from its entire field. -/
theorem actual_generator :
    Z.cycle = pointPushforward (k := k) q
      ((Cor.graphFunctor (coordinateRing Z)).map
        (rationalTuple (coordinateRing Z) q (coordinateUnit Z))) :=
  generator_cycle_eq_pointPushforward Z

/-- Negative as well as positive original coefficients are preserved literally. -/
theorem actual_signed_generator (n : ℤ) :
    n • Z.cycle = pointPushforward (k := k) q
      (n • (Cor.graphFunctor (coordinateRing Z)).map
        (rationalTuple (coordinateRing Z) q (coordinateUnit Z))) := by
  erw [map_zsmul, generator_cycle_eq_pointPushforward]

/-- The raw class uses the actual original geometric corestriction. -/
theorem actual_raw_generator :
    cycleClass k q Z.cycle = corestriction (k := k) q
      (graphSymbol (coordinateRing Z) q (coordinateUnit Z)) :=
  cycleClass_generator Z

/-- Weight zero is covered by the same original-support theorem, with no coordinates. -/
theorem actual_weight_zero (Z₀ : Generator k 0) :
    Z₀.cycle = pointPushforward (k := k) 0
      ((Cor.graphFunctor (coordinateRing Z₀)).map
        (rationalTuple (coordinateRing Z₀) 0 (coordinateUnit Z₀))) :=
  generator_cycle_eq_pointPushforward Z₀

/-- Arbitrary signed raw cycle classes retain every original finite support. -/
theorem actual_signed_class (α : WeightOnePointNorm.point k ⟶ target k q) :
    cycleClass k q α = α.sum (fun Z n => n • corestriction (k := k) q
      (graphSymbol (coordinateRing Z) q (coordinateUnit Z))) :=
  cycleClass_eq_sum_corestriction k q α

/-- Actual raw homology is generated by genuine finite transfers of rational graphs. -/
theorem actual_raw_class (x : (motivicRawBaseComplex k q).homology q) :
    ∃ α : WeightOnePointNorm.point k ⟶ target k q,
      x = α.sum (fun Z n => n • corestriction (k := k) q
        (graphSymbol (coordinateRing Z) q (coordinateUnit Z))) :=
  exists_sum_corestriction k q x

variable [HasDerivedCategory.{w}
  (Sheaf (SmoothSite.nisnevichTopology (Spec (.of k))) AddCommGrpCat.{u + 1})]

/-- The same literal equality is transported to the original derived motivic group. -/
theorem actual_derived_generator :
    (motivicRawBaseEvaluationComparison k q q).symm (cycleClass k q Z.cycle) =
      (motivicRawBaseEvaluationComparison k q q).symm
        (corestriction (k := k) q
          (graphSymbol (coordinateRing Z) q (coordinateUnit Z))) :=
  congrArg _ (cycleClass_generator Z)

/-- Every derived diagonal class retains the original signed whole-field presentation. -/
theorem actual_derived_class
    (x : motivicCohomology k q q (SmoothSite.base (Spec (.of k)))) :
    ∃ α : WeightOnePointNorm.point k ⟶ target k q,
      motivicRawBaseEvaluationComparison k q q x =
        α.sum (fun Z n => n • corestriction (k := k) q
          (graphSymbol (coordinateRing Z) q (coordinateUnit Z))) :=
  exists_sum_corestriction k q (motivicRawBaseEvaluationComparison k q q x)

open Lean in
run_cmd do
  for name in #[``coordinateProjection, ``coordinateProjection_structure,
      ``coordinatePullback_eq_eval, ``supportIsoSpec_inv_map,
      ``supportIsoSpec_inv_coordinate, ``supportIsoSpec_inv_targetProjection,
      ``supportIsoSpec_inv_inclusion, ``generator_cycle_eq_pointPushforward,
      ``cycleClass_generator, ``cycle_eq_sum_pointPushforward,
      ``cycleClass_eq_sum_corestriction, ``exists_sum_corestriction,
      ``actual_scalar_map, ``actual_coordinate, ``actual_closed_support,
      ``actual_generator, ``actual_signed_generator, ``actual_raw_generator,
      ``actual_weight_zero, ``actual_signed_class, ``actual_raw_class,
      ``actual_derived_generator, ``actual_derived_class] do
    for dependency in ← collectAxioms name do
      unless #[``propext, ``Classical.choice, ``Quot.sound].contains dependency do
        throwError "{name} depends on unsupported assumption {dependency}"
  logInfo "Actual whole-field diagonal point presentations use only standard foundations."

end MotivicTest.DiagonalPointPresentation
